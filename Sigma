def _compute_cost_cols(res: dict) -> dict:
    """
    Compute cost columns from the optimised result while the model and
    clean_reporting DataFrame are still directly available.
    Returns a dict of cost columns ready to merge into the result row.
    """
    rep_df = res.get("clean_reporting")
    model  = res.get("model")

    empty = {
        "Measured Rate":          None,
        "Modeled Cost ($)":       None,
        "Actual Cost ($)":        None,
        "Avoided Cost ($)":       None,
        "Avg Monthly Avoided Cost": None,
        "Total Modeled Usage":    None,
        "Total Actual Usage":     None,
        "Savings Exclusion Flag": "",
    }
    zeroed = {
        "Measured Rate":          None,
        "Modeled Cost ($)":       None,
        "Actual Cost ($)":        None,
        "Avoided Cost ($)":       0.0,
        "Avg Monthly Avoided Cost": 0.0,
        "Total Modeled Usage":    None,
        "Total Actual Usage":     None,
    }

    if model is None or rep_df is None or len(rep_df) == 0:
        # No clean reporting bills — all were excluded as outliers or none exist
        if rep_df is not None and hasattr(rep_df, "__len__") and len(rep_df) == 0:
            flag = "EXCLUDED — All reporting bills removed as outliers"
        else:
            flag = ""
        return {**empty,
                "Savings Status": "Excluded — All Reporting Bills Removed" if flag else "Included",
                "Savings Exclusion Flag": flag}

    # Total Charges column may be underscore-normalised internally
    charge_col = "Total_Charges" if "Total_Charges" in rep_df.columns else "Total Charges"
    if charge_col not in rep_df.columns:
        return empty

    total_charges = float(rep_df[charge_col].sum())
    total_cons    = float(rep_df["Consumption"].sum())
    if total_cons == 0:
        return empty

    rate = total_charges / total_cons
    is_gas = _is_gas(res.get("service_type_internal", ""))
    X = rep_df[["HDD"]].values if is_gas else rep_df[["HDD", "CDD"]].values
    pred_sum = float(model.predict(X).sum())
    n_bills  = len(rep_df)

    avoided_cost = round(pred_sum * rate - total_charges, 2)

    # Check if ALL clean reporting bills show negative savings
    # Uses the actual per-bill avoided consumption (pred - actual per bill)
    is_gas_flag = _is_gas(res.get("service_type_internal", ""))
    X_check = rep_df[["HDD"]].values if is_gas_flag else rep_df[["HDD", "CDD"]].values
    per_bill_pred = model.predict(X_check)
    per_bill_pct  = (per_bill_pred - rep_df["Consumption"].values) / per_bill_pred
    all_negative  = bool((per_bill_pct < 0).all())

    if all_negative:
        return {
            **zeroed,
            "Savings Status":         "Excluded — All Reporting Periods Negative",
            "Savings Exclusion Flag": (
                f"EXCLUDED — All {n_bills} clean reporting bill(s) show negative savings "
                f"(avg {per_bill_pct.mean()*100:.1f}% avoided)"
            ),
        }

    return {
        "Measured Rate":            round(rate, 4),
        "Modeled Cost ($)":         round(pred_sum * rate, 2),
        "Actual Cost ($)":          round(total_charges, 2),
        "Avoided Cost ($)":         avoided_cost,
        "Avg Monthly Avoided Cost": round(avoided_cost / n_bills, 2) if n_bills else None,
        "Total Modeled Usage":      round(pred_sum, 2),
        "Total Actual Usage":       round(total_cons, 2),
        "Savings Status":           "Included",
        "Savings Exclusion Flag":   "",
    }


def _build_result_row(res, site, meter_num, model_type, service_type,
                      bl_count, concurrent, sequential):
    # Store service_type on res so _compute_cost_cols can check is_gas
    res["service_type_internal"] = service_type

    r2_rating = (
        "Excellent" if res["r2"] >= 0.9 else
        "Good"      if res["r2"] >= 0.75 else
        "Fair"      if res["r2"] >= 0.6  else "Poor"
    )
    cv_rating = (
        "Excellent"          if res["cvrmse"] < 10  else
        "Good (ASHRAE Pass)" if res["cvrmse"] <= 15 else
        "Fair (Fail)"        if res["cvrmse"] <= 25 else "Poor"
    )
    wc_rating = (
        "Excellent" if res["wc_overall"] >= 90 else
        "Good"      if res["wc_overall"] >= 75 else
        "Fair"      if res["wc_overall"] >= 60 else "Poor"
    )

    notes = ""
    if sequential:
        n = str(meter_num).count(",") + 2 if "," in str(meter_num) else 2
        notes = f"Sequential meter replacement: meters combined into single timeline"

    return {
        "Site Name":               site,
        "Meter Number":            str(meter_num),
        "Model Type":              model_type,
        "Service Type":            service_type,
        "Seasonal Strategy":       res["seasonal_strategy"],
        "Optimization Mode":       "Locked" if res["seasonal_strategy"] == "Locked (pre-selected)" else "Optimized",
        "New Site":                res.get("is_new_site", False),
        "CV Ceiling Relaxed":      res.get("cv_ceiling_relaxed", False),
        "Baseline Count":          len(res["selected"]),
        "Reporting Count":         res["reporting_count"],
        "Model Equation":          res["equation"],
        "Intercept":               round(res["intercept"], 4),
        "HDD Coefficient":         round(res["hdd_coef"], 4),
        "CDD Coefficient":         round(res["cdd_coef"], 4),
        "R2":                      round(res["r2"], 4),
        "R2 Rating":               r2_rating,
        "Passes R2":               res["passes_r2"],
        "CV-RMSE":                 round(res["cvrmse"], 2),
        "CV-RMSE Rating":          cv_rating,
        "Passes CV-RMSE":          res["passes_cvrmse"],
        "Weather Coverage (%)":    round(res["wc_overall"], 1),
        "HDD Coverage (%)":        round(res["wc_hdd"], 1),
        "CDD Coverage (%)":        round(res["wc_cdd"], 1),
        "Weather Coverage Rating": wc_rating,
        "Passes Weather Coverage": res["passes_wc"],
        "Model Passes Quality":    res["passes_all"],
        "Q1 Bills":                res["Q1_Bills"],
        "Q2 Bills":                res["Q2_Bills"],
        "Q3 Bills":                res["Q3_Bills"],
        "Q4 Bills":                res["Q4_Bills"],
        "Temporal CV":             round(res["temporal_cv"], 1),
        "Total Avoided Usage":     round(res["total_avoided"], 2),
