def _build_baseline_rows(res, site, meter_num, service_type):
    rows = []
    used_dates = set(res["selected"]["Period_Start_Date"])
    # All clean baseline bills (used + not selected)
    for _, r in res["selected"].iterrows():
        row = _bill_row(r, site, meter_num, service_type, "Baseline", "Used in Model")
        row["Selected Baseline"] = "1"   # marks this bill for lock-based re-runs
        rows.append(row)
    if "reporting_all" in res:
        # Not-selected bills: those in the full clean baseline but not selected
        # We don't store the full pool in res by default — mark selected only
        pass
    # Outliers
    if len(res.get("bl_outliers_df", pd.DataFrame())) > 0:
        for _, r in res["bl_outliers_df"].iterrows():
            rows.append(_bill_row(r, site, meter_num, service_type, "Baseline",
                                  f"Excluded: {r.get('Outlier_Reason','Outlier')}"))
    return rows


def _build_reporting_rows(res, site, meter_num, service_type):
    rows = []
    model  = res["model"]
    is_gas = _is_gas(service_type)
    if len(res["clean_reporting"]) > 0:
        X = res["clean_reporting"][["HDD"]].values if is_gas else res["clean_reporting"][["HDD", "CDD"]].values
        pred = model.predict(X)
        for i, (_, r) in enumerate(res["clean_reporting"].iterrows()):
            row = _bill_row(r, site, meter_num, service_type, "Reporting", "Used in Savings")
            row["Predicted Consumption"] = round(float(pred[i]), 2)
            row["Avoided Usage"]         = round(float(pred[i]) - float(r["Consumption"]), 2)
            row["Pct Avoided"]           = round((float(pred[i]) - float(r["Consumption"])) / float(pred[i]) * 100, 2) if pred[i] != 0 else 0.0
            rows.append(row)
            _cons = float(r["Consumption"])
            _charges = float(r.get("Total_Charges", r.get("Total Charges", 0)))
            _rate = (_charges / _cons) if _cons > 0 else 0.0
            row["Bill Avoided Cost"] = round((float(pred[i]) - _cons) * _rate, 2)
    if len(res["rep_outliers"]) > 0:
        X_o  = res["rep_outliers"][["HDD"]].values if is_gas else res["rep_outliers"][["HDD","CDD"]].values
        pred_o = model.predict(X_o)
        for i, (_, r) in enumerate(res["rep_outliers"].iterrows()):
            row = _bill_row(r, site, meter_num, service_type, "Reporting",
                            f"Excluded: {r.get('Outlier_Reason','Outlier')}")
            row["Predicted Consumption"] = round(float(pred_o[i]), 2)
            row["Avoided Usage"]         = round(float(pred_o[i]) - float(r["Consumption"]), 2)
            row["Pct Avoided"]           = round((float(pred_o[i]) - float(r["Consumption"])) / float(pred_o[i]) * 100, 2) if pred_o[i] != 0 else 0.0
            rows.append(row)
            _cons_o = float(r["Consumption"])
            _charges_o = float(r.get("Total_Charges", r.get("Total Charges", 0)))
            _rate_o = (_charges_o / _cons_o) if _cons_o > 0 else 0.0
            row["Bill Avoided Cost"] = round((float(pred_o[i]) - _cons_o) * _rate_o, 2)
    return rows


def _bill_row(r, site, meter_num, service_type, period_type, status):
    return {
        "Site Name":              site,
        "Meter Number":           str(meter_num),
        "Service Type":           service_type,
        "Period Type":            period_type,
        "Status":                 status,
        "Period Start Date":      r.get("Period_Start_Date"),
        "Period End Date":        r.get("Period_End_Date"),
        "HDD":                    r.get("HDD"),
        "CDD":                    r.get("CDD"),
        "Consumption":            r.get("Consumption"),
        "Total Charges":          r.get("Total_Charges"),
        "Predicted Consumption":  None,
        "Avoided Usage":          None,
        "Pct Avoided":            None,
        "Bill Avoided Cost":      None,
        "Selected Baseline":      None,   # "1" for bills used in model, blank otherwise
    }


def _add_cost_columns(df: pd.DataFrame) -> pd.DataFrame:
    """Cost columns are now computed in _build_result_row. This is a no-op passthrough."""
    return df.drop(columns=[c for c in ['_model', '_clean_reporting', '_selected_baseline']
                             if c in df.columns])


def _build_notes(ind_results, agg_res, meter_count):
    ind_pass  = sum(1 for _, r, _ in ind_results if r["passes_all"])
    total_ind = len(ind_results)
    agg_pass  = agg_res["passes_all"]
    avg_r2    = np.mean([r["r2"] for _, r, _ in ind_results]) if ind_results else 0
    avg_sav   = np.mean([r["pct_avoided"] for _, r, _ in ind_results if r["passes_all"]]) if ind_pass > 0 else 0

    if ind_pass == total_ind and agg_pass:
        qual = f"All {total_ind} individual meters and aggregated pass quality"
    elif ind_pass > 0 and agg_pass:
        qual = f"{ind_pass}/{total_ind} individual meters and aggregated pass quality"
    elif agg_pass and ind_pass == 0:
        qual = f"Only aggregated passes quality (all {total_ind} individual meters fail)"
    elif ind_pass == total_ind and not agg_pass:
        qual = f"All {total_ind} individual meters pass; aggregated fails"
    else:
        qual = f"{ind_pass}/{total_ind} individual meters pass; aggregated {'passes' if agg_pass else 'fails'}"

    parts = [
        qual,
        f"Avg individual R²={avg_r2:.2f}, Aggregated R²={agg_res['r2']:.2f}",
    ]
    if agg_pass and ind_pass > 0:
        parts.append(f"Avg individual savings={avg_sav:.1f}%, Aggregated={agg_res['pct_avoided']:.1f}%")
    return " | ".join(parts)


