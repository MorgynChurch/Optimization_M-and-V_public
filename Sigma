# ─── Sigma wires the upstream table into this variable name ──────────────────
# Change this to match the actual variable name Sigma assigns to your input table.
INPUT_TABLE_VAR = "mv_input"          # <- edit if Sigma names it differently

import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_squared_error
from itertools import combinations
import warnings
warnings.filterwarnings("ignore")

# ─── Quality thresholds ───────────────────────────────────────────────────────
ELEC_R2_THRESHOLD        = 0.70
GAS_R2_THRESHOLD         = 0.40
CVRMSE_THRESHOLD         = 15.0   # percent  (ASHRAE Guideline 14)
WEATHER_COVERAGE_THRESHOLD = 75.0 # percent  (hard requirement)
ELEC_BASELINE_COUNT      = 12
GAS_BASELINE_COUNT       = 8
PREFERRED_MIN_PER_QUARTER = 2
MINIMUM_MIN_PER_QUARTER   = 1
OVERLAP_THRESHOLD         = 3     # shared periods to classify meters as concurrent

# Temporal balance — hard CV ceiling applied during pre-filtering.
# Combinations exceeding this are excluded for normal (full-year) sites.
# New sites (<12 months baseline) bypass this ceiling entirely.
TEMPORAL_CV_CEILING       = 40.0  # % — IPMVP Option C seasonal balance (strict, allows mild imbalance like 4/3/3/2)

# ── Meter weighting (concurrent multi-meter sites only) ───────────────────────
# Weight = each meter's share of total BASELINE consumption at the site.
# Meters with no baseline bills receive 0% weight and a note in Weight Source.
#
# FAILING-METER flags (applied to aggregate row and Meter Weights table):
#   Failing weight <= WEIGHT_REVIEW_THRESHOLD  → "OK"
#   Failing weight >  WEIGHT_REVIEW_THRESHOLD
#                  <= WEIGHT_HIGH_RISK_THRESHOLD → "REVIEW"   (informational)
#   Failing weight >  WEIGHT_HIGH_RISK_THRESHOLD → "HIGH RISK" (informational)
# No hard exclusions — Model Passes Quality is never forced False by weight logic.
#
# LOW-COVERAGE flag (applied to individual model rows only):
#   Passing meter with weight < LOW_COVERAGE_THRESHOLD → "LOW COVERAGE"
#   Signals that the meter's contribution to any aggregate is small.
#
# Meter Weight (%) is ALWAYS populated for concurrent multi-meter sites
# so analysts can read the distribution without needing a flag to fire.
WEIGHT_REVIEW_THRESHOLD    = 0.33   # >33% failing weight → REVIEW
WEIGHT_HIGH_RISK_THRESHOLD = 0.50   # >50% failing weight → HIGH RISK
LOW_COVERAGE_THRESHOLD     = 0.25   # <25% weight on a passing individual meter → LOW COVERAGE
MAX_COMBINATIONS          = 500  # max candidates tested per site

# Unit conversions to standard units (kWh for electricity, Therms for gas)
UNIT_CONVERSIONS = {
    "kwh": 1.0, "mwh": 1000.0, "wh": 0.001,
    "therms": 1.0, "therm": 1.0,
    "ccf": 1.037, "mcf": 10.37,
    "mmbtu": 10.0, "mmbtu": 10.0,
}

# ─── Helpers ──────────────────────────────────────────────────────────────────

def _is_gas(service_type: str) -> bool:
    return "gas" in str(service_type).lower()


def _convert_units(df: pd.DataFrame) -> pd.DataFrame:
    """Convert Consumption to standard units where Consumption_Unit is populated."""
    if "Consumption_Unit" not in df.columns:
        return df
    df = df.copy()
    for unit_raw, group_idx in df.groupby("Consumption_Unit").groups.items():
        unit_key = str(unit_raw).strip().lower()
        factor = UNIT_CONVERSIONS.get(unit_key)
        if factor is not None and factor != 1.0:
            df.loc[group_idx, "Consumption"] = df.loc[group_idx, "Consumption"] * factor
    return df


def _infer_flags(df: pd.DataFrame) -> pd.DataFrame:
    """
    Derive Baseline_Bill and Reporting_Bill flags from Commission Date.
    Bills with Period Start Date strictly before Commission Date → Baseline.
    Bills with Period Start Date on or after Commission Date → Reporting.
    Commission Date must be present and populated; raises ValueError otherwise.
    """
    df = df.copy()

    if "Commission_Date" not in df.columns or df["Commission_Date"].isna().all():
        raise ValueError(
            "The template requires a 'Commission Date' column with a date value for every site. "
            "Bills before this date are treated as baseline; bills on/after are reporting."
        )

    df["Commission_Date"] = pd.to_datetime(df["Commission_Date"], errors="coerce")
    # Strip timezone info so date comparisons work regardless of tz-awareness
    df["Commission_Date"]    = df["Commission_Date"].dt.tz_localize(None) if df["Commission_Date"].dt.tz is not None else df["Commission_Date"]
    df["Period_Start_Date"]  = df["Period_Start_Date"].dt.tz_localize(None) if df["Period_Start_Date"].dt.tz is not None else df["Period_Start_Date"]
    df["Baseline_Bill"]   = (df["Period_Start_Date"] < df["Commission_Date"]).astype(int)
    df["Reporting_Bill"]  = (df["Period_Start_Date"] >= df["Commission_Date"]).astype(int)
    return df


def _calc_cvrmse(actual: np.ndarray, predicted: np.ndarray) -> float:
    rmse = np.sqrt(mean_squared_error(actual, predicted))
    mean_a = np.mean(actual)
    return (rmse / mean_a * 100) if mean_a != 0 else 999.0


def _weather_coverage(selected: pd.DataFrame, all_baseline: pd.DataFrame):
    """Returns (overall%, hdd%, cdd%)."""
    def cov(col):
        full_r = all_baseline[col].max() - all_baseline[col].min()
        sel_r  = selected[col].max()    - selected[col].min()
        return (sel_r / full_r * 100) if full_r > 0 else 100.0
    hdd_c = cov("HDD")
    cdd_c = cov("CDD")
    return (hdd_c + cdd_c) / 2, hdd_c, cdd_c


def _seasonal_ok(selected: pd.DataFrame, min_per_q: int) -> bool:
    counts = selected["Period_Start_Date"].dt.quarter.value_counts()
    return all(counts.get(q, 0) >= min_per_q for q in [1, 2, 3, 4])


def _n_choose_k(n, k):
    if k > n: return 0
    k = min(k, n - k)
    r = 1
    for i in range(k):
        r = r * (n - i) // (i + 1)
    return r


def _random_combos(n, k, count):
    # Fixed seed ensures identical results every run for the same input data.
    # The seed is derived from n and k so different sites/meters get different
    # random sequences, but each site always gets the same sequence.
    rng = np.random.default_rng(seed=(n * 1000 + k))
    seen, attempts = set(), 0
    while len(seen) < count and attempts < count * 4:
        c = tuple(sorted(rng.choice(n, k, replace=False)))
        if c not in seen:
            seen.add(c)
            yield c
        attempts += 1


# ─── Outlier detection ────────────────────────────────────────────────────────

def _baseline_outliers(bills: pd.DataFrame):
    if len(bills) < 2:
        return bills, pd.DataFrame()
    cons = bills["Consumption"]
    outlier_idx, reasons = [], {}

    # Zero / negative
    zero_mask = cons <= 0
    for i in bills[zero_mask].index:
        outlier_idx.append(i)
        reasons[i] = "Zero/Negative Consumption"

    # IQR on positives
    pos = bills[~zero_mask]
    if len(pos) >= 4:
        q1, q3 = pos["Consumption"].quantile(0.25), pos["Consumption"].quantile(0.75)
        iqr = q3 - q1
        lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
        for i, row in pos.iterrows():
            v = row["Consumption"]
            if v < lo:
                outlier_idx.append(i); reasons[i] = f"Too Low (< {lo:.0f})"
            elif v > hi:
                outlier_idx.append(i); reasons[i] = f"Too High (> {hi:.0f})"

    outlier_idx = list(set(outlier_idx))
    if not outlier_idx:
        return bills, pd.DataFrame()

    outliers = bills.loc[outlier_idx].copy()
    outliers["Outlier_Type"]   = "Baseline"
    outliers["Outlier_Reason"] = outliers.index.map(reasons)
    clean = bills.drop(index=outlier_idx)
    return clean, outliers  # kept untrimmed — safe_df enforces schema


def _reporting_outliers(model, bills: pd.DataFrame, is_gas: bool):
    if len(bills) < 1:
        return bills, pd.DataFrame()
    X = bills[["HDD"]].values if is_gas else bills[["HDD", "CDD"]].values
    pred = model.predict(X)
    actual = bills["Consumption"].values
    pct = np.where(pred != 0, (pred - actual) / pred * 100, 0)
    mask = (pct < -10) | (pct > 40)
    outliers = bills[mask].copy()
    clean    = bills[~mask].copy()
    if len(outliers) > 0:
        outliers["Outlier_Type"]   = "Reporting"
        outliers["Outlier_Reason"] = [
            f"% Avoided {p:.1f}% ({'< -10%' if p < -10 else '> 40%'})"
            for p in pct[mask]
        ]
        outliers["Pct_Avoided"] = pct[mask]
    return clean, outliers  # kept untrimmed — needed by _build_reporting_rows


# ─── Model fitting ────────────────────────────────────────────────────────────

def _fit_model(baseline: pd.DataFrame, is_gas: bool):
    X = baseline[["HDD"]].values if is_gas else baseline[["HDD", "CDD"]].values
    y = baseline["Consumption"].values
    m = LinearRegression().fit(X, y)
    pred = m.predict(X)
    r2   = r2_score(y, pred)
    cvrm = _calc_cvrmse(y, pred)
    return m, r2, cvrm


def _eval_combo(idx_list, baseline_pool, reporting_bills, all_baseline,
                r2_thresh, is_gas, site_id, service_type):
    selected = baseline_pool.iloc[list(idx_list)]
    m, r2, cvrmse = _fit_model(selected, is_gas)

    wc, hdd_c, cdd_c = _weather_coverage(selected, all_baseline)
    temporal_cv = 0.0
    qcounts = selected["Period_Start_Date"].dt.quarter.value_counts()
    if len(qcounts) > 1:
        temporal_cv = qcounts.std() / qcounts.mean() * 100

    passes_r2   = r2     >= r2_thresh
    passes_cv   = cvrmse <= CVRMSE_THRESHOLD
    passes_wc   = wc     >= WEATHER_COVERAGE_THRESHOLD
    passes_all  = passes_r2 and passes_cv and passes_wc

    # Reporting savings
    clean_rep, rep_outliers = _reporting_outliers(m, reporting_bills, is_gas)
    if len(clean_rep) > 0:
        X_rep = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep = m.predict(X_rep)
        avoided  = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd  = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd = 0.0, 0.0
        pred_rep = np.array([])

    intercept = m.intercept_
    hdd_coef  = m.coef_[0]
    cdd_coef  = m.coef_[1] if not is_gas else 0.0
    if is_gas:
        equation = f"Consumption = {intercept:.2f} + {hdd_coef:.4f}*HDD"
    else:
        equation = f"Consumption = {intercept:.2f} + {hdd_coef:.4f}*HDD + {cdd_coef:.4f}*CDD"

    q_dist = {f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]}

    return {
        "model":           m,
        "selected":        selected,
        "clean_reporting": clean_rep,
        "rep_outliers":    rep_outliers,
        "predicted_rep":   pred_rep,
        "equation":        equation,
        "intercept":       intercept,
        "hdd_coef":        hdd_coef,
        "cdd_coef":        cdd_coef,
        "r2":              r2,
        "cvrmse":          cvrmse,
        "wc_overall":      wc,
        "wc_hdd":          hdd_c,
        "wc_cdd":          cdd_c,
        "temporal_cv":     temporal_cv,
        "passes_r2":       passes_r2,
        "passes_cvrmse":   passes_cv,
        "passes_wc":       passes_wc,
        "passes_all":      passes_all,
        "total_avoided":   avoided,
        "pct_avoided":     pct_avd,
        "reporting_count": len(clean_rep),
        **q_dist,
    }


# ─── Optimizer ────────────────────────────────────────────────────────────────

def _optimize_from_locked(site_id: str, service_type: str,
                          bills: "pd.DataFrame", r2_thresh: float):
    """
    Reconstruct a model from pre-selected baseline bills (Selected_Baseline column).
    Used when the dataset already has an optimization run recorded.
    Returns the same (result, bl_outliers, rep_outliers) tuple as _optimize().
    """
    is_gas = _is_gas(service_type)

    # Handle float 1.0 (from CSV NaN/float conversion) as well as string "1"
    baseline_bills  = bills[
        bills["Selected_Baseline"].apply(lambda v: str(v).strip() in ("1", "1.0"))
    ].copy()
    reporting_bills = bills[bills["Reporting_Bill"] == 1].copy()

    if len(baseline_bills) == 0:
        # No locked baseline for this meter — fall through to normal optimization
        return None, [], []

    baseline_bills["Period_Start_Date"] = pd.to_datetime(
        baseline_bills["Period_Start_Date"], errors="coerce"
    )

    model, r2, cvrmse = _fit_model(baseline_bills, is_gas)
    wc, hdd_c, cdd_c  = _weather_coverage(baseline_bills, baseline_bills)
    qcounts = baseline_bills["Period_Start_Date"].dt.quarter.value_counts()

    passes_r2    = r2     >= r2_thresh
    passes_cv    = cvrmse <= CVRMSE_THRESHOLD
    passes_wc    = wc     >= WEATHER_COVERAGE_THRESHOLD
    passes_all   = passes_r2 and passes_cv and passes_wc

    clean_rep, rep_outliers = _reporting_outliers(model, reporting_bills, is_gas)

    if len(clean_rep) > 0:
        X_rep = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep  = model.predict(X_rep)
        avoided   = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd   = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd, pred_rep = 0.0, 0.0, np.array([])

    hdd_coef = model.coef_[0]
    cdd_coef = model.coef_[1] if not is_gas else 0.0
    if is_gas:
        equation = f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD"
    else:
        equation = f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD + {cdd_coef:.4f}*CDD"

    temporal_cv = 0.0
    if len(qcounts) > 1:
        temporal_cv = qcounts.std() / qcounts.mean() * 100

    # Check if locked selection exceeds CV ceiling for non-new sites
    is_new_locked = _is_new_site(baseline_bills)
    cv_relaxed_locked = (
        not is_new_locked
        and temporal_cv > TEMPORAL_CV_CEILING
    )

    q_dist = {f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]}

    result = {
        "model":               model,
        "selected":            baseline_bills,
        "clean_reporting":     clean_rep,
        "rep_outliers":        rep_outliers,
        "predicted_rep":       pred_rep,
        "equation":            equation,
        "intercept":           model.intercept_,
        "hdd_coef":            hdd_coef,
        "cdd_coef":            cdd_coef,
        "r2":                  r2,
        "cvrmse":              cvrmse,
        "wc_overall":          wc,
        "wc_hdd":              hdd_c,
        "wc_cdd":              cdd_c,
        "temporal_cv":         temporal_cv,
        "passes_r2":           passes_r2,
        "passes_cvrmse":       passes_cv,
        "passes_wc":           passes_wc,
        "passes_all":          passes_all,
        "total_avoided":       avoided,
        "pct_avoided":         pct_avd,
        "reporting_count":     len(clean_rep),
        "seasonal_strategy":   "Locked (pre-selected)",
        "is_new_site":         is_new_locked,
        "cv_ceiling_relaxed":  cv_relaxed_locked,
        "reporting_all":       reporting_bills,
        "bl_outliers_df":      pd.DataFrame(),
        **q_dist,
    }
    return result, [], list(rep_outliers.to_dict("records")) if len(rep_outliers) > 0 else []


def _is_new_site(baseline_bills) -> bool:
    """Returns True if baseline period spans < 12 months (new site)."""
    if len(baseline_bills) == 0: return True
    dates = pd.to_datetime(baseline_bills["Period_Start_Date"], errors="coerce").dropna()
    if len(dates) == 0: return True
    return (dates.max() - dates.min()).days < 365


def _combo_score(r2, temporal_cv, pct_avoided, reporting_count, max_reporting, is_new):
    """Weighted composite score. Higher is better.
    Normal: 0.45*R2 + 0.30*CV_inverted + 0.15*pct + 0.10*rep_frac
    New site: 0.75*R2 + 0.15*pct + 0.10*rep_frac (CV skipped)
    """
    r2_n  = max(0.0, min(1.0, r2))
    cv_n  = max(0.0, 1.0 - temporal_cv / 100.0)
    pct_n = (max(-10.0, min(40.0, pct_avoided)) + 10.0) / 50.0
    rep_n = (reporting_count / max_reporting) if max_reporting > 0 else 0.0
    if is_new:
        return 0.75 * r2_n + 0.15 * pct_n + 0.10 * rep_n
    return 0.45 * r2_n + 0.30 * cv_n + 0.15 * pct_n + 0.10 * rep_n


def _optimize(site_id, service_type, bills, baseline_count, r2_thresh):
    is_gas = _is_gas(service_type)

    raw_baseline  = bills[bills["Baseline_Bill"] == 1].copy()
    reporting_all = bills[bills["Reporting_Bill"] == 1].copy()

    if len(raw_baseline) == 0:
        return None, [], []

    clean_baseline, bl_outliers = _baseline_outliers(raw_baseline)

    if len(clean_baseline) < baseline_count:
        return None, list(bl_outliers.to_dict("records")), []

    clean_baseline = clean_baseline.copy()
    clean_baseline["Period_Start_Date"] = pd.to_datetime(clean_baseline["Period_Start_Date"])
    is_new = _is_new_site(clean_baseline)
    cv_relaxed = False

    def _run_strategy(min_per_q):
        n = len(clean_baseline)
        total = _n_choose_k(n, baseline_count)
        combos = (
            combinations(range(n), baseline_count)
            if total <= MAX_COMBINATIONS
            else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3)
        )

        valid = []
        for c in combos:
            sel = clean_baseline.iloc[list(c)]
            if not _seasonal_ok(sel, min_per_q):
                continue
            wc, _, _ = _weather_coverage(sel, clean_baseline)
            if wc < WEATHER_COVERAGE_THRESHOLD:
                continue
            # CV ceiling: exclude heavily skewed combos for normal sites
            if not is_new:
                qc = sel["Period_Start_Date"].dt.quarter.value_counts()
                if len(qc) > 1 and qc.std() / qc.mean() * 100 > TEMPORAL_CV_CEILING:
                    continue
            valid.append(c)
            if len(valid) >= MAX_COMBINATIONS:
                break

        # Fallback: relax CV ceiling if it filtered everything out
        if not valid and not is_new:
            nonlocal cv_relaxed
            cv_relaxed = True
            combos2 = (
                combinations(range(n), baseline_count)
                if total <= MAX_COMBINATIONS
                else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3)
            )
            for c in combos2:
                sel = clean_baseline.iloc[list(c)]
                if not _seasonal_ok(sel, min_per_q): continue
                wc, _, _ = _weather_coverage(sel, clean_baseline)
                if wc < WEATHER_COVERAGE_THRESHOLD: continue
                valid.append(c)
                if len(valid) >= MAX_COMBINATIONS: break

        if not valid:
            return None

        best_pass, best_fail = None, None
        best_pass_score = -np.inf
        best_fail_score = -np.inf
        max_rep = len(reporting_all)

        for c in valid:
            res = _eval_combo(c, clean_baseline, reporting_all, clean_baseline,
                              r2_thresh, is_gas, site_id, service_type)
            score = _combo_score(
                r2=res["r2"], temporal_cv=res["temporal_cv"],
                pct_avoided=res["pct_avoided"],
                reporting_count=res["reporting_count"],
                max_reporting=max_rep, is_new=is_new,
            )
            if res["passes_all"]:
                if score > best_pass_score:
                    best_pass_score, best_pass = score, res
            else:
                if score > best_fail_score:
                    best_fail_score, best_fail = score, res

        return best_pass or best_fail

    result = _run_strategy(PREFERRED_MIN_PER_QUARTER)
    strategy = f"Optimal (≥{PREFERRED_MIN_PER_QUARTER} bills per quarter)"
    if result is None:
        result = _run_strategy(MINIMUM_MIN_PER_QUARTER)
        strategy = f"Acceptable (≥{MINIMUM_MIN_PER_QUARTER} bill per quarter)"

    if result is None:
        return None, list(bl_outliers.to_dict("records")), []

    result["seasonal_strategy"] = strategy
    result["is_new_site"]        = is_new
    result["cv_ceiling_relaxed"] = cv_relaxed
    result["bl_outliers_df"]    = bl_outliers
    result["reporting_all"]     = reporting_all
    return result, list(bl_outliers.to_dict("records")), list(result["rep_outliers"].to_dict("records"))


# ─── Multi-meter handling ─────────────────────────────────────────────────────

def _meters_concurrent(site_data: pd.DataFrame) -> bool:
    """Return True if any two meters share ≥ OVERLAP_THRESHOLD billing periods."""
    meters = [m for m in site_data["Meter_Number"].dropna().unique()]
    if len(meters) < 2:
        return False
    for i in range(len(meters)):
        for j in range(i + 1, len(meters)):
            s1 = set(site_data[site_data["Meter_Number"] == meters[i]]["Period_Start_Date"])
            s2 = set(site_data[site_data["Meter_Number"] == meters[j]]["Period_Start_Date"])
            if len(s1 & s2) >= OVERLAP_THRESHOLD:
                return True
    return False


def _aggregate_site(site_data: pd.DataFrame) -> pd.DataFrame:
    """Sum consumption + charges per billing period across all meters."""
    agg_cols = {
        "Consumption":   "sum",
        "Total_Charges": "sum",
        "HDD":           "first",
        "CDD":           "first",
        "Service_Type":  "first",
        "Site_Name":     "first",
    }
    for opt in ["Baseline_Bill", "Reporting_Bill", "Commission_Date"]:
        if opt in site_data.columns:
            agg_cols[opt] = "first"
    return site_data.groupby(
        ["Period_Start_Date", "Period_End_Date"], as_index=False
    ).agg(agg_cols)


# ─── Main analysis ────────────────────────────────────────────────────────────


def _calc_meter_weights(site_data: pd.DataFrame, meter_nums: list) -> dict:
    """
    Calculate each meter's share of TOTAL BASELINE consumption at the site.
    Returns {str(meter_num): fraction (0.0–1.0)}.
    Meters with no baseline bills receive 0.0 (not excluded — just zero weight).
    """
    bl_df = site_data[site_data["Baseline_Bill"] == 1]

    meter_bl_cons = {}
    for meter in meter_nums:
        m_bl = bl_df[bl_df["Meter_Number"] == meter]
        meter_bl_cons[str(meter)] = float(m_bl["Consumption"].sum()) if len(m_bl) > 0 else 0.0

    total = sum(meter_bl_cons.values())
    if total == 0:
        # All meters lack baseline bills — equal weights so output is still meaningful
        n = max(len(meter_nums), 1)
        return {str(m): 1.0 / n for m in meter_nums}

    return {str(m): v / total for m, v in meter_bl_cons.items()}


def _weight_source(meter_num, site_data: pd.DataFrame) -> str:
    """Return a human-readable string describing the weight basis for this meter."""
    m_df = site_data[site_data["Meter_Number"] == meter_num]
    bl   = m_df[m_df["Baseline_Bill"] == 1]
    if len(bl) > 0 and bl["Consumption"].sum() > 0:
        return "Baseline consumption"
    return "No baseline bills — weight is 0%"


def _failing_weight_flag(meter_weights: dict, ind_results_for_site: list) -> tuple:
    """
    Assess the combined weight of FAILING individual meters.
    Returns (flag: str, note: str).
    No hard exclusions — purely informational.
    """
    failing = [
        (str(meter_num), meter_weights.get(str(meter_num), 0.0))
        for meter_num, res, _ in ind_results_for_site
        if not res["passes_all"]
    ]

    if not failing:
        return "OK", ""

    failing_weight = sum(w for _, w in failing)
    failing_names  = ", ".join(f"{m} ({w*100:.1f}%)" for m, w in failing)

    if failing_weight > WEIGHT_HIGH_RISK_THRESHOLD:
        note = (
            f"HIGH RISK — failing meter(s) [{failing_names}] account for "
            f"{failing_weight*100:.1f}% of site baseline load (>{WEIGHT_HIGH_RISK_THRESHOLD*100:.0f}% threshold). "
            f"The aggregate model covers consumption that cannot be individually verified — "
            f"review carefully before reporting."
        )
        return "HIGH RISK", note

    if failing_weight > WEIGHT_REVIEW_THRESHOLD:
        note = (
            f"REVIEW — failing meter(s) [{failing_names}] account for "
            f"{failing_weight*100:.1f}% of site baseline load (>{WEIGHT_REVIEW_THRESHOLD*100:.0f}% threshold). "
            f"A meaningful portion of site load is from unverified meters — analyst review recommended."
        )
        return "REVIEW", note

    return "OK", ""


def _low_coverage_flag(weight: float, passes_quality: bool) -> str:
    """
    Flag individual passing meters that represent a small fraction of site load.
    Only applied when the meter is part of a concurrent multi-meter site.
    Fires only on passing meters; failing meters are addressed via aggregate notes.
    """
    if not passes_quality:
        return ""   # failing meters: weight context lives in aggregate Notes column
    if weight < LOW_COVERAGE_THRESHOLD:
        return f"LOW COVERAGE ({weight*100:.1f}% of site baseline load)"
    return ""


def _build_meter_weight_rows(
    site: str,
    service_type: str,
    meter_weights: dict,
    ind_results_for_site: list,
    site_data: pd.DataFrame,
    agg_weight_flag: str,
) -> list:
    """One row per meter for the Meter Weights output table."""
    rows = []
    for meter_num, res, _ in ind_results_for_site:
        m_key  = str(meter_num)
        weight = meter_weights.get(m_key, 0.0)
        m_df   = site_data[site_data["Meter_Number"] == meter_num]
        bl_df  = m_df[m_df["Baseline_Bill"] == 1]
        bl_cons = float(bl_df["Consumption"].sum()) if len(bl_df) > 0 else 0.0

        rows.append({
            "Site Name":               site,
            "Meter Number":            m_key,
            "Service Type":            service_type,
            "Baseline Consumption":    round(bl_cons, 2),
            "Meter Weight (%)":        round(weight * 100, 2),
            "Weight Source":           _weight_source(meter_num, site_data),
            "Individual Model Passes": res["passes_all"],
            "Individual R2":           round(res["r2"], 4),
            "Individual CV-RMSE":      round(res["cvrmse"], 2),
            "Individual Pct Avoided":  round(res["pct_avoided"], 2),
            "Coverage Flag":           _low_coverage_flag(weight, res["passes_all"]),
            "Aggregate Weight Flag":   agg_weight_flag,
        })
    return rows




