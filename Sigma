def run_analysis(df: pd.DataFrame):
    """
    Run full M&V analysis on the cleaned input DataFrame.
    Returns a dict of DataFrames ready for Sigma table elements.
    """
    # ── Preprocessing ──────────────────────────────────────────────────────────
    df = df.copy()
    df.columns = df.columns.str.strip()

    # Keep original dataframe for input_with_baseline output
    df_original = df.copy()

    # Normalize column names: spaces → underscores internally.
    # The template uses "Site Name" style; the engine works with "Site_Name" style.
    # Both are supported — original names are preserved in output columns.
    col_map = {c: c.replace(' ', '_') for c in df.columns}
    df = df.rename(columns=col_map)

    # Parse dates — strip timezone info (Sigma may inject UTC-aware datetimes)
    for col in ["Period_Start_Date", "Period_End_Date", "Commission_Date"]:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], errors="coerce", utc=True).dt.tz_localize(None)

    # Numeric coercions — strip currency symbols/commas before converting
    for col in ["HDD", "CDD", "Consumption"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    # Total_Charges may arrive as "$1,234.56" string from Sigma — clean it first
    if "Total_Charges" in df.columns:
        df["Total_Charges"] = (
            df["Total_Charges"]
            .astype(str)
            .str.replace(r"[\$,]", "", regex=True)
            .str.strip()
        )
        df["Total_Charges"] = pd.to_numeric(df["Total_Charges"], errors="coerce")

    # Unit conversion (optional column)
    df = _convert_units(df)

    # ── Baseline selection lock ────────────────────────────────────────────────
    # If "Selected Baseline" column is present and populated, the optimizer was
    # already run. Skip optimization and use pre-selected bills directly.
    # This ensures re-running the script (e.g. after adding reporting bills)
    # never changes the baseline model or savings results.
    # Normalise Selected_Baseline: convert float 1.0 / NaN (from CSV download) to "1" / ""
    if "Selected_Baseline" in df.columns:
        df["Selected_Baseline"] = (
            df["Selected_Baseline"]
            .apply(lambda v: "1" if str(v).strip() in ("1", "1.0") else "")
        )
    has_locked_baseline = (
        "Selected_Baseline" in df.columns
        and (df["Selected_Baseline"] == "1").any()
    )

    # Geocode sites using address columns if present (runs once, cached by site)
    site_coords = {}   # MAP FEATURE (disabled) — un-comment _geocode_sites call to re-enable

    # Baseline/Reporting flags
    df = _infer_flags(df)

    # ── Storage for outputs ────────────────────────────────────────────────────
    individual_rows = []
    aggregated_rows = []
    baseline_bill_rows = []
    reporting_bill_rows = []
    outlier_rows = []
    meter_weight_rows = []
    selected_baseline_keys = set()  # (site, meter, period_start_date) of selected bills

    for service_type in df["Service_Type"].dropna().unique():
        is_gas      = _is_gas(service_type)
        svc_df      = df[df["Service_Type"].str.lower().str.contains(
            "gas" if is_gas else "elec", na=False
        )].copy()
        bl_count    = GAS_BASELINE_COUNT if is_gas else ELEC_BASELINE_COUNT
        r2_thresh   = GAS_R2_THRESHOLD   if is_gas else ELEC_R2_THRESHOLD
        display_svc = "Natural Gas" if is_gas else "Electricity"

        for site in sorted(svc_df["Site_Name"].dropna().unique()):
            site_data   = svc_df[svc_df["Site_Name"] == site].copy()
            meter_nums  = [m for m in site_data["Meter_Number"].dropna().unique()]
            meter_count = len(meter_nums)
            concurrent  = _meters_concurrent(site_data) if meter_count > 1 else False

            # ── Individual meter analysis ──────────────────────────────────────
            ind_results_for_site = []

            if meter_count == 0 or (meter_count == 1 and pd.isna(meter_nums[0])):
                # No meter number — analyze by site
                meter_iter = [("N/A", site_data)]
            elif not concurrent and meter_count > 1:
                # Sequential meters — combine into single timeline
                combined = _aggregate_site(site_data)
                meter_label = ", ".join(sorted(str(m) for m in meter_nums))
                meter_iter = [(meter_label, combined)]
            else:
                meter_iter = [(m, site_data[site_data["Meter_Number"] == m]) for m in sorted(meter_nums, key=str)]

            for meter_num, meter_data in meter_iter:
                sequential = (not concurrent and meter_count > 1)

                if has_locked_baseline:
                    # ── LOCKED MODE: baseline already selected ─────────────────
                    # Use the Selected_Baseline flag to identify which bills form
                    # the baseline. Skip the optimizer entirely.
                    res, bl_out, rep_out = _optimize_from_locked(
                        f"{site}__{meter_num}", display_svc, meter_data, r2_thresh
                    )
                else:
                    # ── OPTIMIZE MODE: find the best baseline combination ───────
                    res, bl_out, rep_out = _optimize(
                        f"{site}__{meter_num}", display_svc, meter_data, bl_count, r2_thresh
                    )

                if res is None:
                    continue

                # _store_address(res, site_data, site)  # MAP FEATURE (disabled)
                row = _build_result_row(
                    res, site, meter_num, "Individual", display_svc,
                    bl_count, concurrent, sequential
                )
                individual_rows.append(row)
                ind_results_for_site.append((meter_num, res, row))

                # Bill detail rows
                baseline_bill_rows += _build_baseline_rows(res, site, meter_num, display_svc)
                for _, _sr in res["selected"].iterrows():
                    # Normalise N/A, blank, nan all to "" so lookup matches
                    _mn = str(meter_num) if str(meter_num) not in ("", "nan", "N/A", "n/a") and pd.notna(meter_num) else ""
                    selected_baseline_keys.add((str(site), _mn,
                        str(pd.to_datetime(_sr["Period_Start_Date"]).date())))
                reporting_bill_rows += _build_reporting_rows(res, site, meter_num, display_svc)

                # Outliers
                for o in bl_out:
                    outlier_rows.append({
                        "Site Name":      site,
                        "Meter Number":   str(meter_num),
                        "Service Type":   display_svc,
                        "Period Start Date": o.get("Period_Start_Date") or o.get("Period Start Date"),
                        "Period End Date":   o.get("Period_End_Date")   or o.get("Period End Date"),
                        "HDD":            o.get("HDD"),
                        "CDD":            o.get("CDD"),
                        "Consumption":    o.get("Consumption"),
                        "Total Charges":  o.get("Total_Charges") or o.get("Total Charges"),
                        "Outlier Type":   o.get("Outlier_Type",   o.get("Outlier Type", "")),
                        "Outlier Reason": o.get("Outlier_Reason", o.get("Outlier Reason", "")),
                    })
                for o in rep_out:
                    outlier_rows.append({
                        "Site Name":      site,
                        "Meter Number":   str(meter_num),
                        "Service Type":   display_svc,
                        "Period Start Date": o.get("Period_Start_Date") or o.get("Period Start Date"),
                        "Period End Date":   o.get("Period_End_Date")   or o.get("Period End Date"),
                        "HDD":            o.get("HDD"),
                        "CDD":            o.get("CDD"),
                        "Consumption":    o.get("Consumption"),
                        "Total Charges":  o.get("Total_Charges") or o.get("Total Charges"),
                        "Outlier Type":   o.get("Outlier_Type",   o.get("Outlier Type", "")),
                        "Outlier Reason": o.get("Outlier_Reason", o.get("Outlier Reason", "")),
                    })

            # ── Meter weighting (concurrent multi-meter sites only) ───────────
            if concurrent and meter_count > 1 and len(ind_results_for_site) > 0:
                mw = _calc_meter_weights(site_data, [m for m, _, _ in ind_results_for_site])
                # Stamp Meter Weight (%) and Coverage Flag onto each individual row
                for r in individual_rows:
                    if (r["Site Name"] == site
                            and r["Service Type"] == display_svc
                            and r["Model Type"] == "Individual"):
                        m_key = str(r["Meter Number"])
                        w = mw.get(m_key, 0.0)
                        r["Meter Weight (%)"] = round(w * 100, 2)
                        r["Coverage Flag"]    = _low_coverage_flag(w, r["Model Passes Quality"])
            else:
                mw = {}

            # ── Aggregated analysis (concurrent multi-meter sites only) ────────
            if concurrent and meter_count > 1:
                agg_data = _aggregate_site(site_data)
                res, bl_out, rep_out = _optimize(
                    f"{site}__AGGREGATED", display_svc, agg_data, bl_count, r2_thresh
                )
                if res is not None:
                    # _store_address(res, site_data, site)  # MAP FEATURE (disabled)
                    row = _build_result_row(
                        res, site, f"AGGREGATED ({meter_count})", "Aggregated",
                        display_svc, bl_count, concurrent, False
                    )
                    # Attach Notes comparing individual vs. aggregated
                    # Assess failing-meter weight and build combined Notes
                    agg_flag, weight_note = _failing_weight_flag(mw, ind_results_for_site)
                    row["Weight Flag"]  = agg_flag
                    quality_note        = _build_notes(ind_results_for_site, res, meter_count)
                    row["Notes"]        = " | ".join(filter(None, [quality_note, weight_note]))

                    # Patch individual rows with same Notes
                    for r in individual_rows:
                        if (r["Site Name"] == site
                                and r["Service Type"] == display_svc
                                and r["Model Type"] == "Individual"):
                            r["Notes"] = row["Notes"]

                    # Build Meter Weights table rows
                    meter_weight_rows.extend(
                        _build_meter_weight_rows(
                            site, display_svc, mw,
                            ind_results_for_site, site_data, agg_flag
                        )
                    )

                    aggregated_rows.append(row)
                    baseline_bill_rows  += _build_baseline_rows(res, site, f"AGGREGATED ({meter_count})", display_svc)
                    for _, _sr in res["selected"].iterrows():
                        selected_baseline_keys.add((str(site), "AGGREGATED",
                            str(pd.to_datetime(_sr["Period_Start_Date"]).date())))
                    reporting_bill_rows += _build_reporting_rows(res, site, f"AGGREGATED ({meter_count})", display_svc)
                    for o in bl_out:
                        outlier_rows.append({
                            "Site Name":      site,
                            "Meter Number":   f"AGGREGATED ({meter_count})",
                            "Service Type":   display_svc,
                            "Period Start Date": o.get("Period_Start_Date") or o.get("Period Start Date"),
                            "Period End Date":   o.get("Period_End_Date")   or o.get("Period End Date"),
                            "HDD":            o.get("HDD"),
                            "CDD":            o.get("CDD"),
                            "Consumption":    o.get("Consumption"),
                            "Total Charges":  o.get("Total_Charges") or o.get("Total Charges"),
                            "Outlier Type":   o.get("Outlier_Type",   o.get("Outlier Type", "")),
                            "Outlier Reason": o.get("Outlier_Reason", o.get("Outlier Reason", "")),
                        })
                    for o in rep_out:
                        outlier_rows.append({
                            "Site Name":      site,
                            "Meter Number":   f"AGGREGATED ({meter_count})",
                            "Service Type":   display_svc,
                            "Period Start Date": o.get("Period_Start_Date") or o.get("Period Start Date"),
                            "Period End Date":   o.get("Period_End_Date")   or o.get("Period End Date"),
                            "HDD":            o.get("HDD"),
                            "CDD":            o.get("CDD"),
                            "Consumption":    o.get("Consumption"),
                            "Total Charges":  o.get("Total_Charges") or o.get("Total Charges"),
                            "Outlier Type":   o.get("Outlier_Type",   o.get("Outlier Type", "")),
                            "Outlier Reason": o.get("Outlier_Reason", o.get("Outlier Reason", "")),
                        })
                else:
                    # Aggregated model failed to optimise (insufficient clean bills etc.)
                    # Still record meter weights so analyst can see the load distribution
                    if mw:
                        meter_weight_rows.extend(
                            _build_meter_weight_rows(
                                site, display_svc, mw,
                                ind_results_for_site, site_data, "NO AGG MODEL"
                            )
                        )

    # ── Assemble output DataFrames ─────────────────────────────────────────────
    # Schema definitions — ensures every output has columns even when empty.
    # Snowpark/Sigma cannot output a DataFrame with no columns (raises schema error).
    SCHEMAS = {
        "individual":  ["Site Name","Meter Number","Model Type","Service Type",
                        "Seasonal Strategy","Optimization Mode","Baseline Count","Reporting Count",
                        "Model Equation","Intercept","HDD Coefficient","CDD Coefficient",
                        "R2","R2 Rating","Passes R2","CV-RMSE","CV-RMSE Rating",
                        "Passes CV-RMSE","Weather Coverage (%)","HDD Coverage (%)",
                        "CDD Coverage (%)","Weather Coverage Rating","Passes Weather Coverage",
                        "Model Passes Quality","Q1 Bills","Q2 Bills","Q3 Bills","Q4 Bills",
                        "Temporal CV","Total Avoided Usage","Pct Avoided Usage","Notes",
                        "Weight Flag","Meter Weight (%)","Coverage Flag",
                        "Measured Rate","Modeled Cost ($)","Actual Cost ($)",
                        "Avoided Cost ($)","Avg Monthly Avoided Cost",
                        "Total Modeled Usage","Total Actual Usage",
                        "Savings Exclusion Flag","Savings Status",
                        "New Site","CV Ceiling Relaxed"],
                        # MAP FEATURE columns (disabled — un-comment to re-enable):
                        # "Street Address","City","State","Zip Code",
                        # "Full Address","Latitude","Longitude"
        "aggregated":  ["Site Name","Meter Number","Model Type","Service Type",
                        "Seasonal Strategy","Optimization Mode","Baseline Count","Reporting Count",
                        "Model Equation","Intercept","HDD Coefficient","CDD Coefficient",
                        "R2","R2 Rating","Passes R2","CV-RMSE","CV-RMSE Rating",
                        "Passes CV-RMSE","Weather Coverage (%)","HDD Coverage (%)",
                        "CDD Coverage (%)","Weather Coverage Rating","Passes Weather Coverage",
                        "Model Passes Quality","Q1 Bills","Q2 Bills","Q3 Bills","Q4 Bills",
                        "Temporal CV","Total Avoided Usage","Pct Avoided Usage","Notes",
                        "Weight Flag","Meter Weight (%)","Coverage Flag",
                        "Measured Rate","Modeled Cost ($)","Actual Cost ($)",
                        "Avoided Cost ($)","Avg Monthly Avoided Cost",
                        "Total Modeled Usage","Total Actual Usage",
                        "Savings Exclusion Flag","Savings Status",
                        "New Site","CV Ceiling Relaxed"],
                        # MAP FEATURE columns (disabled — un-comment to re-enable):
                        # "Street Address","City","State","Zip Code",
                        # "Full Address","Latitude","Longitude"
        "bills":       ["Site Name","Meter Number","Service Type","Period Type","Status",
                        "Period Start Date","Period End Date","HDD","CDD",
                        "Consumption","Total Charges","Predicted Consumption",
                        "Avoided Usage","Pct Avoided","Bill Avoided Cost",
                        "Selected Baseline"],
        "outliers":    ["Site Name","Meter Number","Service Type",
                        "Period Start Date","Period End Date","HDD","CDD",
                        "Consumption","Total Charges",
                        "Outlier Type","Outlier Reason"],
        "weights":     ["Site Name","Meter Number","Service Type",
                        "Baseline Consumption","Meter Weight (%)","Weight Source",
                        "Individual Model Passes","Individual R2","Individual CV-RMSE",
                        "Individual Pct Avoided","Coverage Flag","Aggregate Weight Flag"],
    }

    def safe_df(rows, schema_key):
        if rows:
            df_out = pd.DataFrame(rows)
        else:
            # Return empty DataFrame with correct columns so Snowpark can infer schema
            df_out = pd.DataFrame(columns=SCHEMAS[schema_key])
        # Hard-enforce schema for outliers: strip any extra columns that leaked
        # through from the input DataFrame (e.g. duplicate Site Name (1) etc.)
        if schema_key == "outliers" and len(df_out.columns) > 0:
            keep = [c for c in SCHEMAS["outliers"] if c in df_out.columns]
            if keep:
                df_out = df_out[keep]
        return df_out

    ind_df  = safe_df(individual_rows,   "individual")
    agg_df  = safe_df(aggregated_rows,   "aggregated")
    bl_df   = safe_df(baseline_bill_rows, "bills")
    rep_df  = safe_df(reporting_bill_rows,"bills")
    out_df  = safe_df(outlier_rows,       "outliers")
    mw_df   = safe_df(meter_weight_rows,  "weights")

    # ── input_with_baseline: original input + Selected Baseline column ────────
    iwb_df = df_original.copy()
    # Drop any existing Selected Baseline column (could be "Selected Baseline"
    # or "Selected_Baseline" depending on prior normalisation) so we always
    # output exactly one clean copy at the end.
    iwb_df = iwb_df.drop(columns=[
        c for c in iwb_df.columns
        if c.lower().replace(" ", "_") == "selected_baseline"
    ])
    iwb_df["Selected Baseline"] = ""
    _sc = next((c for c in iwb_df.columns if c.lower().replace("_"," ")=="site name"), None)
    _mc = next((c for c in iwb_df.columns if "meter" in c.lower()), None)
    _pc = next((c for c in iwb_df.columns if "start" in c.lower()), None)
    if _sc and _pc:
        # For locked baselines: the normalised df already has Selected_Baseline="1"
        # on the chosen bills. Map those back onto df_original via site+meter+date key.
        # This is more reliable than selected_baseline_keys which depends on
        # _optimize_from_locked having recorded keys correctly.
        if has_locked_baseline and "Selected_Baseline" in df.columns:
            # Build a lookup from the internal (normalised) df
            _sel_col = "Selected_Baseline"
            _mc_int  = next((c for c in df.columns if "meter" in c.lower()), None)
            _pc_int  = next((c for c in df.columns if "start" in c.lower()), None)
            _sc_int  = next((c for c in df.columns if c.lower() == "site_name"), None)
            if _sc_int and _pc_int:
                locked_keys = set()
                for _, _lr in df[df[_sel_col] == "1"].iterrows():
                    _ls  = str(_lr.get(_sc_int,""))
                    _lm  = str(_lr.get(_mc_int,"")) if _mc_int else ""
                    _lm  = "" if _lm.strip() in ("","nan","N/A") else _lm
                    _lpd = str(pd.to_datetime(_lr.get(_pc_int,""),errors="coerce").date())
                    locked_keys.add((_ls, _lm, _lpd))
                def _mark(r):
                    sv = str(r.get(_sc,""))
                    _raw_mv = r.get(_mc,"") if _mc else ""
                    mv = "" if (pd.isna(_raw_mv) or str(_raw_mv).strip() in ("","nan")) else str(_raw_mv)
                    pv = str(pd.to_datetime(r.get(_pc,""),errors="coerce").date())
                    if (sv,mv,pv) in locked_keys: return "1"
                    if (sv,"AGGREGATED",pv) in locked_keys: return "1"
                    return ""
            else:
                def _mark(r): return ""
        else:
            def _mark(r):
                sv = str(r.get(_sc,""))
                _raw_mv = r.get(_mc,"") if _mc else ""
                mv = "" if (pd.isna(_raw_mv) or str(_raw_mv).strip() in ("","nan")) else str(_raw_mv)
                pv = str(pd.to_datetime(r.get(_pc,""),errors="coerce").date())
                if (sv,mv,pv) in selected_baseline_keys: return "1"
                if (sv,"AGGREGATED",pv) in selected_baseline_keys: return "1"
                return ""
        iwb_df["Selected Baseline"] = iwb_df.apply(_mark, axis=1)
    _oc = [c for c in df_original.columns if c != "Selected Baseline"]
    iwb_df = iwb_df[_oc + ["Selected Baseline"]]
    # Ensure Selected Baseline is always clean string "1" or "" (never NaN or 1.0)
    iwb_df["Selected Baseline"] = iwb_df["Selected Baseline"].apply(
        lambda v: "1" if str(v).strip() in ("1", "1.0") else ""
    )

    # Add cost analysis columns to model result tables
    if len(ind_df) > 0:
        ind_df = _add_cost_columns(ind_df)
    if len(agg_df) > 0:
        agg_df = _add_cost_columns(agg_df)

    # Stamp geocoded coordinates onto model result rows
    if site_coords:
        for df_out in [ind_df, agg_df]:
            if len(df_out) > 0 and 'Site Name' in df_out.columns:
                df_out['Latitude']  = df_out['Site Name'].map(
                    lambda s: site_coords.get(s, (None, None))[0])
                df_out['Longitude'] = df_out['Site Name'].map(
                    lambda s: site_coords.get(s, (None, None))[1])

    return {
        "individual_models":      ind_df,
        "aggregated_models":      agg_df,
        "baseline_bills":         bl_df,
        "reporting_bills":        rep_df,
        "outliers":               out_df,
        "meter_weights":          mw_df,
        "input_with_baseline":    iwb_df,
    }


