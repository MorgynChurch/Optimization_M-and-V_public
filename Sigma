        "Notes":                   notes,
        "Savings Status":          "Included",  # overwritten to "Excluded" by _compute_cost_cols
        "Weight Flag":             "",     # filled in for aggregate rows
        "Meter Weight (%)":        None,   # filled in for concurrent multi-meter sites
        "Coverage Flag":           "",     # LOW COVERAGE if passing meter < 15% of site load
        # ── MAP FEATURE (disabled) — address and coordinate output columns ────
        # Un-comment to re-enable alongside the geocoding block.
