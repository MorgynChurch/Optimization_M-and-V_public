def build_notes(ind_results, agg_res, meter_count):
    ind_pass  = sum(1 for _, r, _ in ind_results if r["passes_all"])
    total_ind = len(ind_results)
    agg_pass  = agg_res["passes_all"]
    avg_r2    = np.mean([r["r2"] for _, r, _ in ind_results]) if ind_results else 0
    avg_sav   = np.mean([r["pct_avoided"] for _, r, _ in ind_results if r["passes_all"]]) if ind_pass > 0 else 0

    if   ind_pass == total_ind and agg_pass:     qual = f"All {total_ind} individual and aggregated pass quality"
    elif ind_pass > 0 and agg_pass:              qual = f"{ind_pass}/{total_ind} individual and aggregated pass quality"
    elif agg_pass and ind_pass == 0:             qual = f"Only aggregated passes (all {total_ind} individual fail)"
    elif ind_pass == total_ind and not agg_pass: qual = f"All {total_ind} individual pass; aggregated fails"
    else:                                        qual = f"{ind_pass}/{total_ind} individual pass; aggregated {'passes' if agg_pass else 'fails'}"

    parts = [qual, f"Avg individual R²={avg_r2:.2f}, Aggregated R²={agg_res['r2']:.2f}"]
    if agg_pass and ind_pass > 0:
        parts.append(f"Avg individual savings={avg_sav:.1f}%, Aggregated={agg_res['pct_avoided']:.1f}%")
    return " | ".join(parts)


# ── input_with_baseline builder ───────────────────────────────────────────────

def build_input_with_baseline(df_original, selected_baseline_keys):
    """
    Returns df_original with a clean Selected Baseline column stamped.
    Existing "1" values in the input are preserved; new selections from
    this run are added. Blank/NaN entries become "".
    """
    iwb = df_original.copy()

    _sc = next((c for c in iwb.columns if c.lower().replace("_", " ") == "site name"), None)
    _mc = next((c for c in iwb.columns if "meter" in c.lower()), None)
    _pc = next((c for c in iwb.columns if "start" in c.lower() and "period" in c.lower()), None)

    # Capture existing Selected Baseline values BEFORE dropping the column,
    # so re-upload files don't lose previously locked baseline marks.
    existing_sb_col = next(
        (c for c in iwb.columns if c.lower().replace(" ", "_") == "selected_baseline"), None
    )
    existing_sb = {}
    if existing_sb_col and _sc and _pc:
        for _, r in iwb.iterrows():
            if str(r.get(existing_sb_col, "")).strip() in ("1", "1.0"):
                sv = str(r.get(_sc, ""))
                pv = str(pd.to_datetime(r.get(_pc, ""), errors="coerce").date())
                mv = str(r.get(_mc, "")) if _mc else ""
                existing_sb[(sv, mv, pv)] = "1"

    iwb = iwb.drop(columns=[c for c in iwb.columns
                             if c.lower().replace(" ", "_") == "selected_baseline"])
    iwb["Selected Baseline"] = ""

    if _sc and _pc:
        def _mark(r):
            sv  = str(r.get(_sc, ""))
            mv_raw = r.get(_mc, "") if _mc else ""
            # Normalise blank/NaN meter to "N/A" — matches how meter_iter labels no-meter sites
            mv  = "N/A" if (mv_raw is None or str(mv_raw).strip() in ("", "nan", "NaN"))\
                  else str(mv_raw)
            pv  = str(pd.to_datetime(r.get(_pc, ""), errors="coerce").date())
            if (sv, mv, pv) in selected_baseline_keys:           return "1"
            if (sv, "AGGREGATED", pv) in selected_baseline_keys: return "1"
            if existing_sb.get((sv, mv, pv)) == "1":             return "1"
            return ""
        iwb["Selected Baseline"] = iwb.apply(_mark, axis=1)

    orig_cols = [c for c in df_original.columns if c != "Selected Baseline" and c in iwb.columns]
    return iwb[orig_cols + ["Selected Baseline"]]


# ── Main analysis ─────────────────────────────────────────────────────────────

def run_analysis(df: pd.DataFrame,
                 already_preprocessed: bool = False,
                 df_original: pd.DataFrame = None,
                 has_locked: bool = None) -> dict:
    if already_preprocessed:
        # Caller (Sigma weather path) has already run preprocess() and
        # merge_weather(); df_original and has_locked are passed in directly.
        df = infer_flags(df)
    else:
        df, df_original, has_locked = preprocess(df)
        df = infer_flags(df)

    individual_rows, aggregated_rows        = [], []
    baseline_bill_rows, reporting_bill_rows = [], []
    outlier_rows, meter_weight_rows         = [], []
    selected_baseline_keys                  = set()

    # ── Exclude sites with no weather data from either source ─────────────────
    # A site is excluded if every one of its rows has NaN for both HDD and CDD.
    # Partial coverage (some rows have data, some don't) is allowed through —
    # the optimizer will handle sparse weather via the weather coverage gate.
    if "HDD" in df.columns and "CDD" in df.columns:
        no_weather_mask  = df["HDD"].isna() & df["CDD"].isna()
        no_weather_sites = (
            df[no_weather_mask]["Site_Name"]
            .dropna()
            .unique()
        )
        # Only exclude a site if ALL of its rows lack weather data.
        fully_excluded = sorted([
            s for s in no_weather_sites
            if df[df["Site_Name"] == s]["HDD"].isna().all()
            and df[df["Site_Name"] == s]["CDD"].isna().all()
        ])
        if fully_excluded:
            print(
                f"\n[WARNING] The following {len(fully_excluded)} site(s) have no HDD/CDD "
                f"data from any source and will be excluded from all calculations:\n"
                + "\n".join(f"  - {s}" for s in fully_excluded)
                + "\n"
            )
            df = df[~df["Site_Name"].isin(fully_excluded)].copy()
    # ──────────────────────────────────────────────────────────────────────────

    for service_type in df["Service_Type"].dropna().unique():
        is_gas      = _is_gas(service_type)
        svc_df      = df[df["Service_Type"].str.lower().str.contains(
                          "gas" if is_gas else "elec", na=False)].copy()
        bl_count    = GAS_BASELINE_COUNT if is_gas else ELEC_BASELINE_COUNT
        r2_thresh   = GAS_R2_THRESHOLD   if is_gas else ELEC_R2_THRESHOLD
        display_svc = "Natural Gas" if is_gas else "Electricity"

        for site in sorted(svc_df["Site_Name"].dropna().unique()):
            site_data   = svc_df[svc_df["Site_Name"] == site].copy()
            meter_nums  = [m for m in site_data["Meter_Number"].dropna().unique()]
            meter_count = len(meter_nums)
            concurrent  = meters_concurrent(site_data) if meter_count > 1 else False

            ind_results_for_site = []

            if meter_count == 0 or (meter_count == 1 and pd.isna(meter_nums[0])):
                meter_iter = [("N/A", site_data)]
            elif not concurrent and meter_count > 1:
                meter_iter = [(", ".join(sorted(str(m) for m in meter_nums)),
                               aggregate_site(site_data))]
            else:
                meter_iter = [(m, site_data[site_data["Meter_Number"] == m])
                              for m in sorted(meter_nums, key=str)]

            for meter_num, meter_data in meter_iter:
                sequential = not concurrent and meter_count > 1

                if has_locked:
                    res, bl_out, rep_out = optimize_from_locked(
                        f"{site}__{meter_num}", display_svc, meter_data, r2_thresh)
                else:
                    res, bl_out, rep_out = optimize(
                        f"{site}__{meter_num}", display_svc, meter_data, bl_count, r2_thresh)

                if res is None:
                    continue

                row = build_result_row(res, site, meter_num, "Individual",
                                       display_svc, bl_count, concurrent, sequential)
                individual_rows.append(row)
                ind_results_for_site.append((meter_num, res, row))

                baseline_bill_rows  += build_baseline_rows(res, site, meter_num, display_svc)
                reporting_bill_rows += build_reporting_rows(
                    res, site, meter_num, display_svc,
                    model_passes=row["Model Passes Quality"],
                    savings_status=row["Savings Status"])

                for _, _sr in res["selected"].iterrows():
                    selected_baseline_keys.add(
                        (str(site), str(meter_num),
                         str(pd.to_datetime(_sr["Period_Start_Date"]).date())))

                for o in bl_out + rep_out:
                    outlier_rows.append(build_outlier_row(o, site, meter_num, display_svc))

            # Meter weighting (concurrent only)
            if concurrent and meter_count > 1 and ind_results_for_site:
                mw = calc_meter_weights(site_data, [m for m, _, _ in ind_results_for_site])
                for r in individual_rows:
                    if (r["Site Name"] == site and r["Service Type"] == display_svc
                            and r["Model Type"] == "Individual"):
                        w = mw.get(str(r["Meter Number"]), 0.0)
                        r["Meter Weight (%)"] = round(w * 100, 2)
                        r["Coverage Flag"]    = low_coverage_flag(w, r["Model Passes Quality"])
            else:
                mw = {}

            # Aggregated model (concurrent only)
            if concurrent and meter_count > 1:
                agg_data = aggregate_site(site_data)
                res, bl_out, rep_out = optimize(
                    f"{site}__AGGREGATED", display_svc, agg_data, bl_count, r2_thresh)

                if res is not None:
                    row       = build_result_row(res, site, f"AGGREGATED ({meter_count})",
                                                 "Aggregated", display_svc, bl_count, concurrent, False)
                    agg_flag, weight_note = failing_weight_flag(mw, ind_results_for_site)
                    qual_note = build_notes(ind_results_for_site, res, meter_count)
                    row["Weight Flag"] = agg_flag
                    row["Notes"]       = " | ".join(filter(None, [qual_note, weight_note]))

                    for r in individual_rows:
                        if (r["Site Name"] == site and r["Service Type"] == display_svc
                                and r["Model Type"] == "Individual"):
                            r["Notes"] = row["Notes"]

                    aggregated_rows.append(row)
                    meter_weight_rows.extend(
                        build_meter_weight_rows(site, display_svc, mw,
                                                ind_results_for_site, site_data, agg_flag))

                    baseline_bill_rows  += build_baseline_rows(
                        res, site, f"AGGREGATED ({meter_count})", display_svc)
                    reporting_bill_rows += build_reporting_rows(
                        res, site, f"AGGREGATED ({meter_count})", display_svc,
                        model_passes=row["Model Passes Quality"],
                        savings_status=row["Savings Status"])

                    for _, _sr in res["selected"].iterrows():
                        selected_baseline_keys.add(
                            (str(site), "AGGREGATED",
                             str(pd.to_datetime(_sr["Period_Start_Date"]).date())))

                    for o in bl_out + rep_out:
                        outlier_rows.append(
                            build_outlier_row(o, site, f"AGGREGATED ({meter_count})", display_svc))
                else:
                    if mw:
                        meter_weight_rows.extend(
                            build_meter_weight_rows(site, display_svc, mw,
                                                    ind_results_for_site, site_data, "NO AGG MODEL"))

    run_timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    ind_df = _safe_df(individual_rows, "model")
    if len(ind_df) > 0:
        ind_df["Last Run Timestamp"] = run_timestamp

    return {
        "individual_models":   ind_df,
        "aggregated_models":   _safe_df(aggregated_rows,    "model"),
        "baseline_bills":      _safe_df(baseline_bill_rows,  "bills"),
        "reporting_bills":     _safe_df(reporting_bill_rows, "bills"),
        "outliers":            _safe_df(outlier_rows,        "outliers"),
        "meter_weights":       _safe_df(meter_weight_rows,   "weights"),
        "input_with_baseline": build_input_with_baseline(df_original, selected_baseline_keys),
    }


# ── Sigma weather assembly ────────────────────────────────────────────────────

def fetch_sigma_weather() -> pd.DataFrame:
    """
    Read the SITE_DAILY_WEATHER_HISTORY element from the Sigma workbook and
    return it as a DataFrame.

    The element is expected to expose at minimum:
        Icao Id, Date Valid Std, Hdd Lt 65 F, Cdd Gt 65 F

    The join to billing data is made on Icao Id, which maps directly to the
    WeatherStation column present on the Input table. Site Name is not used.

    Returns the raw daily DataFrame, or an empty DataFrame with those four
    columns if the element is missing or empty (triggering full CSV fallback).
    """
    _empty = pd.DataFrame(columns=["Icao Id", "Date Valid Std",
                                    "Hdd Lt 65 F", "Cdd Gt 65 F"])
    try:
        _raw     = sigma.get_element('Weather')  # Must be a string literal (Sigma requirement)
        assert 'Weather' == SIGMA_WEATHER_ELEMENT, \
            f"SIGMA_WEATHER_ELEMENT ('{SIGMA_WEATHER_ELEMENT}') does not match " \
            f"the literal in get_element(). Update both together."
        daily_df = _raw.to_pandas(block=False).result()
    except Exception as e:
        print(f"[WARNING] Could not read Sigma weather element: {e}. "
              f"Falling back to CSV HDD/CDD for all rows.")
        return _empty

    if len(daily_df) == 0:
        print("[WARNING] Sigma weather element is empty. "
              "Falling back to CSV HDD/CDD for all rows.")
        return _empty

    # Sigma returns opaque column IDs rather than human-readable names.
    # Rename only the columns this function needs; leave the rest as-is.
    # IDs sourced from the Weather workbook element schema (element sG67St_HXW).
    WEATHER_COL_MAP = {
        "gJz9orTGQ0": "Icao Id",
        "oF9OD1RK9o": "Date Valid Std",
        "Qgr6EWaBm6": "Hdd Lt 65 F",
        "3VR-mfnB9v": "Cdd Gt 65 F",
    }
    daily_df = daily_df.rename(columns=WEATHER_COL_MAP)

    # Verify all required columns are present after rename.
    required = {"Icao Id", "Date Valid Std", "Hdd Lt 65 F", "Cdd Gt 65 F"}
    missing  = required - set(daily_df.columns)
    if missing:
        print(f"[WARNING] Weather element missing expected columns after rename: {missing}. "
              f"Actual columns received: {list(daily_df.columns)}. "
              f"Falling back to CSV HDD/CDD for all rows.")
        return _empty

    # Normalise types on arrival.
    daily_df["Date Valid Std"] = pd.to_datetime(
        daily_df["Date Valid Std"], errors="coerce", utc=True
    ).dt.tz_convert(None)
    daily_df["Hdd Lt 65 F"] = pd.to_numeric(daily_df["Hdd Lt 65 F"], errors="coerce")
    daily_df["Cdd Gt 65 F"] = pd.to_numeric(daily_df["Cdd Gt 65 F"], errors="coerce")

    return daily_df


def aggregate_weather_to_periods(daily_df: pd.DataFrame,
                                  billing_df: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate daily weather rows to billing period totals.

    Joins on WeatherStation (from billing_df) = Icao Id (from daily_df), then
    sums Hdd Lt 65 F and Cdd Gt 65 F across each billing period window
    (Date Valid Std >= Period_Start_Date AND < Period_End_Date) per site.

    WeatherStation is the ICAO ID lookup column present on the Input table.
    Site_Name is carried through as the output key so merge_weather can join
    back to the billing DataFrame correctly.

    Returns a DataFrame with columns:
        Site_Name, Period Start Date, HDD_sigma, CDD_sigma
    One row per unique (Site_Name, Period Start Date) combination.
    Periods with no daily coverage produce NaN for both columns.
    """
    period_keys = (
        billing_df[["Site_Name", "WeatherStation", "Period_Start_Date", "Period_End_Date"]]
        .drop_duplicates()
        .dropna(subset=["Site_Name", "WeatherStation", "Period_Start_Date", "Period_End_Date"])
    )

    if len(period_keys) == 0 or len(daily_df) == 0:
        return pd.DataFrame(columns=["Site_Name", "Period Start Date",
                                     "HDD_sigma", "CDD_sigma"])

    agg_rows = []
    for _, pk in period_keys.iterrows():
        site    = pk["Site_Name"]
        station = pk["WeatherStation"]
        p_start = pd.to_datetime(pk["Period_Start_Date"])
        p_end   = pd.to_datetime(pk["Period_End_Date"])
        mask    = (
            (daily_df["Icao Id"] == station)
            & (daily_df["Date Valid Std"] >= p_start)
            & (daily_df["Date Valid Std"] <  p_end)
        )
        subset  = daily_df[mask]
        agg_rows.append({
            "Site_Name":         site,
            "Period Start Date": p_start,
            "HDD_sigma":         subset["Hdd Lt 65 F"].sum() if len(subset) > 0 else np.nan,
            "CDD_sigma":         subset["Cdd Gt 65 F"].sum() if len(subset) > 0 else np.nan,
        })

    return pd.DataFrame(agg_rows)


def merge_weather(billing_df: pd.DataFrame,
                  weather_df: pd.DataFrame) -> pd.DataFrame:
    """
    Merge Sigma-sourced HDD/CDD into the billing DataFrame.

    Joins on (Site_Name, Period_Start_Date). The weather_df produced by
    aggregate_weather_to_periods is already keyed on Site_Name (resolved via
    WeatherStation → Icao Id), so no site name translation is needed here.

    Resolution order per row:
      1. Sigma value (HDD_sigma / CDD_sigma) — used when non-null.
      2. CSV value  (HDD / CDD columns from input) — fallback when Sigma misses.
      3. NaN — if neither source has a value; the NaN warning in preprocess()
               will surface these downstream.

    Adds a 'Weather Source' column: "Sigma", "CSV", or "No Data".
    """
    df = billing_df.copy()

    # Normalise join keys to the same type before merging.
    weather_df = weather_df.copy()
    weather_df["Period Start Date"] = pd.to_datetime(
        weather_df["Period Start Date"], errors="coerce", utc=False
    )

    df["_join_start"] = pd.to_datetime(
        df["Period_Start_Date"], errors="coerce", utc=False
    )

    merged = df.merge(
        weather_df.rename(columns={"Period Start Date": "_join_start",
                                   "Site_Name": "_weather_site"}),
        left_on=["Site_Name", "_join_start"],
        right_on=["_weather_site", "_join_start"],
        how="left",
    ).drop(columns=["_weather_site"], errors="ignore")

    # Preserve CSV HDD/CDD values before overwriting so they can serve as
    # fallback. Rename originals to avoid column collision.
    for col in ["HDD", "CDD"]:
        if col in merged.columns:
            merged[f"{col}_csv"] = merged[col]
        else:
            merged[f"{col}_csv"] = np.nan

    sigma_col = {"HDD": "HDD_sigma", "CDD": "CDD_sigma"}
    for col, sig_col in sigma_col.items():
        if sig_col in merged.columns:
            merged[col] = np.where(
                merged[sig_col].notna(), merged[sig_col], merged[f"{col}_csv"]
            )
        else:
            merged[col] = merged[f"{col}_csv"]

    # Tag each row with its weather source for auditability.
    def _source(row):
        if row.get("HDD_sigma") is not None and not (
            isinstance(row.get("HDD_sigma"), float)
            and np.isnan(row.get("HDD_sigma"))
        ):
            return "Sigma"
        if not (isinstance(row.get("HDD_csv"), float)
                and np.isnan(row.get("HDD_csv", np.nan))):
            return "CSV"
        return "No Data"

    merged["Weather Source"] = merged.apply(_source, axis=1)

    sigma_count = (merged["Weather Source"] == "Sigma").sum()
    csv_count   = (merged["Weather Source"] == "CSV").sum()
    no_count    = (merged["Weather Source"] == "No Data").sum()
    print(f"[INFO] Weather resolution — Sigma: {sigma_count}, "
          f"CSV fallback: {csv_count}, No data: {no_count}")
    if no_count > 0:
        print(f"[WARNING] {no_count} row(s) have no HDD/CDD from either "
              f"source and will be treated as NaN.")

    merged = merged.drop(
        columns=[c for c in ["HDD_sigma", "CDD_sigma", "HDD_csv",
                             "CDD_csv", "_join_start"] if c in merged.columns]
    )
    return merged


# ── Sigma entry point ─────────────────────────────────────────────────────────

def _sigma_main():
    if WEATHER_SOURCE == "csv":
        _raw     = sigma.get_element('Uploaded File')  # Raw upload; bypasses Sigma weather join
        input_df = _raw.to_pandas(block=False).result()
        results  = run_analysis(input_df)
    else:
        _raw     = sigma.get_element('Input')  # Must be a string literal (Sigma requirement)
        assert 'Input' == SIGMA_INPUT_ELEMENT, \
            f"SIGMA_INPUT_ELEMENT ('{SIGMA_INPUT_ELEMENT}') does not match the literal in get_element(). Update both together."
        input_df = _raw.to_pandas(block=False).result()

        proc_df, df_original, has_locked = preprocess(input_df)
        daily_weather_df = fetch_sigma_weather()
        weather_df       = aggregate_weather_to_periods(daily_weather_df, proc_df)
        proc_df          = merge_weather(proc_df, weather_df)
        results          = run_analysis(proc_df, already_preprocessed=True,
                                        df_original=df_original,
                                        has_locked=has_locked)

    sigma.output('individual_models',   results['individual_models'])
    sigma.output('aggregated_models',   results['aggregated_models'])
    sigma.output('baseline_bills',      results['baseline_bills'])
    sigma.output('reporting_bills',     results['reporting_bills'])
    sigma.output('outliers',            results['outliers'])
    sigma.output('meter_weights',       results['meter_weights'])
    sigma.output('input_with_baseline', results['input_with_baseline'])


# ── Local entry point ─────────────────────────────────────────────────────────

def _local_main():
    import tkinter as tk
    from tkinter import filedialog
    root = tk.Tk(); root.withdraw(); root.attributes("-topmost", True)
    path = filedialog.askopenfilename(
        title="Select billing CSV", filetypes=[("CSV files", "*.csv"), ("All files", "*.*")])
    root.destroy()
    if not path:
        print("No file selected."); return

    results  = run_analysis(pd.read_csv(path))
    out_path = path.replace(".csv", "_results.xlsx")
    with pd.ExcelWriter(out_path, engine="openpyxl") as writer:
        for name, df_out in results.items():
            df_out.to_excel(writer, sheet_name=name[:31], index=False)
    print(f"Results written to {out_path}")


if __name__ == "__main__":
    _local_main()
else:
    _sigma_main()
