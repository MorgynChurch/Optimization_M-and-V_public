def build_reporting_rows(res, site, meter_num, service_type, model_passes=None, savings_status=None):
    rows  = []
    model = res["model"]
    is_gas = _is_gas(service_type)

    for bills, status_label in [(res["clean_reporting"], "Used in Savings"),
                                 (res["rep_outliers"],    None)]:
        if len(bills) == 0:
            continue
        X    = bills[["HDD"]].values if is_gas else bills[["HDD", "CDD"]].values
        pred = model.predict(X)
        for i, (_, r) in enumerate(bills.iterrows()):
            row  = build_bill_row(r, site, meter_num, service_type, "Reporting",
                                  status_label or f"Excluded: {r.get('Outlier_Reason', 'Outlier')}")
            cons    = float(r["Consumption"])
            charges = float(r.get("Total_Charges", r.get("Total Charges", 0)))
            rate    = (charges / cons) if cons > 0 else 0.0
            row.update({
                "Predicted Consumption": round(float(pred[i]), 2),
                "Avoided Usage":         round(float(pred[i]) - cons, 2),
                "Pct Avoided":           round((float(pred[i]) - cons) / float(pred[i]) * 100, 2)
                                          if pred[i] != 0 else 0.0,
                "Bill Avoided Cost":     round((float(pred[i]) - cons) * rate, 2),
                "Model Passes Quality":  model_passes,
                "Savings Status":        savings_status,
                "Reporting Count":       res.get("reporting_count"),
                "R2":                    res.get("r2"),
                "CV-RMSE":               res.get("cvrmse"),
                "Weather Coverage (%)": res.get("wc_overall"),
                "Passes R2":             res.get("passes_r2"),
                "Passes CV-RMSE":        res.get("passes_cvrmse"),
                "Passes Weather Coverage": res.get("passes_wc"),
            })
            rows.append(row)
    return rows


