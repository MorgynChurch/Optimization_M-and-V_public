# ── Utilities ─────────────────────────────────────────────────────────────────

def _is_gas(service_type: str) -> bool:
    return "gas" in str(service_type).lower()


def _calc_cvrmse(actual: np.ndarray, predicted: np.ndarray) -> float:
    rmse = np.sqrt(mean_squared_error(actual, predicted))
    mean_a = np.mean(actual)
    return (rmse / mean_a * 100) if mean_a != 0 else 999.0


def _n_choose_k(n, k):
    if k > n:
        return 0
    k = min(k, n - k)
    r = 1
    for i in range(k):
        r = r * (n - i) // (i + 1)
    return r


def _random_combos(n, k, count):
    # Fixed seed per (n, k) ensures identical results across runs for the same input.
    rng = np.random.default_rng(seed=(n * 1000 + k))
    seen, attempts = set(), 0
    while len(seen) < count and attempts < count * 4:
        c = tuple(sorted(rng.choice(n, k, replace=False)))
        if c not in seen:
            seen.add(c)
            yield c
        attempts += 1


def _safe_df(rows, schema_key):
    df_out = pd.DataFrame(rows) if rows else pd.DataFrame(columns=SCHEMAS[schema_key])
    if schema_key == "outliers" and len(df_out.columns) > 0:
        df_out = df_out[[c for c in SCHEMAS["outliers"] if c in df_out.columns]]
    return df_out


# ── Preprocessing ─────────────────────────────────────────────────────────────

def preprocess(df: pd.DataFrame) -> tuple:
    """
    Normalise column names, parse dates/numerics, convert units.
    Returns (processed_df, df_original, has_locked_baseline).
    df_original retains original column name formatting for input_with_baseline output.
    """
    df = df.copy()
    df.columns = df.columns.str.strip()
    df_original = df.copy()

    df = df.rename(columns={c: c.replace(" ", "_") for c in df.columns})

    for col in ["Period_Start_Date", "Period_End_Date", "Commission_Date"]:
        if col in df.columns:
            parsed = pd.to_datetime(df[col], errors="coerce", utc=True)
            df[col] = parsed.dt.tz_convert(None)

    for col in ["HDD", "CDD", "Consumption"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    for col in ["HDD", "CDD"]:
        if col not in df.columns:
            if WEATHER_SOURCE == "sigma":
                print(f"[WARNING] '{col}' column not found in input. "
                      f"WEATHER_SOURCE is 'csv' — this will cause model fitting to fail.")
            else:
                print(f"[INFO] '{col}' column not present in input — "
                      f"will be sourced entirely from Sigma weather element.")
        else:
            n_nan = df[col].isna().sum()
            if n_nan > 0:
                print(f"[WARNING] {n_nan} NaN value(s) found in '{col}' after parsing. "
                      f"Affected rows will be excluded from model fitting.")

    if "Total_Charges" in df.columns:
        df["Total_Charges"] = pd.to_numeric(
            df["Total_Charges"].astype(str)
                .str.replace(r"[\$,]", "", regex=True).str.strip(),
            errors="coerce",
        )

    df = _convert_units(df)

    if "Selected_Baseline" in df.columns:
        df["Selected_Baseline"] = df["Selected_Baseline"].apply(
            lambda v: "1" if str(v).strip() in ("1", "1.0") else ""
        )

    has_locked = (
        "Selected_Baseline" in df.columns
        and (df["Selected_Baseline"] == "1").any()
    )

    return df, df_original, has_locked


def _convert_units(df: pd.DataFrame) -> pd.DataFrame:
    if "Consumption_Unit" not in df.columns:
        return df
    df = df.copy()
    for unit_raw, idx in df.groupby("Consumption_Unit").groups.items():
        factor = UNIT_CONVERSIONS.get(str(unit_raw).strip().lower())
        if factor and factor != 1.0:
            df.loc[idx, "Consumption"] *= factor
    return df


def infer_flags(df: pd.DataFrame) -> pd.DataFrame:
    if "Commission_Date" not in df.columns or df["Commission_Date"].isna().all():
        raise ValueError(
            "Commission Date column is required. Bills before this date are "
            "baseline; bills on/after are reporting."
        )
    df = df.copy()
    df["Baseline_Bill"]  = (df["Period_Start_Date"] < df["Commission_Date"]).astype(int)
    df["Reporting_Bill"] = (df["Period_Start_Date"] >= df["Commission_Date"]).astype(int)
    return df


# ── Outlier detection ─────────────────────────────────────────────────────────

def detect_baseline_outliers(bills: pd.DataFrame):
    if len(bills) < 2:
        return bills, pd.DataFrame()

    cons        = bills["Consumption"]
    outlier_idx, reasons = [], {}

    for i in bills[cons < 0].index:
        outlier_idx.append(i)
        reasons[i] = "Negative Consumption"

    pos = bills[cons >= 0]
    if len(pos) >= 4:
        q1, q3 = pos["Consumption"].quantile(0.25), pos["Consumption"].quantile(0.75)
        iqr    = q3 - q1
        lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
        for i, row in pos.iterrows():
            v = row["Consumption"]
            if v < lo:
                outlier_idx.append(i); reasons[i] = f"Too Low (< {lo:.0f})"
            elif v > hi:
                outlier_idx.append(i); reasons[i] = f"Too High (> {hi:.0f})"

    outlier_idx = list(set(outlier_idx))
    if not outlier_idx:
        return bills, pd.DataFrame()

    outliers = bills.loc[outlier_idx].copy()
    outliers["Outlier_Type"]   = "Baseline"
    outliers["Outlier_Reason"] = outliers.index.map(reasons)
    return bills.drop(index=outlier_idx), outliers


def detect_reporting_outliers(model, bills: pd.DataFrame, is_gas: bool):
    if len(bills) < 1:
        return bills, pd.DataFrame()
    X    = bills[["HDD"]].values if is_gas else bills[["HDD", "CDD"]].values
    pred = model.predict(X)
    pct  = np.where(pred != 0, (pred - bills["Consumption"].values) / pred * 100, 0)
    mask = (pct < REPORTING_OUTLIER_LOW) | (pct > REPORTING_OUTLIER_HIGH)
    outliers, clean = bills[mask].copy(), bills[~mask].copy()
    if len(outliers) > 0:
        outliers["Outlier_Type"]   = "Reporting"
        outliers["Outlier_Reason"] = [
            f"% Avoided {p:.1f}% ({'< ' + str(REPORTING_OUTLIER_LOW) + '%' if p < REPORTING_OUTLIER_LOW else '> ' + str(REPORTING_OUTLIER_HIGH) + '%'})" for p in pct[mask]
        ]
        outliers["Pct_Avoided"] = pct[mask]
    return clean, outliers


# ── Model fitting ─────────────────────────────────────────────────────────────

def fit_model(baseline: pd.DataFrame, is_gas: bool):
    X    = baseline[["HDD"]].values if is_gas else baseline[["HDD", "CDD"]].values
    y    = baseline["Consumption"].values
    m    = LinearRegression().fit(X, y)
    pred = m.predict(X)
    return m, r2_score(y, pred), _calc_cvrmse(y, pred)


def _weather_coverage(selected: pd.DataFrame, all_baseline: pd.DataFrame):
    def cov(col):
        full_r = all_baseline[col].max() - all_baseline[col].min()
        sel_r  = selected[col].max()    - selected[col].min()
        return (sel_r / full_r * 100) if full_r > 0 else 100.0
    hdd_c, cdd_c = cov("HDD"), cov("CDD")
    return (hdd_c + cdd_c) / 2, hdd_c, cdd_c


def _seasonal_ok(selected: pd.DataFrame, min_per_q: int,
                 balance_threshold: float = SEASONAL_BALANCE_THRESHOLD) -> bool:
    counts = selected["Period_Start_Date"].dt.quarter.value_counts()
    if not all(counts.get(q, 0) >= min_per_q for q in [1, 2, 3, 4]):
        return False
    # Hard balance gate: no quarter may have less than balance_threshold
    # of the mean quarter count. Prevents skewed baselines like [1,4,2,1].
    # Gas sites use GAS_SEASONAL_BALANCE_THRESHOLD (0.50) because heating-only
    # meters structurally have thin Q3 after zero-consumption summer bills
    # are removed as outliers.
    vals = [counts.get(q, 0) for q in [1, 2, 3, 4]]
    mean_count = sum(vals) / 4
    return mean_count == 0 or (min(vals) / mean_count) >= balance_threshold


def _is_new_site(baseline_bills) -> bool:
    """Returns True when baseline spans < 12 months."""
    if len(baseline_bills) == 0:
        return True
    dates = pd.to_datetime(baseline_bills["Period_Start_Date"], errors="coerce").dropna()
    return len(dates) == 0 or (dates.max() - dates.min()).days < 365


def _combo_score(r2, temporal_cv, pct_avoided, reporting_count, max_reporting, is_new):
    """
    Weighted composite score used to rank baseline combinations. Higher = better.
    Normal site : 0.45·R² + 0.30·CV_inv + 0.15·pct + 0.10·rep_frac
    New site    : 0.75·R²               + 0.15·pct + 0.10·rep_frac  (CV omitted)
    """
    r2_n  = max(0.0, min(1.0, r2))
    cv_n  = max(0.0, 1.0 - temporal_cv / 100.0)
    pct_n = (max(-10.0, min(40.0, pct_avoided)) + 10.0) / 50.0
    rep_n = (reporting_count / max_reporting) if max_reporting > 0 else 0.0
    if is_new:
        return 0.75 * r2_n + 0.15 * pct_n + 0.10 * rep_n
    return 0.45 * r2_n + 0.30 * cv_n + 0.15 * pct_n + 0.10 * rep_n


# ── Optimizer ─────────────────────────────────────────────────────────────────

def eval_combo(idx_list, baseline_pool, reporting_bills, all_baseline,
               r2_thresh, is_gas):
    selected          = baseline_pool.iloc[list(idx_list)]
    model, r2, cvrmse = fit_model(selected, is_gas)
    wc, hdd_c, cdd_c  = _weather_coverage(selected, all_baseline)
    qcounts           = selected["Period_Start_Date"].dt.quarter.value_counts()
    temporal_cv       = (qcounts.std() / qcounts.mean() * 100) if len(qcounts) > 1 else 0.0

    clean_rep, rep_outliers = detect_reporting_outliers(model, reporting_bills, is_gas)
    if len(clean_rep) > 0:
        X_rep    = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep = model.predict(X_rep)
        avoided  = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd  = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd, pred_rep = 0.0, 0.0, np.array([])

    hdd_coef = model.coef_[0]
    cdd_coef = model.coef_[1] if not is_gas else 0.0
    equation = (f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD"
                + (f" + {cdd_coef:.4f}*CDD" if not is_gas else ""))

    return {
        "model": model, "selected": selected,
        "clean_reporting": clean_rep, "rep_outliers": rep_outliers, "predicted_rep": pred_rep,
        "equation": equation, "intercept": model.intercept_,
        "hdd_coef": hdd_coef, "cdd_coef": cdd_coef,
        "r2": r2, "cvrmse": cvrmse,
        "wc_overall": wc, "wc_hdd": hdd_c, "wc_cdd": cdd_c, "temporal_cv": temporal_cv,
        "passes_r2": round(r2, 2) >= r2_thresh, "passes_cvrmse": round(cvrmse, 2) <= CVRMSE_THRESHOLD,
        "passes_wc": round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        "passes_all": round(r2, 2) >= r2_thresh and round(cvrmse, 2) <= CVRMSE_THRESHOLD and round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        "total_avoided": avoided, "pct_avoided": pct_avd, "reporting_count": len(clean_rep),
        **{f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]},
    }


def optimize(site_id, service_type, bills, baseline_count, r2_thresh):
    is_gas        = _is_gas(service_type)
    raw_baseline  = bills[bills["Baseline_Bill"] == 1].copy()
    reporting_all = bills[bills["Reporting_Bill"] == 1].copy()

    if len(raw_baseline) == 0:
        return None, [], []

    clean_baseline, bl_outliers = detect_baseline_outliers(raw_baseline)

    # ── Drop baseline bills with missing weather data ─────────────────────────
    # NaN HDD/CDD will crash LinearRegression. Record dropped rows in bl_outliers
    # so they remain visible in the outliers output table.
    weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    nan_weather_bl = clean_baseline[clean_baseline[weather_cols].isna().any(axis=1)].copy()
    if len(nan_weather_bl) > 0:
        nan_weather_bl["Outlier_Type"]   = "Baseline"
        nan_weather_bl["Outlier_Reason"] = "Missing weather data (HDD/CDD NaN)"
        bl_outliers = pd.concat([bl_outliers, nan_weather_bl], ignore_index=True)
        clean_baseline = clean_baseline.drop(index=nan_weather_bl.index)
    # ─────────────────────────────────────────────────────────────────────────

    if len(clean_baseline) < baseline_count:
        return None, list(bl_outliers.to_dict("records")), []

    # ── Drop reporting bills with missing weather data ────────────────────────
    # Can't generate predictions without HDD/CDD; dropping here prevents a
    # crash in detect_reporting_outliers() and eval_combo().
    rep_weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    reporting_all = reporting_all.dropna(subset=rep_weather_cols)
    # ─────────────────────────────────────────────────────────────────────────

    clean_baseline["Period_Start_Date"] = pd.to_datetime(clean_baseline["Period_Start_Date"])
    is_new     = _is_new_site(clean_baseline)
    cv_relaxed = False

    bal_thresh = GAS_SEASONAL_BALANCE_THRESHOLD if is_gas else SEASONAL_BALANCE_THRESHOLD

    def _run_strategy(min_per_q):
        nonlocal cv_relaxed
        n, total = len(clean_baseline), _n_choose_k(len(clean_baseline), baseline_count)
        combos   = (combinations(range(n), baseline_count)
                    if total <= EXHAUSTIVE_LIMIT
                    else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3))

        valid = []
        for c in combos:
            sel = clean_baseline.iloc[list(c)]
            if not _seasonal_ok(sel, min_per_q, bal_thresh):
                continue
            wc, _, _ = _weather_coverage(sel, clean_baseline)
            if wc < WEATHER_COVERAGE_THRESHOLD:
                continue
            if not is_new:
                qc = sel["Period_Start_Date"].dt.quarter.value_counts()
                if len(qc) > 1 and qc.std() / qc.mean() * 100 > TEMPORAL_CV_CEILING:
                    continue
            valid.append(c)
            if len(valid) >= MAX_COMBINATIONS:
                break

        # Relax CV ceiling if it filtered everything out
        if not valid and not is_new:
            cv_relaxed = True
            combos2 = (combinations(range(n), baseline_count)
                       if total <= EXHAUSTIVE_LIMIT
                       else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3))
            for c in combos2:
                sel = clean_baseline.iloc[list(c)]
                if not _seasonal_ok(sel, min_per_q, bal_thresh):
                    continue
                wc, _, _ = _weather_coverage(sel, clean_baseline)
                if wc >= WEATHER_COVERAGE_THRESHOLD:
                    valid.append(c)
                if len(valid) >= MAX_COMBINATIONS:
                    break

        if not valid:
            return None

        best_pass_pos,  best_pass_nonpos,  best_fail     = None, None, None
        best_pass_pos_s, best_pass_nonpos_s, best_fail_s = -np.inf, -np.inf, -np.inf
        max_rep = len(reporting_all)

        for c in valid:
            res   = eval_combo(c, clean_baseline, reporting_all, clean_baseline,
                               r2_thresh, is_gas)
            score = _combo_score(res["r2"], res["temporal_cv"], res["pct_avoided"],
                                 res["reporting_count"], max_rep, is_new)
            if res["passes_all"]:
                if res["total_avoided"] > 0:
                    if score > best_pass_pos_s:
                        best_pass_pos_s, best_pass_pos = score, res
                else:
                    if score > best_pass_nonpos_s:
                        best_pass_nonpos_s, best_pass_nonpos = score, res
            else:
                if score > best_fail_s:
                    best_fail_s, best_fail = score, res

        # Prefer positive-savings passing models. If a higher-scoring non-positive
        # passing model was available, record it in the result for transparency.
        if best_pass_pos is not None:
            if (best_pass_nonpos is not None
                    and best_pass_nonpos_s > best_pass_pos_s):
                best_pass_pos["_skipped_nonpos_r2"]   = round(best_pass_nonpos["r2"], 4)
                best_pass_pos["_skipped_nonpos_score"] = round(best_pass_nonpos_s, 4)
            return best_pass_pos

        return best_pass_nonpos or best_fail

    result   = _run_strategy(PREFERRED_MIN_PER_QUARTER)
    strategy = f"Optimal (≥{PREFERRED_MIN_PER_QUARTER} bills per quarter)"
    if result is None:
        result   = _run_strategy(MINIMUM_MIN_PER_QUARTER)
        strategy = f"Acceptable (≥{MINIMUM_MIN_PER_QUARTER} bill per quarter)"

    if result is None:
        return None, list(bl_outliers.to_dict("records")), []

    result.update({
        "seasonal_strategy": strategy,
        "is_new_site":        is_new,
        "cv_ceiling_relaxed": cv_relaxed,
        "bl_outliers_df":     bl_outliers,
        "reporting_all":      reporting_all,
    })
    return result, list(bl_outliers.to_dict("records")), list(result["rep_outliers"].to_dict("records"))


def optimize_from_locked(site_id, service_type, bills, r2_thresh):
    """Reconstruct a model from pre-selected baseline bills (Selected_Baseline == '1')."""
    is_gas         = _is_gas(service_type)
    baseline_bills = bills[bills["Selected_Baseline"].apply(
        lambda v: str(v).strip() in ("1", "1.0"))].copy()
    reporting_bills = bills[bills["Reporting_Bill"] == 1].copy()

    if len(baseline_bills) == 0:
        return None, [], []

    baseline_bills["Period_Start_Date"] = pd.to_datetime(
        baseline_bills["Period_Start_Date"], errors="coerce")

    # ── Drop locked baseline bills with missing weather data ──────────────────
    # NaN HDD/CDD will crash LinearRegression.
    weather_cols   = ["HDD"] if is_gas else ["HDD", "CDD"]
    nan_weather_bl = baseline_bills[baseline_bills[weather_cols].isna().any(axis=1)].copy()
    if len(nan_weather_bl) > 0:
        nan_weather_bl["Outlier_Type"]   = "Baseline"
        nan_weather_bl["Outlier_Reason"] = "Missing weather data (HDD/CDD NaN)"
        baseline_bills = baseline_bills.drop(index=nan_weather_bl.index)
        print(f"[WARNING] {len(nan_weather_bl)} locked baseline bill(s) for "
              f"{site_id} dropped due to missing weather data.")
    # ─────────────────────────────────────────────────────────────────────────

    if len(baseline_bills) == 0:
        return None, list(nan_weather_bl.to_dict("records")), []

    # ── Drop reporting bills with missing weather data ────────────────────────
    rep_weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    reporting_bills  = reporting_bills.dropna(subset=rep_weather_cols)
    # ─────────────────────────────────────────────────────────────────────────

    model, r2, cvrmse = fit_model(baseline_bills, is_gas)
    wc, hdd_c, cdd_c  = _weather_coverage(baseline_bills, baseline_bills)
    qcounts           = baseline_bills["Period_Start_Date"].dt.quarter.value_counts()
    temporal_cv       = (qcounts.std() / qcounts.mean() * 100) if len(qcounts) > 1 else 0.0

    clean_rep, rep_outliers = detect_reporting_outliers(model, reporting_bills, is_gas)
    if len(clean_rep) > 0:
        X_rep    = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep = model.predict(X_rep)
        avoided  = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd  = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd, pred_rep = 0.0, 0.0, np.array([])

    hdd_coef = model.coef_[0]
    cdd_coef = model.coef_[1] if not is_gas else 0.0
    equation = (f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD"
                + (f" + {cdd_coef:.4f}*CDD" if not is_gas else ""))
    is_new   = _is_new_site(baseline_bills)

    bl_outliers_df = nan_weather_bl if len(nan_weather_bl) > 0 else pd.DataFrame()

    result = {
        "model": model, "selected": baseline_bills,
        "clean_reporting": clean_rep, "rep_outliers": rep_outliers, "predicted_rep": pred_rep,
        "equation": equation, "intercept": model.intercept_,
        "hdd_coef": hdd_coef, "cdd_coef": cdd_coef,
        "r2": r2, "cvrmse": cvrmse,
        "wc_overall": wc, "wc_hdd": hdd_c, "wc_cdd": cdd_c, "temporal_cv": temporal_cv,
        "passes_r2": round(r2, 2) >= r2_thresh, "passes_cvrmse": round(cvrmse, 2) <= CVRMSE_THRESHOLD,
        "passes_wc": round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        "passes_all": round(r2, 2) >= r2_thresh and round(cvrmse, 2) <= CVRMSE_THRESHOLD and round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        "total_avoided": avoided, "pct_avoided": pct_avd, "reporting_count": len(clean_rep),
        "seasonal_strategy": "Locked (pre-selected)",
        "is_new_site": is_new,
        "cv_ceiling_relaxed": not is_new and temporal_cv > TEMPORAL_CV_CEILING,
        "reporting_all": reporting_bills, "bl_outliers_df": bl_outliers_df,
        **{f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]},
    }
    bl_out  = list(nan_weather_bl.to_dict("records")) if len(nan_weather_bl) > 0 else []
    rep_out = list(rep_outliers.to_dict("records"))   if len(rep_outliers)  > 0 else []
    return result, bl_out, rep_out


