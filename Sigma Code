def consolidate_cost_only_bills(df: pd.DataFrame) -> tuple:
    """
    Consolidate PUBLISHER + PASS_THROUGH "cost only" bill pairs, and flag
    any site that has more than one PUBLISHER bill for the same billing
    period (such sites are excluded from analysis until corrected).

    Rule:
      - Consumption comes from the PUBLISHER row only (never summed —
        PASS_THROUGH restates usage, it doesn't add to it).
      - Total Charges is the sum of PUBLISHER + PASS_THROUGH for the period.
      - A period group is identified by
        (Site_Name, Meter_Number, Period_Start_Date, Period_End_Date, Service_Type).
      - A site is FLAGGED (and all its rows dropped) if any of its period
        groups has either:
          * more than one PUBLISHER bill, or
          * one or more PASS_THROUGH bills with no matching PUBLISHER bill
            (orphan passthrough — can't be consolidated against anything).
        Pass-through *counts* beyond presence are not otherwise validated.

    No-op if the classification column isn't present.

    Returns:
        (consolidated_df, flagged_sites)
    """
    if COST_ONLY_CLASSIFICATION_COL not in df.columns:
        return df, set()

    df = df.copy()
    group_cols = ["Site_Name", "Meter_Number", "Period_Start_Date",
                  "Period_End_Date", "Service_Type"]

    # Separate Publisher and Passthrough (mirrors FileProcessor.py)
    publisher  = df[df[COST_ONLY_CLASSIFICATION_COL] == PUBLISHER_LABEL].copy()
    passthrough = df[df[COST_ONLY_CLASSIFICATION_COL] == PASS_THROUGH_LABEL].copy()
    # Anything not classified as either is left untouched and re-attached at the end.
    other = df[~df[COST_ONLY_CLASSIFICATION_COL].isin([PUBLISHER_LABEL, PASS_THROUGH_LABEL])].copy()

    # ── Flagging ────────────────────────────────────────────────────────────
    # Per-group publisher/passthrough counts, so we can catch two problems:
    #   (1) >1 PUBLISHER bill in a group (can't pick which usage is real)
    #   (2) PASS_THROUGH present but 0 PUBLISHER in a group (orphan — nothing
    #       to consolidate against)
    pub_counts = publisher.groupby(group_cols).size().reset_index(name="pub_count")
    pas_counts = passthrough.groupby(group_cols).size().reset_index(name="pas_count")
    grp = pub_counts.merge(pas_counts, on=group_cols, how="outer").fillna(
        {"pub_count": 0, "pas_count": 0})

    multi_pub_sites = set(
        grp.loc[grp["pub_count"] > 1, "Site_Name"].unique()
    )
    orphan_pas_sites = set(
        grp.loc[(grp["pas_count"] > 0) & (grp["pub_count"] == 0), "Site_Name"].unique()
    )
    flagged_sites = multi_pub_sites | orphan_pas_sites

    # Drop everything belonging to a flagged site, across all three buckets.
    publisher   = publisher[~publisher["Site_Name"].isin(flagged_sites)]
    passthrough = passthrough[~passthrough["Site_Name"].isin(flagged_sites)]
    other       = other[~other["Site_Name"].isin(flagged_sites)]

    # ── Consolidate charges ─────────────────────────────────────────────────
    # Sum Total_Charges per period group across BOTH classifications.
    charges = (
        pd.concat([publisher, passthrough])
          .groupby(group_cols, dropna=False)["Total_Charges"]
          .sum()                       # all-NaN group -> 0 (pandas default)
          .reset_index()
    )

    # Publisher rows carry Consumption + all other fields; one row per group now.
    consolidated = publisher.drop(columns=["Total_Charges"]).merge(
        charges, on=group_cols, how="left"
    )

    # Re-attach unclassified rows untouched.
    result = pd.concat([consolidated, other], ignore_index=True)

    return result, flagged_sites


def infer_flags(df: pd.DataFrame) -> pd.DataFrame:
    if "Commission_Date" not in df.columns or df["Commission_Date"].isna().all():
        raise ValueError(
            "Commission Date column is required. Bills before this date are "
            "baseline; bills on/after are reporting."
        )
    df = df.copy()
    df["Baseline_Bill"]  = (df["Period_Start_Date"] < df["Commission_Date"]).astype(int)
    df["Reporting_Bill"] = (df["Period_Start_Date"] >= df["Commission_Date"]).astype(int)
    return df


# ── Outlier detection ─────────────────────────────────────────────────────────

def detect_baseline_outliers(bills: pd.DataFrame):
    if len(bills) < 2:
        return bills, pd.DataFrame()

    cons        = bills["Consumption"]
    outlier_idx, reasons = [], {}

    for i in bills[cons < 0].index:
        outlier_idx.append(i)
        reasons[i] = "Negative Consumption"

    pos = bills[cons >= 0]
    if len(pos) >= 4:
        q1, q3 = pos["Consumption"].quantile(0.25), pos["Consumption"].quantile(0.75)
        iqr    = q3 - q1
        lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
        for i, row in pos.iterrows():
            v = row["Consumption"]
            if v < lo:
                outlier_idx.append(i); reasons[i] = f"Too Low (< {lo:.0f})"
            elif v > hi:
                outlier_idx.append(i); reasons[i] = f"Too High (> {hi:.0f})"

    outlier_idx = list(set(outlier_idx))
    if not outlier_idx:
        return bills, pd.DataFrame()

    outliers = bills.loc[outlier_idx].copy()
    outliers["Outlier_Type"]   = "Baseline"
    outliers["Outlier_Reason"] = outliers.index.map(reasons)
    return bills.drop(index=outlier_idx), outliers


def detect_reporting_outliers(model, bills: pd.DataFrame, is_gas: bool):
    if len(bills) < 1:
        return bills, pd.DataFrame()
    X    = bills[["HDD"]].values if is_gas else bills[["HDD", "CDD"]].values
    pred = model.predict(X)
    pct  = np.where(pred != 0, (pred - bills["Consumption"].values) / pred * 100, 0)
    mask = (pct < REPORTING_OUTLIER_LOW) | (pct > REPORTING_OUTLIER_HIGH)
    outliers, clean = bills[mask].copy(), bills[~mask].copy()
    if len(outliers) > 0:
        outliers["Outlier_Type"]   = "Reporting"
        outliers["Outlier_Reason"] = [
            f"% Avoided {p:.1f}% ({'< ' + str(REPORTING_OUTLIER_LOW) + '%' if p < REPORTING_OUTLIER_LOW else '> ' + str(REPORTING_OUTLIER_HIGH) + '%'})" for p in pct[mask]
        ]
        outliers["Pct_Avoided"] = pct[mask]
    return clean, outliers


# ── Model fitting ─────────────────────────────────────────────────────────────

def fit_model(baseline: pd.DataFrame, is_gas: bool):
    X    = baseline[["HDD"]].values if is_gas else baseline[["HDD", "CDD"]].values
    y    = baseline["Consumption"].values
    m    = LinearRegression().fit(X, y)
    pred = m.predict(X)
    return m, r2_score(y, pred), _calc_cvrmse(y, pred)


def _weather_coverage(selected: pd.DataFrame, all_baseline: pd.DataFrame,
                      is_gas: bool = False):
    """
    How much of the baseline's observed weather range does the selection span?

    Returns (overall, hdd_coverage, cdd_coverage).

    is_gas controls what "overall" means, and it matters:
      A gas model is fitted on HDD ALONE — fit_model() passes only [["HDD"]] for
      gas, and the equation carries no CDD term. Averaging CDD coverage into the
      headline number therefore blends in a dimension the model never uses, and
      it does so in the direction that hides problems. URB027/2066266 spans just
      60.0% of its HDD range — the only range its model will ever be asked to
      predict over — but scored 100.0% on CDD, averaging to 80.0%: past the 75%
      gate, rated "Excellent". Same at URB032 (66.0% HDD -> 83.0% overall) and
      URB018 (66.8% -> 82.7%).

      HDD and CDD coverage are both still reported for gas — they're useful to
      see — but only HDD drives the gate.
    """
    def cov(col):
        full_r = all_baseline[col].max() - all_baseline[col].min()
        sel_r  = selected[col].max()    - selected[col].min()
        return (sel_r / full_r * 100) if full_r > 0 else 100.0
    hdd_c, cdd_c = cov("HDD"), cov("CDD")
    overall = hdd_c if is_gas else (hdd_c + cdd_c) / 2
    return overall, hdd_c, cdd_c


def _seasonal_balance(selected: pd.DataFrame) -> float:
    """
    The number behind "Passes Seasonal Balance": the WEAKEST quarter's bill count
    as a fraction of the average quarter. 1.00 = perfectly even, 0.00 = a season
    with no bills at all.

    This is the metric _seasonal_ok() gates on, exposed so the verdict can be
    checked rather than taken on faith — every other gate in the model tables
    shows its value beside its flag, and this one didn't.

    NOT the same as Temporal CV, which also summarises the quarterly counts but
    answers a different question. Temporal CV is std/mean: symmetric dispersion,
    penalising a quarter with too MANY bills exactly as hard as one with too few.
    Seasonal balance is min/mean: it only cares about the thinnest season,
    because that is the one the model barely knows. Quarters [2,4,4,4] score a
    comfortable 28.6 on Temporal CV (under the 40 ceiling) while scoring 0.57
    here — a real gap in spring that dispersion averages away. They also run in
    opposite directions: 0 is perfect for Temporal CV, 1.00 is perfect here.
    """
    counts = selected["Period_Start_Date"].dt.quarter.value_counts()
    vals   = [counts.get(q, 0) for q in [1, 2, 3, 4]]
    mean_c = sum(vals) / 4
    return 0.0 if mean_c == 0 else min(vals) / mean_c


def _quarterly_spread(selected: pd.DataFrame, idle_q: int = None) -> float:
    """
    Standard deviation / mean of the quarterly bill counts, x100. 0 = perfectly
    even. Guards SHAPE — Seasonal Balance only looks at the weakest quarter and
    scores [2,2,2,6] and [2,3,3,4] identically at 0.67; this separates them
    (66.7 vs 27.2).

    idle_q is excluded, for the same reason _seasonal_ok excludes it from the
    balance calculation: if a quarter is exempt from the bill-count floor because
    its bills carry no slope information, it must not drag the shape metric
    either. Without this the two gates contradict each other — the exemption
    permits gas [2,2,1,3], then spread scores it 40.8 against a 40 ceiling and
    rejects it by 0.8. Excluding the idle quarter scores the same baseline on its
    graded quarters [2,2,3] -> 24.7, which passes on its merits.

    (That contradiction was live but invisible: the ceiling is skipped entirely
    for new sites, so [2,2,1,3] existed at URB009/URB026/URB028/URB034 — all new
    — and was silently impossible everywhere else.)
    """
    counts = selected["Period_Start_Date"].dt.quarter.value_counts()
    graded = [counts.get(q, 0) for q in [1, 2, 3, 4] if q != idle_q]
    ser    = pd.Series(graded, dtype=float)
    if len(ser) < 2 or ser.mean() == 0:
        return 0.0
    return float(ser.std() / ser.mean() * 100)


def _idle_quarter(pool: pd.DataFrame, is_gas: bool):
    """
    For a GAS baseline, the quarter whose bills carry no slope information.

    A gas model is fitted on HDD alone. Bills from the site's warmest quarter sit
    at HDD ~ 0 — they all share essentially the same x-value, so they pin the
    intercept and say nothing about the heating slope. Demanding the same bill
    density there as in winter is demanding redundant data, and on an 8-bill gas
    baseline that demand is fatal: 4 quarters x 2 bills = 8 exactly, so a flat
    minimum of 2 admits [2,2,2,2] and nothing else. Exempting the idle quarter is
    what makes [2,2,1,3] reachable.

    Returns None for electric. An electric model is fitted on HDD AND CDD, so
    every quarter is informative about one term or the other — there is no idle
    quarter to exempt.

    The quarter is DERIVED FROM THIS SITE'S OWN BILLS, never hardcoded. Calendar
    quarters do not map to seasons the same way everywhere: in this portfolio the
    warmest quarter is Q3 (mean HDD 7) and the COLDEST is Q4 (mean HDD 179, above
    even Q1's 163), because quarters are assigned by Period_Start_Date and a bill
    starting 12 Dec measures 12 Dec - 11 Jan. Hardcoding "Q3 is summer" would be
    wrong the first time this runs on a portfolio in another climate.

    Requires a real margin: the idle quarter must have a mean HDD below 25% of
    the next-lowest quarter's. Without that, a site whose quarters all carry
    similar HDD would have one arbitrarily exempted for winning a coin flip.
    """
    if not is_gas or "HDD" not in pool.columns:
        return None
    hdd = pool.groupby(pool["Period_Start_Date"].dt.quarter)["HDD"].mean()
    if len(hdd) < 4:
        return None
    order = hdd.sort_values()
    lowest, second = order.index[0], order.iloc[1]
    return int(lowest) if order.iloc[0] <= 0.25 * second else None


def _seasonal_ok(selected: pd.DataFrame, min_per_q: int,
                 balance_threshold: float = SEASONAL_BALANCE_THRESHOLD,
                 idle_q: int = None) -> bool:
    """
    Two independent checks, both required:

      1. min_per_q  — every quarter carries at least this many bills. Guards
                      against a season the model has barely seen.
      2. balance    — the weakest quarter is at least balance_threshold of the
                      mean quarter. Stated as a RATIO rather than an integer so
                      it scales: a locked baseline can be any size (24 bills, or
                      19), and "min >= 2" would be meaningless on 24 while
                      "min/mean >= 0.65" means min >= 4 there and min >= 2 on 12.

    Neither of these constrains the SHAPE above the minimum — [2,2,2,6] and
    [2,3,3,4] both score exactly 0.67 here. That job belongs to the Quarterly
    Spread ceiling in _run_strategy, which separates them (66.7 vs 27.2).

    idle_q, when set, is a quarter allowed one fewer bill and excluded from the
    balance calculation. See _idle_quarter.
    """
    counts = selected["Period_Start_Date"].dt.quarter.value_counts()

    for q in [1, 2, 3, 4]:
        floor = max(1, min_per_q - 1) if q == idle_q else min_per_q
        if counts.get(q, 0) < floor:
            return False

    # The idle quarter is dropped from the balance calculation rather than
    # counted at its relaxed floor. Leaving it in would drag the ratio down for a
    # thinness that was deliberately permitted — the gate would grant the
    # exemption with one hand and fail the baseline for using it with the other.
    graded = [q for q in [1, 2, 3, 4] if q != idle_q]
    vals   = [counts.get(q, 0) for q in graded]
    mean_count = sum(vals) / len(vals) if vals else 0
    return mean_count == 0 or (min(vals) / mean_count) >= balance_threshold


def _is_new_site(baseline_bills) -> bool:
    """Returns True when baseline spans < 12 months."""
    if len(baseline_bills) == 0:
        return True
    dates = pd.to_datetime(baseline_bills["Period_Start_Date"], errors="coerce").dropna()
    return len(dates) == 0 or (dates.max() - dates.min()).days < 365


def _combo_score(r2, temporal_cv, pct_avoided, reporting_count, max_reporting, is_new):
    """
    Weighted composite score used to rank baseline combinations. Higher = better.
    Normal site : 0.45·R² + 0.30·CV_inv + 0.15·pct + 0.10·rep_frac
    New site    : 0.75·R²               + 0.15·pct + 0.10·rep_frac  (CV omitted)
    """
    r2_n  = max(0.0, min(1.0, r2))
    cv_n  = max(0.0, 1.0 - temporal_cv / 100.0)
    pct_n = (max(-10.0, min(40.0, pct_avoided)) + 10.0) / 50.0
    rep_n = (reporting_count / max_reporting) if max_reporting > 0 else 0.0
    if is_new:
        return 0.75 * r2_n + 0.15 * pct_n + 0.10 * rep_n
    return 0.45 * r2_n + 0.30 * cv_n + 0.15 * pct_n + 0.10 * rep_n


# ── Optimizer ─────────────────────────────────────────────────────────────────

def eval_combo(idx_list, baseline_pool, reporting_bills, all_baseline,
               r2_thresh, is_gas):
    selected          = baseline_pool.iloc[list(idx_list)]
    model, r2, cvrmse = fit_model(selected, is_gas)
    wc, hdd_c, cdd_c  = _weather_coverage(selected, all_baseline, is_gas)
    qcounts           = selected["Period_Start_Date"].dt.quarter.value_counts()
    # Excludes the idle quarter, matching the gate and _seasonal_ok's balance
    # calculation. All three must agree, or the reported number explains a
    # verdict it didn't produce — and _combo_score ranks on this same value, so
    # a mismatch would also skew which baseline wins.
    temporal_cv       = _quarterly_spread(selected, _idle_quarter(all_baseline, is_gas))

    clean_rep, rep_outliers = detect_reporting_outliers(model, reporting_bills, is_gas)
    if len(clean_rep) > 0:
        X_rep    = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep = model.predict(X_rep)
        avoided  = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd  = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd, pred_rep = 0.0, 0.0, np.array([])

    hdd_coef = model.coef_[0]
    cdd_coef = model.coef_[1] if not is_gas else 0.0
    equation = (f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD"
                + (f" + {cdd_coef:.4f}*CDD" if not is_gas else ""))

    return {
        "model": model, "selected": selected,
        "clean_reporting": clean_rep, "rep_outliers": rep_outliers, "predicted_rep": pred_rep,
        "equation": equation, "intercept": model.intercept_,
        "hdd_coef": hdd_coef, "cdd_coef": cdd_coef,
        "r2": r2, "cvrmse": cvrmse,
        "wc_overall": wc, "wc_hdd": hdd_c, "wc_cdd": cdd_c, "temporal_cv": temporal_cv,
        "passes_r2": round(r2, 2) >= r2_thresh, "passes_cvrmse": round(cvrmse, 2) <= CVRMSE_THRESHOLD,
        "passes_wc": round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        # Stated explicitly rather than left implicit. On this path it is True by
        # construction — _run_strategy() pre-filters every combination through
        # _seasonal_ok() before it is ever scored, so a failing combination cannot
        # reach here. Reporting it anyway keeps "Passes Seasonal Balance" meaning
        # the same thing on the optimized and locked paths, instead of being a
        # column that only one path populates honestly.
        "passes_seasonal": _seasonal_ok(
            selected, PREFERRED_MIN_PER_QUARTER,
            GAS_SEASONAL_BALANCE_THRESHOLD if is_gas else SEASONAL_BALANCE_THRESHOLD,
            idle_q=_idle_quarter(all_baseline, is_gas)),
        "seasonal_balance": _seasonal_balance(selected),
        # passes_seasonal is folded in here as well as on the locked path. It used
        # to be a no-op on this path — _run_strategy() pre-filters every
        # combination through _seasonal_ok() before scoring, so anything reaching
        # eval_combo() satisfied it by construction. That stopped being true the
        # moment the most-recent-N rung was added: that rung does no filtering at
        # all, so its baseline can and usually does fail seasonal balance. Without
        # this, such a model could report Model Passes Quality = True purely on
        # R2/CV-RMSE and walk into the KPI tiles.
        "passes_all": (round(r2, 2) >= r2_thresh
                       and round(cvrmse, 2) <= CVRMSE_THRESHOLD
                       and round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD
                       and _seasonal_ok(selected, PREFERRED_MIN_PER_QUARTER,
                                        GAS_SEASONAL_BALANCE_THRESHOLD if is_gas
                                        else SEASONAL_BALANCE_THRESHOLD,
                                        idle_q=_idle_quarter(all_baseline, is_gas))),
        "total_avoided": avoided, "pct_avoided": pct_avd, "reporting_count": len(clean_rep),
        **{f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]},
    }


def optimize(site_id, service_type, bills, baseline_count, r2_thresh):
    """
    Returns (result_or_None, bl_outlier_records, rep_outlier_records, skip_reason).
    skip_reason is None on success; otherwise a human-readable string explaining
    why no model could be fit, so callers can surface it in all_models
    and outliers instead of the site silently vanishing with no trace.
    """
    is_gas        = _is_gas(service_type)
    raw_baseline  = bills[bills["Baseline_Bill"] == 1].copy()
    reporting_all = bills[bills["Reporting_Bill"] == 1].copy()

    if len(raw_baseline) == 0:
        return None, [], [], "No baseline bills found (all bills fall on/after Commission Date)"

    clean_baseline, bl_outliers = detect_baseline_outliers(raw_baseline)

    # ── Drop baseline bills with missing weather data ─────────────────────────
    # NaN HDD/CDD will crash LinearRegression. Record dropped rows in bl_outliers
    # so they remain visible in the outliers output table.
    weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    nan_weather_bl = clean_baseline[clean_baseline[weather_cols].isna().any(axis=1)].copy()
    if len(nan_weather_bl) > 0:
        nan_weather_bl["Outlier_Type"]   = "Baseline"
        nan_weather_bl["Outlier_Reason"] = "Missing weather data (HDD/CDD NaN)"
        bl_outliers = pd.concat([bl_outliers, nan_weather_bl], ignore_index=True)
        clean_baseline = clean_baseline.drop(index=nan_weather_bl.index)
    # ─────────────────────────────────────────────────────────────────────────

    if len(clean_baseline) < baseline_count:
        return (None, list(bl_outliers.to_dict("records")), [],
                f"Insufficient baseline data: only {len(clean_baseline)} clean baseline "
                f"bill(s) available after outlier/missing-weather removal, "
                f"{baseline_count} required")

    # ── Drop reporting bills with missing weather data ────────────────────────
    # Can't generate predictions without HDD/CDD; dropping here prevents a
    # crash in detect_reporting_outliers() and eval_combo().
    rep_weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    reporting_all = reporting_all.dropna(subset=rep_weather_cols)
    # ─────────────────────────────────────────────────────────────────────────

    clean_baseline["Period_Start_Date"] = pd.to_datetime(clean_baseline["Period_Start_Date"])
    is_new     = _is_new_site(clean_baseline)
    cv_relaxed = False

    bal_thresh = GAS_SEASONAL_BALANCE_THRESHOLD if is_gas else SEASONAL_BALANCE_THRESHOLD
    # Derived once from the site's own clean pool, then reused for every
    # combination — the idle quarter is a property of the site's climate, not of
    # whichever 12 bills are being tested.
    idle_q     = _idle_quarter(clean_baseline, is_gas)

    def _run_strategy(min_per_q):
        nonlocal cv_relaxed
        n, total = len(clean_baseline), _n_choose_k(len(clean_baseline), baseline_count)
        combos   = (combinations(range(n), baseline_count)
                    if total <= EXHAUSTIVE_LIMIT
                    else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3))

        valid = []
        for c in combos:
            sel = clean_baseline.iloc[list(c)]
            if not _seasonal_ok(sel, min_per_q, bal_thresh, idle_q=idle_q):
                continue
            wc, _, _ = _weather_coverage(sel, clean_baseline, is_gas)
            if wc < WEATHER_COVERAGE_THRESHOLD:
                continue
            if not is_new:
                if _quarterly_spread(sel, idle_q) > TEMPORAL_CV_CEILING:
                    continue
            valid.append(c)
            if len(valid) >= MAX_COMBINATIONS:
                break

        # Relax CV ceiling if it filtered everything out
        if not valid and not is_new:
            cv_relaxed = True
            combos2 = (combinations(range(n), baseline_count)
                       if total <= EXHAUSTIVE_LIMIT
                       else _random_combos(n, baseline_count, MAX_COMBINATIONS * 3))
            for c in combos2:
                sel = clean_baseline.iloc[list(c)]
                if not _seasonal_ok(sel, min_per_q, bal_thresh, idle_q=idle_q):
                    continue
                wc, _, _ = _weather_coverage(sel, clean_baseline, is_gas)
                if wc >= WEATHER_COVERAGE_THRESHOLD:
                    valid.append(c)
                if len(valid) >= MAX_COMBINATIONS:
                    break

        if not valid:
            return None

        best_pass_pos,  best_pass_nonpos,  best_fail     = None, None, None
        best_pass_pos_s, best_pass_nonpos_s, best_fail_s = -np.inf, -np.inf, -np.inf
        max_rep = len(reporting_all)

        for c in valid:
            res   = eval_combo(c, clean_baseline, reporting_all, clean_baseline,
                               r2_thresh, is_gas)
            score = _combo_score(res["r2"], res["temporal_cv"], res["pct_avoided"],
                                 res["reporting_count"], max_rep, is_new)
            if res["passes_all"]:
                if res["total_avoided"] > 0:
                    if score > best_pass_pos_s:
                        best_pass_pos_s, best_pass_pos = score, res
                else:
                    if score > best_pass_nonpos_s:
                        best_pass_nonpos_s, best_pass_nonpos = score, res
            else:
                if score > best_fail_s:
                    best_fail_s, best_fail = score, res

        # Prefer positive-savings passing models. If a higher-scoring non-positive
        # passing model was available, record it in the result for transparency.
        if best_pass_pos is not None:
            if (best_pass_nonpos is not None
                    and best_pass_nonpos_s > best_pass_pos_s):
                best_pass_pos["_skipped_nonpos_r2"]   = round(best_pass_nonpos["r2"], 4)
                best_pass_pos["_skipped_nonpos_score"] = round(best_pass_nonpos_s, 4)
            return best_pass_pos

        return best_pass_nonpos or best_fail

    # One rung, not two. The old "Acceptable (>=1 bill per quarter)" retry was
    # removed because it could never do anything: a fresh baseline is always
    # exactly baseline_count bills, so the mean quarter is always exactly 3
    # (electric) or 2 (gas), and the balance threshold converts to a flat
    # minimum — 0.65 x 3 = 1.95, so min >= 2 regardless of what the floor said.
    # A floor of 1 was strictly looser than a constraint already in force.
    result   = _run_strategy(PREFERRED_MIN_PER_QUARTER)
    strategy = f"Optimal (≥{PREFERRED_MIN_PER_QUARTER} bills per quarter)"

    if result is None:
        # ── Rung 4: most recent N bills, no optimization ─────────────────────
        # Reached only when no combination satisfies the gates. Previously the
        # site was skipped outright and the analyst got nothing to judge.
        #
        # WHY THE MOST RECENT N RATHER THAN A GATES-OFF SEARCH:
        #   _combo_score() weights pct_avoided at 0.15. That is defensible only
        #   because the candidate pool is pre-filtered to combinations that
        #   already cleared the gates — "prefer positive savings AMONG
        #   quality-passing models". Drop the gates and the same ranking becomes
        #   "pick whichever baseline makes savings look best", with no
        #   representativeness constraint. That is cherry-picking, and this
        #   project has already ruled it out.
        #   Most-recent-N has no ranking function, so there is nothing to game.
        #   It is also deterministic (no seed, no sampling — immune to the
        #   seed = n*1000+k reshuffle that moves a sampled baseline whenever the
        #   clean-bill count changes), explainable to a customer, and closer to
        #   textbook IPMVP than the optimizer is: Option C wants a contiguous
        #   baseline period immediately preceding the intervention, which is
        #   exactly "the last N bills before the commission date".
        #
        # Note this rung is only reachable when len(clean_baseline) >=
        # baseline_count — the insufficient-data check above returns first — so
        # "not enough bills" remains the ONLY reason a model is never built.
        recent_pos = list(np.argsort(
            clean_baseline["Period_Start_Date"].values, kind="stable")[-baseline_count:])
        result   = eval_combo(recent_pos, clean_baseline, reporting_all,
                              clean_baseline, r2_thresh, is_gas)
        strategy = "Most recent bills — no optimization"
        # No forcing of Recommended here, deliberately. This rung is a METHOD,
        # not a defect: the site fell to it because its data has a real
        # statistical problem (usually a season it has no bills for), and that
        # problem is what should disqualify the model. passes_all above now
        # includes the seasonal check, so an unrepresentative baseline fails on
        # its own statistics and Recommended follows. If a most-recent-N baseline
        # somehow cleared every gate it would deserve to be recommended — though
        # in practice it cannot, since a combination clearing every gate would
        # have been found by rung 1 or 2 and this rung would never have fired.

    result.update({
        "seasonal_strategy": strategy,
        "optimization_mode": ("Most Recent" if strategy.startswith("Most recent")
                              else "Optimized"),
        "is_new_site":        is_new,
        "cv_ceiling_relaxed": cv_relaxed,
        "bl_outliers_df":     bl_outliers,
        "reporting_all":      reporting_all,
    })
    return (result, list(bl_outliers.to_dict("records")),
            list(result["rep_outliers"].to_dict("records")), None)


def optimize_from_locked(site_id, service_type, bills, r2_thresh):
    """
    Reconstruct a model from pre-selected baseline bills (Selected_Baseline == '1').
    Returns (result_or_None, bl_outlier_records, rep_outlier_records, skip_reason).
    skip_reason is None on success; see optimize() for the convention.
    """
    #if has_locked:
    #    print(f"[DEBUG] Columns at optimize_from_locked call: {list(meter_data.columns)}")
    #    res, bl_out, rep_out, skip_reason = optimize_from_locked(...)

    is_gas         = _is_gas(service_type)
    baseline_bills = bills[bills["Selected_Baseline"].apply(
        lambda v: str(v).strip() in ("1", "1.0"))].copy()
    reporting_bills = bills[bills["Reporting_Bill"] == 1].copy()

    if len(baseline_bills) == 0:
        return None, [], [], "No locked baseline bills found (Selected Baseline column has no '1' rows for this site/meter)"

    baseline_bills["Period_Start_Date"] = pd.to_datetime(
        baseline_bills["Period_Start_Date"], errors="coerce")

    # ── Drop locked baseline bills with missing weather data ──────────────────
    # NaN HDD/CDD will crash LinearRegression.
    weather_cols   = ["HDD"] if is_gas else ["HDD", "CDD"]
    nan_weather_bl = baseline_bills[baseline_bills[weather_cols].isna().any(axis=1)].copy()
    if len(nan_weather_bl) > 0:
        nan_weather_bl["Outlier_Type"]   = "Baseline"
        nan_weather_bl["Outlier_Reason"] = "Missing weather data (HDD/CDD NaN)"
        baseline_bills = baseline_bills.drop(index=nan_weather_bl.index)
        print(f"[WARNING] {len(nan_weather_bl)} locked baseline bill(s) for "
              f"{site_id} dropped due to missing weather data.")
    # ─────────────────────────────────────────────────────────────────────────

    if len(baseline_bills) == 0:
        return (None, list(nan_weather_bl.to_dict("records")), [],
                "All locked baseline bills were dropped due to missing weather data (HDD/CDD NaN)")

    # ── Drop reporting bills with missing weather data ────────────────────────
    rep_weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    reporting_bills  = reporting_bills.dropna(subset=rep_weather_cols)
    # ─────────────────────────────────────────────────────────────────────────

    # ── Reference pool for weather coverage / seasonal balance ───────────────
    # Built the same way optimize() builds clean_baseline, so a locked model's
    # quality numbers are directly comparable to an optimized one's.
    #
    # This block exists because _weather_coverage() was previously called as
    # _weather_coverage(baseline_bills, baseline_bills) — the SAME frame twice.
    # Its cov() computes sel_range / pool_range, so comparing a frame to itself
    # is an identity: every locked model reported exactly 100.0% coverage,
    # "Excellent", Passes = True, with zero variance across all 61 of them. Six
    # gas meters (URB027/2066266 at a true 60.0%, URB041/2209522 at 63.5%,
    # URB032/2181413 at 66.0%, URB018/1534919 at 66.8%, URB023/15995852 at
    # 68.0%, URB020/15798100 at 69.2%) were sitting in the KPI tiles on a
    # coverage claim that had never actually been computed. Gas hid it best:
    # it selects 8 of an ~18-bill pool, so it frequently misses the HDD
    # extremes, whereas electric takes 12 of 14-17 and usually catches them by
    # accident.
    raw_pool   = bills[bills["Baseline_Bill"] == 1].copy()
    clean_pool, _ = detect_baseline_outliers(raw_pool)
    clean_pool = clean_pool.dropna(subset=weather_cols)
    if len(clean_pool) == 0:
        clean_pool = baseline_bills          # degenerate; nothing else to compare against

    model, r2, cvrmse = fit_model(baseline_bills, is_gas)
    wc, hdd_c, cdd_c  = _weather_coverage(baseline_bills, clean_pool, is_gas)

    # ── Seasonal balance on a locked baseline ────────────────────────────────
    # optimize() enforces seasonal balance as a PRE-FILTER: a combination that
    # fails it never gets scored, so any optimized model satisfies it by
    # construction and passes_all doesn't need to restate it. The locked path
    # has no such filter — _seasonal_ok() was never called here at all — so a
    # locked baseline's representativeness went completely unexamined.
    #
    # That matters most for a baseline that was never optimized in the first
    # place. Once a most-recent-N fallback model is locked and re-uploaded, its
    # Optimization Mode becomes "Locked" and the fact that it was never
    # optimized would vanish — while passes_all quietly collapsed to R2 and
    # CV-RMSE alone, handing it Recommended = True on the second run.
    #
    # Re-deriving the check from the bills every run rather than remembering a
    # flag makes it self-healing: an unrepresentative baseline stays flagged no
    # matter how it got that way, including one a human hand-picked badly.
    # PREFERRED_MIN_PER_QUARTER is the bar used because it is now the only
    # bills-per-quarter gate optimize() applies.
    bal_thresh     = GAS_SEASONAL_BALANCE_THRESHOLD if is_gas else SEASONAL_BALANCE_THRESHOLD
    passes_seasonal = _seasonal_ok(baseline_bills, PREFERRED_MIN_PER_QUARTER, bal_thresh,
                                   idle_q=_idle_quarter(clean_pool, is_gas))

    # ── Did this locked baseline come from the most-recent-N fallback? ──────
    # Re-derived from the bills rather than persisted in the file, so it can't
    # drift out of sync with the baseline it describes. Three conditions, ALL
    # required, because "the selection equals the most recent N" alone is not
    # evidence of anything:
    #
    #   1. A CHOICE EXISTED (pool > N). With pool == N there is exactly one
    #      possible baseline; it is trivially also "the most recent N", and the
    #      optimizer had nothing to optimize. Observed at URB013/6516960
    #      (12 bills, needs 12).
    #   2. The selection IS the most recent N.
    #   3. It FAILS a gate. This is the discriminator. optimize() would have
    #      happily returned a most-recent-N baseline from rung 1 or 2 if it
    #      cleared the gates and scored best — that is optimization arriving at
    #      the same answer, not a fallback, and labelling it "no optimization"
    #      would be a lie. Observed at URB033/AA034899520 (pool 14, chose the
    #      last 12, passes everything) and URB041/6906426 (pool 16, same).
    #      A baseline that fails a gate is one optimize() could NOT have chosen,
    #      so the fallback is the only path that produces it.
    _n         = len(baseline_bills)
    _sel_dates = sorted(pd.to_datetime(baseline_bills["Period_Start_Date"]).tolist())
    _recent    = sorted(pd.to_datetime(clean_pool["Period_Start_Date"])
                          .sort_values().tail(_n).tolist())
    is_most_recent = (len(clean_pool) > _n
                      and _sel_dates == _recent
                      and not (passes_seasonal
                               and round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD))

    qcounts           = baseline_bills["Period_Start_Date"].dt.quarter.value_counts()
    temporal_cv       = _quarterly_spread(baseline_bills, _idle_quarter(clean_pool, is_gas))

    clean_rep, rep_outliers = detect_reporting_outliers(model, reporting_bills, is_gas)
    if len(clean_rep) > 0:
        X_rep    = clean_rep[["HDD"]].values if is_gas else clean_rep[["HDD", "CDD"]].values
        pred_rep = model.predict(X_rep)
        avoided  = pred_rep.sum() - clean_rep["Consumption"].sum()
        pct_avd  = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
    else:
        avoided, pct_avd, pred_rep = 0.0, 0.0, np.array([])

    hdd_coef = model.coef_[0]
    cdd_coef = model.coef_[1] if not is_gas else 0.0
    equation = (f"Consumption = {model.intercept_:.2f} + {hdd_coef:.4f}*HDD"
                + (f" + {cdd_coef:.4f}*CDD" if not is_gas else ""))
    is_new   = _is_new_site(baseline_bills)

    bl_outliers_df = nan_weather_bl if len(nan_weather_bl) > 0 else pd.DataFrame()

    result = {
        "model": model, "selected": baseline_bills,
        "clean_reporting": clean_rep, "rep_outliers": rep_outliers, "predicted_rep": pred_rep,
        "equation": equation, "intercept": model.intercept_,
        "hdd_coef": hdd_coef, "cdd_coef": cdd_coef,
        "r2": r2, "cvrmse": cvrmse,
        "wc_overall": wc, "wc_hdd": hdd_c, "wc_cdd": cdd_c, "temporal_cv": temporal_cv,
        "passes_r2": round(r2, 2) >= r2_thresh, "passes_cvrmse": round(cvrmse, 2) <= CVRMSE_THRESHOLD,
        "passes_wc": round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD,
        "passes_seasonal": passes_seasonal,
        "seasonal_balance": _seasonal_balance(baseline_bills),
        # passes_seasonal is folded in HERE but not on the optimize() path, and
        # that asymmetry is deliberate: optimize() guarantees it by pre-filter,
        # so restating it there changes nothing. Here it is the only thing
        # standing between an unrepresentative locked baseline and a green
        # "Model Passes Quality". Including it makes the column mean one thing
        # on both paths — R2 + CV-RMSE + weather coverage + seasonal balance —
        # rather than silently meaning less whenever a baseline is locked.
        "passes_all": (round(r2, 2) >= r2_thresh
                       and round(cvrmse, 2) <= CVRMSE_THRESHOLD
                       and round(wc, 1) >= WEATHER_COVERAGE_THRESHOLD
                       and passes_seasonal),
        "total_avoided": avoided, "pct_avoided": pct_avd, "reporting_count": len(clean_rep),
        # Re-derived, not remembered. Answers your question directly: a
        # most-recent-N baseline that gets saved and re-uploaded still says so,
        # rather than collapsing to a bare "Locked" that hides how it was built.
        # An analyst who hand-picked exactly the last N bills gets the same
        # label — which is accurate, because that IS what the baseline is.
        "seasonal_strategy": ("Most recent bills — no optimization" if is_most_recent
                              else "Locked (pre-selected)" if passes_seasonal
                              else "Locked — baseline not seasonally balanced"),
        "optimization_mode": "Locked",
        "is_new_site": is_new,
        "cv_ceiling_relaxed": not is_new and temporal_cv > TEMPORAL_CV_CEILING,
        "reporting_all": reporting_bills, "bl_outliers_df": bl_outliers_df,
        **{f"Q{q}_Bills": int(qcounts.get(q, 0)) for q in [1, 2, 3, 4]},
    }
    bl_out  = list(nan_weather_bl.to_dict("records")) if len(nan_weather_bl) > 0 else []
    rep_out = list(rep_outliers.to_dict("records"))   if len(rep_outliers)  > 0 else []
    return result, bl_out, rep_out, None


# ── Multi-meter helpers ───────────────────────────────────────────────────────

def meters_concurrent(site_data: pd.DataFrame) -> bool:
    meters = list(site_data["Meter_Number"].dropna().unique())
    if len(meters) < 2:
        return False
    for i in range(len(meters)):
        for j in range(i + 1, len(meters)):
            s1 = set(site_data[site_data["Meter_Number"] == meters[i]]["Period_Start_Date"])
            s2 = set(site_data[site_data["Meter_Number"] == meters[j]]["Period_Start_Date"])
            if len(s1 & s2) >= OVERLAP_THRESHOLD:
                return True
    return False


def drop_incomplete_meter_periods(site_data: pd.DataFrame,
                                  pooled_meters: list) -> tuple:
    """
    Drop billing periods in which fewer than ALL pooled meters have a bill.

    WHY THIS EXISTS
      aggregate_site() sums Consumption/Total_Charges per
      (Period_Start_Date, Period_End_Date) with no check on how many meters
      actually landed in each group. When a concurrent site is missing one
      meter's bill for a period — because the meter was installed partway
      through the baseline, removed partway through, or simply didn't get
      read — the "AGGREGATED (N)" row for that period silently contains
      FEWER than N meters' consumption, while still being fitted and scored
      as though it were the full N-meter load.

      The result is not noise, it is bias, because meter presence usually
      correlates with the calendar and therefore with weather. Observed at
      URB013 (2026-07-13 run): meter 6516960 has no bills before ~Mar 2025,
      so the three highest-HDD baseline periods (Dec/Jan/Feb) were 1-meter
      rows at ~2,700 kWh while the mild months were 2-meter rows at ~7,000.
      The regression concluded that colder weather means LESS electricity
      and produced a NEGATIVE HDD coefficient (-17.2612) — at R² = 0.91,
      passing every quality gate. URB002 had the mirror image: the 1-meter
      rows were the mild months, so HDD/CDD coefficients were inflated to
      +34.4/+33.5 and one reporting bill claimed +$479.67 of savings that
      was really just the missing meter.

      Dropping the incomplete periods is the defensible fix: a period where
      we only have part of the site's load is not an observation of the
      site's load, and there is no IPMVP-defensible way to impute the
      missing meter (that would be inventing baseline data). Sites that then
      fall under the 12/8 bill gate genuinely do not have enough complete
      periods to support an aggregate, and should fail.

    SCOPE
      Called only from the CONCURRENT aggregation path. The sequential-meter
      path also calls aggregate_site(), but there the meters deliberately do
      NOT share periods — the "aggregate" is a stitch of successive meters,
      so every period legitimately has exactly one meter and this filter
      would (correctly, but uselessly) delete the entire series. Keeping the
      filter out of aggregate_site() itself means the sequential path is
      untouched.

    Args:
        site_data:     raw per-meter bills, already restricted to the meters
                       being pooled (i.e. post qualifying_meters filter).
        pooled_meters: the meters expected in every period.

    Returns:
        (filtered_df, coverage_note)
        coverage_note is "" when nothing was dropped, otherwise a
        human-readable summary naming the periods and the missing meters,
        for the Notes / skip-reason fields.
    """
    n_expected = len(pooled_meters)
    if n_expected < 2 or len(site_data) == 0:
        return site_data, ""

    # nunique (not size) so a duplicate bill for one meter can't masquerade
    # as coverage from two different meters.
    per_period_meters = site_data.groupby(
        ["Period_Start_Date", "Period_End_Date"]
    )["Meter_Number"].transform("nunique")

    keep    = per_period_meters >= n_expected
    dropped = site_data.loc[~keep]
    if len(dropped) == 0:
        return site_data, ""

    # Summarise what went missing, so an analyst reading Notes can see why a
    # site's aggregate baseline shrank (or vanished) instead of guessing.
    expected_set = set(map(str, pooled_meters))
    detail = []
    for (ps, _pe), grp in dropped.groupby(["Period_Start_Date", "Period_End_Date"]):
        missing = sorted(expected_set - set(grp["Meter_Number"].astype(str)))
        detail.append(f"{pd.to_datetime(ps).date()} (missing {', '.join(missing)})")

    n_periods = len(detail)
    note = (
        f"Aggregate excluded {n_periods} billing period(s) where not all "
        f"{n_expected} pooled meters had a bill — an incomplete period "
        f"under-states site load and biases the model: "
        f"{'; '.join(detail[:6])}"
        f"{f'; +{n_periods - 6} more' if n_periods > 6 else ''}"
    )
    return site_data.loc[keep], note


AGG_SB_INTERNAL = "Aggregated_Selected_Baseline"   # post space->underscore rename


def aggregate_site(site_data: pd.DataFrame,
                   agg_lock_col: str = None) -> pd.DataFrame:
    """
    Collapse per-meter bills into one row per billing period.

    agg_lock_col — when supplied (the CONCURRENT path), the returned rows carry
      the AGGREGATE's own locked baseline in "Selected_Baseline", rebuilt from
      that column, instead of whatever the individual meters had flagged.

      Two things make this work:

      1. ALL-meters semantics. A period counts as locked only if EVERY pooled
         meter's row for that period carries the flag. "Any" would let one
         stray edit resurrect a period the aggregate never selected — and since
         drop_incomplete_meter_periods() guarantees every surviving period has
         all N meters, "all" is exactly the invariant the writer produces.

      2. Overwriting "Selected_Baseline". optimize_from_locked() reads that
         column and nothing else, so populating it here means that function
         works on aggregates with no changes at all. The individual meters'
         flags are meaningless for an aggregate row — meter A's own model may
         have locked a period the aggregate didn't, and vice versa. That
         conflation is precisely what the two-column split exists to prevent.

      Left as None on the SEQUENTIAL path, where "Selected_Baseline" keeps its
      per-meter "first" value: a sequential stitch is the site's INDIVIDUAL
      model for that fuel (each period has exactly one meter), so it locks off
      the individual column like any other meter.
    """
    agg_cols = {"Consumption": "sum", "Total_Charges": "sum",
                "Service_Type": "first", "Site_Name": "first"}
    for opt in ["HDD", "CDD", "Baseline_Bill", "Reporting_Bill",
            "Commission_Date", "WeatherStation", "Weather_Source",
            "Selected_Baseline"]:
        if opt in site_data.columns:
            agg_cols[opt] = "first"

    # Passing agg_lock_col at all is the caller declaring "this is an aggregate".
    # Whether the column actually EXISTS in the data is a separate question, and
    # the distinction matters: on a legacy single-column input there is no
    # aggregate lock column, and the aggregate must then have NO locked baseline
    # — it must NOT inherit the individual meters' flags that "first" would
    # otherwise leave sitting in Selected_Baseline. Getting this wrong rebuilt
    # URB002's aggregate from meter 5888384's 11 individually-locked periods
    # (R2 0.5143) instead of the aggregate's own 12 (R2 0.8835), and silently
    # flipped URB032 from Skipped to Locked. That is the same individual/
    # aggregate conflation the two-column split exists to prevent.
    is_aggregate = bool(agg_lock_col)
    has_agg_lock = is_aggregate and agg_lock_col in site_data.columns
    if has_agg_lock:
        agg_cols[agg_lock_col] = lambda s: (
            "1" if s.astype(str).str.strip().isin(("1", "1.0")).all() else "")

    agg_df = site_data.groupby(["Period_Start_Date", "Period_End_Date"],
                               as_index=False).agg(agg_cols)
    agg_df["Meter_Number"] = "AGGREGATED"

    if is_aggregate:
        if has_agg_lock:
            agg_df["Selected_Baseline"] = agg_df[agg_lock_col]
            agg_df = agg_df.drop(columns=[agg_lock_col])
        else:
            # No aggregate lock column in the input => this aggregate has no
            # locked baseline and must be optimized fresh.
            agg_df["Selected_Baseline"] = ""

    return agg_df


def _meets_individual_baseline_count(meter_bills: pd.DataFrame, is_gas: bool,
                                     baseline_count: int) -> bool:
    """
    True if this single meter's OWN baseline bills — after the same outlier
    removal and missing-weather filtering optimize() applies before checking
    against baseline_count — individually reach baseline_count (12 electric /
    8 gas) clean bills.

    Used to decide which meters are eligible to be pooled into a concurrent-
    meter aggregate (see run_analysis): only meters that individually clear
    this bar get aggregated together. A meter short on clean baseline bills
    is excluded from the aggregate pool entirely, rather than being folded in
    and dragging the aggregate's own usable baseline count down — e.g. two
    meters that are billed on identical concurrent periods don't add up to
    more available periods when pooled, they just sum consumption within the
    periods that exist, so a short meter can pull a perfectly good aggregate
    down to its own shortfall.

    Deliberately count-only: a meter that has enough clean bills but still
    fails to find a valid seasonal-balance/weather-coverage combination on
    its own (i.e. its own optimize() call returns None for THAT reason) still
    counts as qualifying here — combining it with another meter's bills may
    well produce a fittable aggregate even though the meter alone couldn't.
    Quality (R²/CV-RMSE/weather coverage) is intentionally not checked here
    at all; that's assessed only after the aggregate itself is fit.

    Mirrors but does not call optimize()'s internal raw_baseline /
    detect_baseline_outliers / NaN-weather-drop sequence — kept as a
    standalone, lighter-weight count check since this only needs a count,
    not optimize()'s full bl_outliers record-building. If that filtering
    logic in optimize() ever changes, this should be updated to match.
    """
    raw_baseline = meter_bills[meter_bills["Baseline_Bill"] == 1]
    if len(raw_baseline) == 0:
        return False
    clean_baseline, _ = detect_baseline_outliers(raw_baseline)
    weather_cols = ["HDD"] if is_gas else ["HDD", "CDD"]
    clean_baseline = clean_baseline.dropna(subset=weather_cols)
    return len(clean_baseline) >= baseline_count


def calc_meter_weights(site_data: pd.DataFrame, meter_nums: list) -> dict:
    bl_df    = site_data[site_data["Baseline_Bill"] == 1]
    meter_bl = {str(m): float(bl_df[bl_df["Meter_Number"] == m]["Consumption"].sum())
                for m in meter_nums}
    total    = sum(meter_bl.values())
    if total == 0:
        n = max(len(meter_nums), 1)
        return {str(m): 1.0 / n for m in meter_nums}
    return {m: v / total for m, v in meter_bl.items()}


def failing_weight_flag(meter_weights: dict, ind_results: list) -> tuple:
    failing = [(str(mn), meter_weights.get(str(mn), 0.0))
               for mn, res, _ in ind_results if not res["passes_all"]]
    if not failing:
        return "OK", ""

    fw    = sum(w for _, w in failing)
    names = ", ".join(f"{m} ({w*100:.1f}%)" for m, w in failing)

    if fw > WEIGHT_HIGH_RISK_THRESHOLD:
        return "HIGH RISK", (
            f"HIGH RISK — failing meter(s) [{names}] account for {fw*100:.1f}% of site "
            f"baseline load (>{WEIGHT_HIGH_RISK_THRESHOLD*100:.0f}% threshold). "
            f"Aggregate model covers load that cannot be individually verified."
        )
    if fw > WEIGHT_REVIEW_THRESHOLD:
        return "REVIEW", (
            f"REVIEW — failing meter(s) [{names}] account for {fw*100:.1f}% of site "
            f"baseline load (>{WEIGHT_REVIEW_THRESHOLD*100:.0f}% threshold)."
        )
    return "OK", ""


def low_coverage_flag(weight: float, passes_quality: bool) -> str:
    if not passes_quality or weight >= LOW_COVERAGE_THRESHOLD:
        return ""
    return f"LOW COVERAGE ({weight*100:.1f}% of site baseline load)"


# ── Row builders ──────────────────────────────────────────────────────────────

def build_result_row(res, site, meter_num, model_type, service_type,
                     bl_count, concurrent, sequential):
    res["service_type_internal"] = service_type
    notes_parts = []
    if sequential:
        notes_parts.append("Sequential meter replacement: meters combined into single timeline")
    if res.get("_skipped_nonpos_r2") is not None:
        notes_parts.append(
            f"Savings-positive selection: a higher-scoring passing model "
            f"(R²={res['_skipped_nonpos_r2']:.4f}, score={res['_skipped_nonpos_score']:.4f}) "
            f"with non-positive savings was available but not selected"
        )
    notes = " | ".join(notes_parts)

    r2_rating = ("Excellent" if res["r2"] >= 0.9 else "Good" if res["r2"] >= 0.75
                 else "Fair" if res["r2"] >= 0.6 else "Poor")
    cv_rating = ("Excellent" if res["cvrmse"] < 10
                 else "Good (ASHRAE Pass)" if res["cvrmse"] <= 15
                 else "Fair (Fail)"        if res["cvrmse"] <= 25 else "Poor")
    wc_rating = ("Excellent" if res["wc_overall"] >= 90 else "Good" if res["wc_overall"] >= 75
                 else "Fair" if res["wc_overall"] >= 60 else "Poor")
    # Bands mirror the R2/weather-coverage style. Note the fuel-specific PASS
    # threshold is 0.75 electric / 0.50 gas, so a "Fair" gas baseline still
    # passes while a "Fair" electric one does not — the rating describes the
    # number, "Passes Seasonal Balance" applies the fuel's gate.
    _sb = res.get("seasonal_balance")
    sb_rating = (None if _sb is None else
                 "Excellent" if _sb >= 0.90 else "Good" if _sb >= 0.75
                 else "Fair"  if _sb >= 0.50 else "Poor")

    return {
        "Site Name":               site,
        "Meter Number":            str(meter_num),
        "Model Type":              model_type,
        "Service Type":            service_type,
        "Seasonal Strategy":       res["seasonal_strategy"],
        # Two INDEPENDENT facts, deliberately kept in separate columns:
        #   Optimization Mode  — how THIS run arrived at the baseline
        #                        (Optimized / Most Recent / Locked / Skipped)
        #   Seasonal Strategy  — what the baseline IS, re-derived from the bills
        # A most-recent-N baseline that gets saved and re-uploaded comes back as
        # Optimization Mode = "Locked" (true — this run read it off the file)
        # while Seasonal Strategy still reads "Most recent bills — no
        # optimization" (also true, and re-derived rather than remembered). So
        # the fact that a baseline was never optimized survives the round-trip
        # instead of vanishing behind a bare "Locked".
        # Set explicitly by each path rather than sniffed out of the strategy
        # string, which cannot distinguish "locked" from "most recent" once a
        # most-recent baseline has been locked.
        "Optimization Mode":       res.get("optimization_mode", "Optimized"),
        "New Site":                res.get("is_new_site", False),
        "CV Ceiling Relaxed":      res.get("cv_ceiling_relaxed", False),
        "Baseline Count":          len(res["selected"]),
        "Reporting Count":         res["reporting_count"],
        "Model Equation":          res["equation"],
        "Intercept":               round(res["intercept"], 4),
        "HDD Coefficient":         round(res["hdd_coef"], 4),
        "CDD Coefficient":         round(res["cdd_coef"], 4),
        "R2":                      round(res["r2"], 4),
        "R2 Rating":               r2_rating,
        "Passes R2":               res["passes_r2"],
        "CV-RMSE":                 round(res["cvrmse"], 2),
        "CV-RMSE Rating":          cv_rating,
        "Passes CV-RMSE":          res["passes_cvrmse"],
        "Weather Coverage (%)":    round(res["wc_overall"], 1),
        "HDD Coverage (%)":        round(res["wc_hdd"], 1),
        "CDD Coverage (%)":        round(res["wc_cdd"], 1),
        "Weather Coverage Rating": wc_rating,
        "Passes Weather Coverage": res["passes_wc"],
        "Seasonal Balance":        (None if res.get("seasonal_balance") is None
                                    else round(res["seasonal_balance"], 2)),
        "Seasonal Balance Rating": sb_rating,
        "Passes Seasonal Balance": res.get("passes_seasonal"),
        "Model Passes Quality":    res["passes_all"],
        "Q1 Bills (Jan-Mar)": res["Q1_Bills"],
        "Q2 Bills (Apr-Jun)": res["Q2_Bills"],
        "Q3 Bills (Jul-Sep)": res["Q3_Bills"],
        "Q4 Bills (Oct-Dec)": res["Q4_Bills"],
        "Quarterly Spread (%)":             round(res["temporal_cv"], 1),
        "Total Avoided Usage":     round(res["total_avoided"], 2),
        "Pct Avoided Usage":       round(res["pct_avoided"], 2),
        "Notes":                   notes,
        "Savings Status":          "Included",
        "Weight Flag":             "",
        "Meter Weight (%)":        None,
        "Coverage Flag":           "",
        **compute_cost_cols(res),
    }


def build_skipped_model_row(site, meter_num, model_type, service_type, skip_reason):
    """
    Build an all_models-schema row for a site/meter where optimize()
    or optimize_from_locked() returned None — i.e. no model could be fit at
    all (insufficient baseline bills, no valid combination passed quality
    gates, etc.). Without this, such sites previously vanished from every
    output table with zero trace (see project discussion: AMD0701/702/703/706
    had only ~11 clean baseline bills against a 12-bill requirement and were
    silently dropped with no record anywhere).

    All model-dependent columns (R2, CV-RMSE, equation, coefficients, cost
    columns, etc.) are left None since no model exists to report on. Identity
    columns (Site/Meter/Service/Model Type) are populated normally so the row
    is filterable/sortable alongside real results, and Notes/Savings Status
    carry the skip_reason so the cause is immediately visible without cross-
    referencing the outliers table.
    """
    row = {col: None for col in SCHEMAS["model"]}
    row.update({
        "Site Name":            site,
        "Meter Number":         str(meter_num),
        "Model Type":           model_type,
        "Service Type":         service_type,
        "Seasonal Strategy":    "N/A — No Model Fit",
        "Optimization Mode":    "Skipped",
        "Baseline Count":       0,
        "Reporting Count":      0,
        "Model Passes Quality": False,
        "Recommendation Reason": f"No model could be fit — {skip_reason}",
        "Notes":                f"SKIPPED — {skip_reason}",
        "Savings Status":       "Excluded — No Model Fit",
        "Weight Flag":          "",
        "Coverage Flag":        "",
        "New Site":             None,
        "CV Ceiling Relaxed":   None,
    })
    return row


def compute_cost_cols(res: dict) -> dict:
    rep_df = res.get("clean_reporting")
    model  = res.get("model")
    empty  = {
        "Measured Rate": None, "Modeled Cost ($)": None, "Actual Cost ($)": None,
        "Avoided Cost ($)": None, "Avg Monthly Avoided Cost": None,
        "Total Modeled Usage": None, "Total Actual Usage": None,
        "Savings Exclusion Flag": "",
    }

    if model is None or rep_df is None or len(rep_df) == 0:
        flag   = "EXCLUDED — All reporting bills removed as outliers" if (rep_df is not None and len(rep_df) == 0) else ""
        status = "Excluded — All Reporting Bills Removed" if flag else "Included"
        return {**empty, "Savings Status": status, "Savings Exclusion Flag": flag}

    charge_col = "Total_Charges" if "Total_Charges" in rep_df.columns else "Total Charges"
    if charge_col not in rep_df.columns:
        return {**empty, "Savings Status": "Included"}

    total_charges = float(rep_df[charge_col].sum())
    total_cons    = float(rep_df["Consumption"].sum())
    if total_cons == 0:
        return {**empty, "Savings Status": "Included"}

    is_gas   = _is_gas(res.get("service_type_internal", ""))
    X        = rep_df[["HDD"]].values if is_gas else rep_df[["HDD", "CDD"]].values
    pred     = model.predict(X)
    pred_sum = float(pred.sum())
    n_bills  = len(rep_df)
    rate     = total_charges / total_cons
    per_pct  = (pred - rep_df["Consumption"].values) / pred

    # Cost figures are ALWAYS calculated, whatever the savings verdict turns out
    # to be. Previously an all-negative site returned nulls for Measured Rate /
    # Modeled Cost / Actual Cost / Total Modeled Usage / Total Actual Usage and
    # a hard-zero Avoided Cost, which left the analyst nothing to review — and
    # was internally inconsistent, since Total Avoided Usage and Pct Avoided
    # Usage were populated on those same rows. A site showing usage savings but
    # blank cost savings is worse than either extreme. Savings Status is a LABEL
    # the dashboard filters on; it is not a reason to withhold the numbers.
    # (Note: reporting_bills already published per-bill Bill Avoided Cost on
    # these rows, so this brings the model tables in line with what the bill
    # tables were reporting all along.)
    avoided_cost = round(pred_sum * rate - total_charges, 2)
    row = {
        "Measured Rate":            round(rate, 4),
        "Modeled Cost ($)":         round(pred_sum * rate, 2),
        "Actual Cost ($)":          round(total_charges, 2),
        "Avoided Cost ($)":         avoided_cost,
        "Avg Monthly Avoided Cost": round(avoided_cost / n_bills, 2) if n_bills else None,
        "Total Modeled Usage":      round(pred_sum, 2),
        "Total Actual Usage":       round(total_cons, 2),
        "Savings Status":           "Included",
        "Savings Exclusion Flag":   "",
    }

    # Exclude only on a PATTERN of negative savings, not a single data point.
    # One negative bill is the normal state of a brand-new customer whose first
    # bill has just arrived; excluding on it would drop the site out of
    # reporting entirely on one observation. See
    # MIN_REPORTING_BILLS_FOR_NEGATIVE_EXCLUSION.
    if (bool((per_pct < 0).all())
            and n_bills >= MIN_REPORTING_BILLS_FOR_NEGATIVE_EXCLUSION):
        row["Savings Status"] = "Excluded — All Reporting Periods Negative"
        row["Savings Exclusion Flag"] = (
            f"EXCLUDED — All {n_bills} clean reporting bill(s) show negative savings "
            f"(avg {per_pct.mean()*100:.1f}% avoided)"
        )
    return row


def build_bill_row(r, site, meter_num, service_type, period_type, status):
    return {
        "Site Name": site, "Meter Number": str(meter_num), "Service Type": service_type,
        "Period Type": period_type, "Status": status,
        "Period Start Date": r.get("Period_Start_Date"),
        "Period End Date":   r.get("Period_End_Date"),
        "HDD": r.get("HDD"), "CDD": r.get("CDD"),
        "Consumption":           r.get("Consumption"),
        "Total Charges":         r.get("Total_Charges"),
        "Predicted Consumption": None,
        "Avoided Usage":         None,
        "Pct Avoided":           None,
        "Bill Avoided Cost":     None,
        # Split into two columns: an individual meter model and the site's
        # aggregate model each select their own baseline, and a single flag
        # can't represent both. See build_input_with_baseline.
        "Individual Selected Baseline":  None,
        "Aggregated Selected Baseline":  None,
        "Weather Source":        r.get("Weather_Source", r.get("Weather Source", "")),
    }


def build_skip_bill_rows(bill_data: pd.DataFrame, site, service_type, status: str) -> tuple:
    """
    Build bare baseline/reporting bill rows for bills that won't go through
    any model (no model was fit, for whatever reason given in `status`).
    All model-dependent fields (Predicted Consumption, Avoided Usage, Pct
    Avoided, Bill Avoided Cost) are left None via build_bill_row's defaults —
    only the raw bill data passes through.

    Period Type / Baseline-vs-Reporting split is taken from the existing
    Baseline_Bill / Reporting_Bill flags already computed by infer_flags(),
    same as the normal path, so these still land in the correct output table.

    Generalised from the original cost-only-specific version (see project
    history) to also cover the "optimize() returned None" case — e.g.
    insufficient baseline data — so those bills are likewise still visible
    in baseline_bills/reporting_bills rather than vanishing with no trace.
    `bill_data` can be a whole site (cost-only skip, site-level) or a single
    meter's slice (no-model-fit skip, meter-level) — each row is labelled
    with its own Meter_Number either way, so this works for both granularities.

    Returns (baseline_rows, reporting_rows) — both lists of dicts in the
    "bills" schema shape, ready to extend into baseline_bill_rows /
    reporting_bill_rows directly.
    """
    baseline_rows, reporting_rows = [], []
    for _, r in bill_data.iterrows():
        meter_num = r.get("Meter_Number")
        meter_num = "N/A" if (meter_num is None or (isinstance(meter_num, float) and np.isnan(meter_num))) else meter_num
        row = build_bill_row(r, site, meter_num, service_type,
                             "Baseline" if r.get("Baseline_Bill") == 1 else "Reporting",
                             status)
        if r.get("Baseline_Bill") == 1:
            baseline_rows.append(row)
        else:
            reporting_rows.append(row)
    return baseline_rows, reporting_rows


def build_cost_only_skip_rows(site_data: pd.DataFrame, site, service_type) -> tuple:
    """
    Thin wrapper over build_skip_bill_rows with the cost-only-specific status
    message, kept as its own named function since "cost-only skip" and
    "no model fit" are conceptually different reasons even though they now
    share the same row-building mechanics.
    """
    status = ("Excluded: Site skipped — more than one PUBLISHER bill found for "
              "a billing period (cost-only consolidation could not be performed). "
              "See cost_only_review table.")
    return build_skip_bill_rows(site_data, site, service_type, status)


def build_baseline_rows(res, site, meter_num, service_type, is_aggregate=False):
    """
    is_aggregate routes the "1" to the right column. Bill rows are already
    split by meter — an aggregate emits its own "AGGREGATED (N)" rows — so a
    given row belongs to exactly one model and there is no ambiguity here.
    (input_with_baseline is the harder case: its rows are per-meter and BOTH
    models want to mark the same row.)
    """
    col  = "Aggregated Selected Baseline" if is_aggregate else "Individual Selected Baseline"
    rows = []
    for _, r in res["selected"].iterrows():
        row = build_bill_row(r, site, meter_num, service_type, "Baseline", "Used in Model")
        row[col] = "1"
        rows.append(row)
    for _, r in res.get("bl_outliers_df", pd.DataFrame()).iterrows():
        rows.append(build_bill_row(r, site, meter_num, service_type, "Baseline",
                                   f"Excluded: {r.get('Outlier_Reason', 'Outlier')}"))
    return rows


def build_reporting_rows(res, site, meter_num, service_type, model_passes=None, savings_status=None):
    rows  = []
    model = res["model"]
    is_gas = _is_gas(service_type)

    for bills, status_label in [(res["clean_reporting"], "Used in Savings"),
                                 (res["rep_outliers"],    None)]:
        if len(bills) == 0:
            continue
        X    = bills[["HDD"]].values if is_gas else bills[["HDD", "CDD"]].values
        pred = model.predict(X)
        for i, (_, r) in enumerate(bills.iterrows()):
            row  = build_bill_row(r, site, meter_num, service_type, "Reporting",
                                  status_label or f"Excluded: {r.get('Outlier_Reason', 'Outlier')}")
            cons    = float(r["Consumption"])
            charges = float(r.get("Total_Charges", r.get("Total Charges", 0)))
            rate    = (charges / cons) if cons > 0 else 0.0
            row.update({
                "Predicted Consumption": round(float(pred[i]), 2),
                "Avoided Usage":         round(float(pred[i]) - cons, 2),
                "Pct Avoided":           round((float(pred[i]) - cons) / float(pred[i]) * 100, 2)
                                          if pred[i] != 0 else 0.0,
                "Bill Avoided Cost":     round((float(pred[i]) - cons) * rate, 2),
                "Model Passes Quality":  model_passes,
                "Savings Status":        savings_status,
                "Reporting Count":       res.get("reporting_count"),
                "R2":                    res.get("r2"),
                "CV-RMSE":               res.get("cvrmse"),
                "Weather Coverage (%)": res.get("wc_overall"),
                "Passes R2":             res.get("passes_r2"),
                "Passes CV-RMSE":        res.get("passes_cvrmse"),
                "Passes Weather Coverage": res.get("passes_wc"),
                "Seasonal Balance":       (None if res.get("seasonal_balance") is None
                                           else round(res["seasonal_balance"], 2)),
                "Passes Seasonal Balance": res.get("passes_seasonal"),
            })
            rows.append(row)
    return rows


