# ── Utilities ─────────────────────────────────────────────────────────────────

def _is_gas(service_type: str) -> bool:
    return "gas" in str(service_type).lower()


def _calc_cvrmse(actual: np.ndarray, predicted: np.ndarray) -> float:
    rmse = np.sqrt(mean_squared_error(actual, predicted))
    mean_a = np.mean(actual)
    return (rmse / mean_a * 100) if mean_a != 0 else 999.0


def _n_choose_k(n, k):
    if k > n:
        return 0
    k = min(k, n - k)
    r = 1
    for i in range(k):
        r = r * (n - i) // (i + 1)
    return r


def _random_combos(n, k, count):
    # Fixed seed per (n, k) ensures identical results across runs for the same input.
    rng = np.random.default_rng(seed=(n * 1000 + k))
    seen, attempts = set(), 0
    while len(seen) < count and attempts < count * 4:
        c = tuple(sorted(rng.choice(n, k, replace=False)))
        if c not in seen:
            seen.add(c)
            yield c
        attempts += 1


def _safe_df(rows, schema_key):
    df_out = pd.DataFrame(rows) if rows else pd.DataFrame(columns=SCHEMAS[schema_key])
    if schema_key == "outliers" and len(df_out.columns) > 0:
        df_out = df_out[[c for c in SCHEMAS["outliers"] if c in df_out.columns]]
    return df_out


# ── Preprocessing ─────────────────────────────────────────────────────────────

def preprocess(df: pd.DataFrame) -> tuple:
    """
    Normalise column names, parse dates/numerics, convert units.
    Returns (processed_df, df_original, has_locked_baseline, cost_only_flagged_sites).
    df_original retains original column name formatting for input_with_baseline output.
    cost_only_flagged_sites is an empty set unless the Provider Classification
    column is present in the input (see consolidate_cost_only_bills for behavior).
    """
    df = df.copy()
    df.columns = df.columns.str.strip()
    df_original = df.copy()

    df = df.rename(columns={c: c.replace(" ", "_") for c in df.columns})

    for col in ["Period_Start_Date", "Period_End_Date", "Commission_Date"]:
        if col in df.columns:
            parsed = pd.to_datetime(df[col], errors="coerce", utc=True)
            df[col] = parsed.dt.tz_convert(None)

    for col in ["HDD", "CDD", "Consumption"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    for col in ["HDD", "CDD"]:
        if col not in df.columns:
            if WEATHER_SOURCE == "sigma":
                print(f"[WARNING] '{col}' column not found in input. "
                      f"WEATHER_SOURCE is 'csv' — this will cause model fitting to fail.")
            else:
                print(f"[INFO] '{col}' column not present in input — "
                      f"will be sourced entirely from Sigma weather element.")
        else:
            n_nan = df[col].isna().sum()
            if n_nan > 0:
                print(f"[WARNING] {n_nan} NaN value(s) found in '{col}' after parsing. "
                      f"Affected rows will be excluded from model fitting.")

    if "Total_Charges" in df.columns:
        df["Total_Charges"] = pd.to_numeric(
            df["Total_Charges"].astype(str)
                .str.replace(r"[\$,]", "", regex=True).str.strip(),
            errors="coerce",
        )

    df = _convert_units(df)

    # ── Cost-only (PUBLISHER / PASS_THROUGH) consolidation ─────────────────
    # Must run AFTER unit conversion (so kept Consumption values are already
    # in canonical units) and AFTER Total_Charges is numeric (so charges can
    # be summed), but BEFORE infer_flags()/optimization ever see the rows.
    # No-ops entirely if the classification column isn't in this input.
    # Returns the consolidated df plus the set of sites flagged for skip
    # (more than one PUBLISHER bill in any period group).
    df, cost_only_flagged_sites = consolidate_cost_only_bills(df)
    # ─────────────────────────────────────────────────────────────────────

    # ── Selected Baseline column resolution ────────────────────────────────
    # The input may arrive in either shape:
    #   NEW    — "Individual Selected Baseline" + "Aggregated Selected Baseline"
    #   LEGACY — a single "Selected Baseline"
    # Internally the script keeps calling the individual-model column
    # "Selected_Baseline", so optimize_from_locked(), the has_locked gate and
    # the per-meter locking checks all continue to work untouched; only the
    # resolution below is new.
    #
    # A legacy single column is read as the INDIVIDUAL selection. That's the
    # correct reading: before the split there was no way to lock an aggregate
    # baseline at all, so every "1" in an old file came from a per-meter model
    # (or from the write-back bug that leaked aggregate selections onto meter
    # rows — which this split is what fixes).
    _norm_sb = lambda v: "1" if str(v).strip() in ("1", "1.0") else ""

    if "Individual_Selected_Baseline" in df.columns:
        df["Selected_Baseline"] = df["Individual_Selected_Baseline"].apply(_norm_sb)
        df = df.drop(columns=["Individual_Selected_Baseline"])
    elif "Selected_Baseline" in df.columns:
        df["Selected_Baseline"] = df["Selected_Baseline"].apply(_norm_sb)
        print("[INFO] Input has a legacy single 'Selected Baseline' column — "
              "reading it as the individual-meter selection. Add "
              "'Individual Selected Baseline' and 'Aggregated Selected Baseline' "
              "columns to lock aggregate baselines separately.")

    # Aggregated selections are read and carried through, but nothing consumes
    # them yet — aggregates still re-optimize on every run (see the aggregate
    # block in run_analysis, which calls optimize() directly and has no
    # optimize_from_locked() equivalent). Normalising here so the column
    # round-trips cleanly and is ready when that lands.
    if "Aggregated_Selected_Baseline" in df.columns:
        df["Aggregated_Selected_Baseline"] = \
            df["Aggregated_Selected_Baseline"].apply(_norm_sb)
    # ───────────────────────────────────────────────────────────────────────

    has_locked = (
        "Selected_Baseline" in df.columns
        and (df["Selected_Baseline"] == "1").any()
    )

    return df, df_original, has_locked, cost_only_flagged_sites


def _convert_units(df: pd.DataFrame) -> pd.DataFrame:
    if "Consumption_Unit" not in df.columns:
        return df
    df = df.copy()
    for unit_raw, idx in df.groupby("Consumption_Unit").groups.items():
        factor = UNIT_CONVERSIONS.get(str(unit_raw).strip().lower())
        if factor and factor != 1.0:
            df.loc[idx, "Consumption"] *= factor
    return df


