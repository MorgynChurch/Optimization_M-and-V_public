def build_meter_weight_rows(site, service_type, meter_weights, ind_results,
                             site_data, agg_weight_flag):
    rows = []
    for meter_num, res, _ in ind_results:
        m_key   = str(meter_num)
        weight  = meter_weights.get(m_key, 0.0)
        bl_df   = site_data[(site_data["Meter_Number"] == meter_num) &
                             (site_data["Baseline_Bill"] == 1)]
        bl_cons = float(bl_df["Consumption"].sum()) if len(bl_df) > 0 else 0.0
        ws      = "Baseline consumption" if bl_cons > 0 else "No baseline bills — weight is 0%"
        rows.append({
            "Site Name":               site,
            "Meter Number":            m_key,
            "Service Type":            service_type,
            "Baseline Consumption":    round(bl_cons, 2),
            "Meter Weight (%)":        round(weight * 100, 2),
            "Weight Source":           ws,
            "Individual Model Passes": res["passes_all"],
            "Individual R2":           round(res["r2"], 4),
            "Individual CV-RMSE":      round(res["cvrmse"], 2),
            "Individual Pct Avoided":  round(res["pct_avoided"], 2),
            "Coverage Flag":           low_coverage_flag(weight, res["passes_all"]),
            "Aggregate Weight Flag":   agg_weight_flag,
        })
    return rows


def build_notes(ind_results, agg_res, meter_count):
    ind_pass  = sum(1 for _, r, _ in ind_results if r["passes_all"])
    total_ind = len(ind_results)
    agg_pass  = agg_res["passes_all"]
    avg_r2    = np.mean([r["r2"] for _, r, _ in ind_results]) if ind_results else 0
    avg_sav   = np.mean([r["pct_avoided"] for _, r, _ in ind_results if r["passes_all"]]) if ind_pass > 0 else 0

    if   ind_pass == total_ind and agg_pass:     qual = f"All {total_ind} individual and aggregated pass quality"
    elif ind_pass > 0 and agg_pass:              qual = f"{ind_pass}/{total_ind} individual and aggregated pass quality"
    elif agg_pass and ind_pass == 0:             qual = f"Only aggregated passes (all {total_ind} individual fail)"
    elif ind_pass == total_ind and not agg_pass: qual = f"All {total_ind} individual pass; aggregated fails"
    else:                                        qual = f"{ind_pass}/{total_ind} individual pass; aggregated {'passes' if agg_pass else 'fails'}"

    parts = [qual, f"Avg individual R²={avg_r2:.2f}, Aggregated R²={agg_res['r2']:.2f}"]
    if agg_pass and ind_pass > 0:
        parts.append(f"Avg individual savings={avg_sav:.1f}%, Aggregated={agg_res['pct_avoided']:.1f}%")
    return " | ".join(parts)


def backfill_original_weather(df_original: pd.DataFrame,
                              proc_df: pd.DataFrame) -> pd.DataFrame:
    """
    Copy the post-merge_weather() HDD/CDD back onto df_original.

    WHY THIS EXISTS
      In the 'Input' / 'Input_GEM' branches of _sigma_main(), df_original is
      snapshotted inside preprocess() — BEFORE merge_weather() runs. Only
      proc_df gets the Sigma-sourced HDD/CDD; df_original keeps whatever the
      Input table's own HDD/CDD columns happened to hold. Since
      input_with_baseline is built from df_original, that table has been
      publishing weather values the models were never fitted on.

      Measured on the 2026-07-13 run: of 1,080 rows that could be matched
      between input_with_baseline and the bills tables, 1,059 (98.1%) had
      different HDD/CDD — every one of them flagged Weather Source = 'Sigma'.
      e.g. URB041 / 6906426 / 2026-05-06 was published as HDD 45.1 but the
      model was actually fitted on HDD 49.1.

      This matters twice over: input_with_baseline is meant to be an honest
      record of the run, and it's meant to be saved and re-uploaded. Re-upload
      it through the 'sigma' weather path and the wrong values are harmlessly
      overwritten; re-upload it through the 'csv' path and the models silently
      shift.

    JOIN KEY
      (Site_Name, Period_Start_Date, Period_End_Date) — the same triple
      merge_weather() itself joins on. Deliberately NOT keyed on
      Meter_Number: weather is a property of the site's billing window, every
      meter at a site shares it, and Meter_Number is legitimately null in some
      inputs (keying on it would reintroduce the null-meter join problems seen
      elsewhere in this script). Period_End_Date is required in the key for
      the same reason merge_weather needs it — electric and gas at one site
      can share a Period_Start_Date but end on different days.

    SCOPE
      Overwrites HDD/CDD only where they already exist as columns on
      df_original, and only where proc_df has a value. Does NOT add the
      columns when the input lacks them, and does NOT copy the derived
      'Weather Source' column across — both would change the shape of
      input_with_baseline, which is a separate decision.

    No-op for the 'Uploaded File' branch, which never calls merge_weather()
    and therefore has nothing to backfill.
    """
    if df_original is None or len(df_original) == 0 or proc_df is None:
        return df_original

    # df_original keeps the input's ORIGINAL header text ("Site Name",
    # "Period_Start_Date", ...), so resolve columns the same fuzzy way
    # build_input_with_baseline does rather than assuming the renamed form.
    _sc = next((c for c in df_original.columns
                if c.lower().replace("_", " ") == "site name"), None)
    _ps = next((c for c in df_original.columns
                if "start" in c.lower() and "period" in c.lower()), None)
    _pe = next((c for c in df_original.columns
                if "end" in c.lower() and "period" in c.lower()), None)
    _hd = next((c for c in df_original.columns if c.strip().upper() == "HDD"), None)
    _cd = next((c for c in df_original.columns if c.strip().upper() == "CDD"), None)

    needed = {"Site_Name", "Period_Start_Date", "Period_End_Date", "HDD", "CDD"}
    if not (_sc and _ps and _pe) or not (_hd or _cd) or not needed.issubset(proc_df.columns):
        return df_original

    out = df_original.copy()
    key = ["_bf_site", "_bf_ps", "_bf_pe"]

    # Both sides MUST go through the same normalisation preprocess() applies at
    # the top of the script (to_datetime(utc=True) -> tz_convert(None)).
    # df_original is a snapshot taken BEFORE that normalisation runs, so when
    # the input arrives from Snowflake its dates are tz-aware (datetime64[ns,
    # UTC]) while proc_df's have already been flattened to naive. Merging one
    # against the other raises:
    #   "You are trying to merge on datetime64[ns, UTC] and datetime64[ns]
    #    columns for key '_bf_ps'"
    # A plain to_datetime() is NOT enough — it preserves whatever tz is already
    # there. Round-tripping through utc=True makes naive and aware inputs land
    # on the same naive values either way.
    def _naive(s):
        return pd.to_datetime(s, errors="coerce", utc=True).dt.tz_convert(None)

    out["_bf_site"] = out[_sc].astype(str)
    out["_bf_ps"]   = _naive(out[_ps])
    out["_bf_pe"]   = _naive(out[_pe])

    # One weather row per (site, period). merge_weather already guarantees
    # uniqueness on this triple; drop_duplicates is belt-and-braces so a stray
    # duplicate can never fan the left join out and multiply input rows.
    lut = proc_df[list(needed)].copy()
    lut["_bf_site"] = lut["Site_Name"].astype(str)
    lut["_bf_ps"]   = _naive(lut["Period_Start_Date"])
    lut["_bf_pe"]   = _naive(lut["Period_End_Date"])
    lut = (lut.drop_duplicates(subset=key)[key + ["HDD", "CDD"]]
              .rename(columns={"HDD": "_bf_hdd", "CDD": "_bf_cdd"}))

    # Cheap insurance against this whole class of failure recurring silently.
    for c in ("_bf_ps", "_bf_pe"):
        assert out[c].dtype == lut[c].dtype, (
            f"backfill_original_weather: join key {c} dtype mismatch "
            f"({out[c].dtype} vs {lut[c].dtype})")

    n_before = len(out)
    out = out.merge(lut, on=key, how="left")
    assert len(out) == n_before, (
        "backfill_original_weather fanned out the input — the weather lookup "
        "is not unique on (Site_Name, Period_Start_Date, Period_End_Date)")

    changed = 0
    for src, dst in ((("_bf_hdd"), _hd), (("_bf_cdd"), _cd)):
        if not dst:
            continue
        upd = out[src].notna()
        changed += int((pd.to_numeric(out.loc[upd, dst], errors="coerce")
                        != out.loc[upd, src]).sum())
        out.loc[upd, dst] = out.loc[upd, src]

    out = out.drop(columns=key + ["_bf_hdd", "_bf_cdd"])
    if changed:
        print(f"[INFO] input_with_baseline: corrected HDD/CDD on {changed} value(s) "
              f"to the enriched weather the models were actually fitted on.")
    return out


# ── input_with_baseline builder ───────────────────────────────────────────────

def build_input_with_baseline(df_original, selected_baseline_keys,
                              cost_only_flagged_sites=None,
                              aggregated_baseline_keys=None):
    """
    Returns df_original with clean Individual/Aggregated Selected Baseline
    columns stamped.
    Existing "1" values in the input are preserved; new selections from
    this run are added. Blank/NaN entries become "".

    Sites that consolidated cleanly during cost-only processing (i.e. are
    NOT in cost_only_flagged_sites) are also consolidated HERE — PUBLISHER
    + PASS_THROUGH combined into one row, Consumption taken from PUBLISHER
    only, Total Charges summed — mirroring exactly what optimization ran
    against, so a corrected re-upload doesn't have to redo that math.
    Flagged sites are deliberately left split/untouched, exactly as
    uploaded, since they're the ones the user still needs to review and
    correct in this exported file before re-running.
    """
    cost_only_flagged_sites  = cost_only_flagged_sites or set()
    aggregated_baseline_keys = aggregated_baseline_keys or set()
    iwb = df_original.copy()

    _sc = next((c for c in iwb.columns if c.lower().replace("_", " ") == "site name"), None)
    _mc = next((c for c in iwb.columns if "meter" in c.lower()), None)
    _pc = next((c for c in iwb.columns if "start" in c.lower() and "period" in c.lower()), None)

    # ── Cost-only (PUBLISHER/PASS_THROUGH) consolidation for display ───────
    # Reuses consolidate_cost_only_bills() itself (rather than duplicating
    # its grouping logic) by temporarily renaming the columns it needs onto
    # df_original's own header text, then renaming the result back. The SET
    # of flagged sites is always taken from the caller — already computed
    # once, authoritatively, in preprocess() — never recomputed here, so
    # there's no risk of a second, possibly-divergent flagging decision;
    # this block only ever uses its own local run for the merged Total
    # Charges values on the non-flagged side.
    _pend = next((c for c in iwb.columns if "end" in c.lower() and "period" in c.lower()), None)
    _svc  = next((c for c in iwb.columns if c.lower().replace("_", " ") == "service type"), None)
    _chg  = next((c for c in iwb.columns if "charge" in c.lower()), None)
    _cls  = next((c for c in iwb.columns
                  if c.lower().replace(" ", "_") == COST_ONLY_CLASSIFICATION_COL.lower()), None)

    if _sc and _mc and _pc and _pend and _svc and _chg and _cls:
        _rename = {_sc: "Site_Name", _mc: "Meter_Number", _pc: "Period_Start_Date",
                   _pend: "Period_End_Date", _svc: "Service_Type", _chg: "Total_Charges",
                   _cls: COST_ONLY_CLASSIFICATION_COL}
        _unrename = {v: k for k, v in _rename.items()}

        _tmp = iwb.rename(columns=_rename)
        _tmp["Total_Charges"] = pd.to_numeric(
            _tmp["Total_Charges"].astype(str).str.replace(r"[\$,]", "", regex=True).str.strip(),
            errors="coerce")
        _consolidated, _ = consolidate_cost_only_bills(_tmp)
        # Belt-and-suspenders: regardless of what this local run decided,
        # never let a flagged site come through consolidated, and always
        # bring every flagged site's original rows back in untouched.
        _consolidated = _consolidated[~_consolidated["Site_Name"].isin(cost_only_flagged_sites)]
        _flagged_raw  = _tmp[_tmp["Site_Name"].isin(cost_only_flagged_sites)]
        iwb = pd.concat([_consolidated, _flagged_raw], ignore_index=True).rename(columns=_unrename)
    # ─────────────────────────────────────────────────────────────────────

    # ── Preserve any "1"s already in the uploaded file ─────────────────────
    # Captured BEFORE the columns are dropped and rebuilt, so a re-uploaded
    # file doesn't lose locks from earlier runs. Legacy single-column files map
    # onto the individual side (see preprocess for why that's the right read).
    def _find_sb_col(*wanted):
        for w in wanted:
            hit = next((c for c in iwb.columns
                        if c.lower().replace(" ", "_") == w), None)
            if hit:
                return hit
        return None

    ind_col = _find_sb_col("individual_selected_baseline", "selected_baseline")
    agg_col = _find_sb_col("aggregated_selected_baseline")

    def _existing(col):
        found = {}
        if col and _sc and _pc:
            for _, r in iwb.iterrows():
                if str(r.get(col, "")).strip() in ("1", "1.0"):
                    sv = str(r.get(_sc, ""))
                    pv = str(pd.to_datetime(r.get(_pc, ""), errors="coerce").date())
                    mv = str(r.get(_mc, "")) if _mc else ""
                    found[(sv, mv, pv)] = "1"
        return found

    existing_ind = _existing(ind_col)
    existing_agg = _existing(agg_col)

    iwb = iwb.drop(columns=[c for c in iwb.columns
                            if c.lower().replace(" ", "_") in
                            ("selected_baseline", "individual_selected_baseline",
                             "aggregated_selected_baseline")])
    iwb[IND_SB_COL] = ""
    iwb[AGG_SB_COL] = ""

    if _sc and _pc:
        # Both models want to mark the SAME row: one row is one meter's bill for
        # one period, and a period can be in a meter's own baseline, the site
        # aggregate's baseline, both, or neither. Two independent columns, each
        # answering its own question, is the only representation that survives a
        # round-trip. Writing both into one column is what inflated meters'
        # locked baselines on re-upload.
        def _keys_for(r):
            sv = str(r.get(_sc, ""))
            mv_raw = r.get(_mc, "") if _mc else ""
            # Normalise blank/NaN meter to "N/A" — matches how meter_iter labels no-meter sites
            mv = "N/A" if (mv_raw is None or str(mv_raw).strip() in ("", "nan", "NaN"))\
                 else str(mv_raw)
            pv = str(pd.to_datetime(r.get(_pc, ""), errors="coerce").date())
            return (sv, mv, pv)

        def _mark_ind(r):
            k = _keys_for(r)
            return "1" if (k in selected_baseline_keys or existing_ind.get(k) == "1") else ""

        def _mark_agg(r):
            k = _keys_for(r)
            return "1" if (k in aggregated_baseline_keys or existing_agg.get(k) == "1") else ""

        iwb[IND_SB_COL] = iwb.apply(_mark_ind, axis=1)
        iwb[AGG_SB_COL] = iwb.apply(_mark_agg, axis=1)

    orig_cols = [c for c in df_original.columns
                 if c.lower().replace(" ", "_") not in
                 ("selected_baseline", "individual_selected_baseline",
                  "aggregated_selected_baseline")
                 and c in iwb.columns]
    return iwb[orig_cols + [IND_SB_COL, AGG_SB_COL]]


# ── cost_only_review builder ──────────────────────────────────────────────────

def _compute_consolidated_sites(df_original, cost_only_flagged_sites) -> dict:
    """
    Identify sites that had PASS_THROUGH rows and were consolidated
    successfully (i.e. NOT flagged). Returns {site_name: pass_through_count}.
    Empty dict if the classification column isn't present.
    """
    cost_only_flagged_sites = cost_only_flagged_sites or set()
    # Find the Provider Classification column using original (pre-rename) names.
    cls_col = next(
        (c for c in df_original.columns
         if c.lower().replace(" ", "_") == COST_ONLY_CLASSIFICATION_COL.lower()),
        None)
    if cls_col is None:
        return {}
    pt_rows = df_original[df_original[cls_col] == PASS_THROUGH_LABEL]
    if len(pt_rows) == 0:
        return {}
    site_col = next(
        (c for c in df_original.columns
         if c.lower().replace("_", " ") == "site name"), None)
    if site_col is None:
        return {}
    pt_counts = pt_rows.groupby(site_col).size().to_dict()
    return {s: ct for s, ct in pt_counts.items()
            if s not in cost_only_flagged_sites}


def build_cost_only_review_rows(flagged_sites,
                                consolidated_sites=None) -> list:
    """
    Build the cost_only_review output table showing BOTH:
      - successfully-consolidated sites (clean 1:1 PUBLISHER/PASS_THROUGH
        matches that were merged automatically), AND
      - flagged sites (sites skipped entirely from optimization because
        automated consolidation could not be performed safely).

    consolidated_sites is a dict of {site_name: pass_through_row_count} for
    every site where PASS_THROUGH rows were merged cleanly. It defaults to
    an empty dict when no cost-only classification column is present.

    Both are shown in the same table so the user can see the full picture of
    what happened during cost-only processing in one place, rather than
    having to infer "why did 100 rows disappear from input_with_baseline?"
    by cross-referencing input row counts against the flagged list.
    """
    consolidated_sites = consolidated_sites or {}
    rows = []

    # ── Successes: clean 1:1 consolidations ────────────────────────────────
    for s in sorted(consolidated_sites):
        pt_count = consolidated_sites[s]
        rows.append({
            "Site Name":       s,
            "Issue Type":      "Successfully consolidated",
            "Action Required": "No — consolidation completed automatically",
            "Notes": (
                f"Site '{s}' had {pt_count} PASS_THROUGH bill(s) that were "
                f"each matched 1:1 with a PUBLISHER bill for the same billing "
                f"period. Charges were summed (PUBLISHER + PASS_THROUGH); "
                f"Consumption was taken from the PUBLISHER row only. "
                f"{pt_count} PASS_THROUGH row(s) were merged and removed "
                f"from input_with_baseline."
            ),
        })

    # ── Failures: sites that couldn't be consolidated ──────────────────────
    for s in sorted(flagged_sites):
        rows.append({
            "Site Name":       s,
            "Issue Type":      "Cost-only consolidation could not be performed automatically",
            "Action Required": "Yes — site excluded from analysis until source data corrected",
            "Notes": (
                f"Site '{s}' has at least one billing period (Site/Meter/Service/Period "
                f"group) with either more than one PUBLISHER bill, or a PASS_THROUGH "
                f"bill with no matching PUBLISHER bill. Automated PUBLISHER/PASS_THROUGH "
                f"consolidation cannot be performed safely, so this site was skipped "
                f"entirely from optimization and savings calculations. Review the source "
                f"data so each billing period has exactly one PUBLISHER bill (and at most "
                f"one matching PASS_THROUGH bill), then re-run."
            ),
        })

    return rows


# ── Site Meter Key / Recommended (KPI rollup support) ──────────────────────────

def _recommendation_reason(r, agg_preferred_here):
    """
    Why is this row not Recommended?

    States the STATISTICAL defect, never the method. A most-recent-N baseline is
    not disqualified for being most-recent — that rung is the RESPONSE to a
    problem, not the problem. The problem is whatever is actually wrong with the
    data: usually a season the site has no bills for, sometimes weather coverage,
    sometimes the fit itself. Those are the facts an analyst needs in order to
    overrule the tool, and "we used your last 12 bills" is not one of them (it
    lives in Optimization Mode / Seasonal Strategy as a neutral statement of
    method).

    Causes are joined rather than ranked: a baseline that is both seasonally
    lopsided AND a poor fit is a different animal from one that fits beautifully
    on unrepresentative data, and picking a single "primary" cause would hide
    exactly the distinction that decides whether the model is salvageable.
    """
    if r.get("Recommended"):
        return RECOMMENDED_NO_REASON

    reasons = []

    # Not a defect — a de-duplication choice. Stated first because it explains
    # the row without implying anything is wrong with it.
    if agg_preferred_here and r.get("Model Type") == "Individual":
        reasons.append("Aggregate model preferred for this site/fuel "
                       "(this meter's load is already counted in the aggregate)")

    is_gas    = _is_gas(str(r.get("Service Type", "")))
    r2_thresh = GAS_R2_THRESHOLD if is_gas else ELEC_R2_THRESHOLD
    bal_thr   = GAS_SEASONAL_BALANCE_THRESHOLD if is_gas else SEASONAL_BALANCE_THRESHOLD

    def _failed(col):
        v = r.get(col)
        return v is False or v == 0 or str(v).lower() == "false"

    if _failed("Passes Seasonal Balance"):
        # Read the counts off the renamed columns and the balance off the column
        # that now carries it, rather than recomputing. (An earlier version read
        # "Q1 Bills" etc.; when those were renamed to carry their month ranges,
        # the lookup silently returned None and the detail vanished from the
        # reason string, leaving a bare "not seasonally balanced" with nothing to
        # check it against — the exact problem this column set exists to fix.)
        _QCOLS = ["Q1 Bills (Jan-Mar)", "Q2 Bills (Apr-Jun)",
                  "Q3 Bills (Jul-Sep)", "Q4 Bills (Oct-Dec)"]
        q   = [r.get(c) for c in _QCOLS]
        bal = r.get("Seasonal Balance")
        if all(v is not None for v in q) and bal is not None:
            reasons.append(
                f"Baseline is not seasonally balanced — Q1-Q4 bills "
                f"{q[0]}/{q[1]}/{q[2]}/{q[3]}, balance {bal:.2f} against a "
                f"{bal_thr:.2f} minimum")
        else:
            reasons.append("Baseline is not seasonally balanced")

    if _failed("Passes Weather Coverage"):
        reasons.append(
            f"Baseline spans only {r.get('Weather Coverage (%)')}% of the "
            f"{'HDD' if is_gas else 'HDD/CDD'} range it must predict over "
            f"({WEATHER_COVERAGE_THRESHOLD}% minimum)")

    if _failed("Passes R2"):
        reasons.append(f"R2 {r.get('R2')} below the {r2_thresh} minimum")

    if _failed("Passes CV-RMSE"):
        reasons.append(f"CV-RMSE {r.get('CV-RMSE')} above the {CVRMSE_THRESHOLD} maximum")

    # A non-recommended row with no identified cause should not exist, but must
    # never come back blank if it does — blank means "recommended" everywhere
    # else in this column, so an unexplained False would read as its own opposite.
    # Reached when every Passes_* flag is NaN rather than False (a row with no
    # model at all), which _failed() cannot detect since NaN is not False.
    return " | ".join(reasons) if reasons else "Not recommended — reason unavailable"


def _apply_site_meter_key_and_recommended(all_model_rows, aggregated_rows,
                                          baseline_bill_rows, reporting_bill_rows):
    """
    Stamps two columns onto every row across all_models,
    aggregated_models, baseline_bills, and reporting_bills, to support
    building KPI tiles that don't double-count a site whose meters were
    BOTH modeled individually AND aggregated together.

    "Site Meter Key" — "{Site Name} | {Meter Number} | {Service Type}",
        concatenated. Lets a single Sigma control/filter built on this one
        column drive which meter/aggregate rows count toward site-level KPI
        rollups, rather than needing compound multi-column filter logic.
        This is the column the user filters/selects on manually.

    "Recommended" — a STARTING SUGGESTION for that manual selection only;
        nothing else in this script reads or enforces it. Per (Site Name,
        Service Type) group: if a passing Aggregated model exists, only
        that aggregate row is marked Recommended (its component Individual
        meters are not, since their load is already represented in the
        aggregate). If no Aggregated model exists, or the aggregate exists
        but doesn't pass quality, each Individual meter is marked
        Recommended exactly when its OWN model passes quality. Skipped /
        no-model rows are never Recommended. Sites with no model at all
        (e.g. cost-only-flagged, or no row matched) default to False.

    Mutates the four row-list arguments in place (each a list of dicts).
    Returns None.
    """
    def _key(site, meter, service):
        return f"{site} | {meter} | {service}"

    model_rows = all_model_rows + aggregated_rows

    # ── Stamp keys, and find which (Site, Service Type) groups have a
    # passing Aggregated model ──────────────────────────────────────────────
    passing_agg_groups = set()
    for r in model_rows:
        r["Site Meter Key"] = _key(r.get("Site Name"), r.get("Meter Number"), r.get("Service Type"))
        if r.get("Model Type") == "Aggregated" and bool(r.get("Model Passes Quality")):
            passing_agg_groups.add((r.get("Site Name"), r.get("Service Type")))

    # ── Decide Recommended per model row using that group lookup ───────────
    for r in model_rows:
        group = (r.get("Site Name"), r.get("Service Type"))
        if group in passing_agg_groups:
            r["Recommended"] = (r.get("Model Type") == "Aggregated")
        else:
            r["Recommended"] = bool(r.get("Model Passes Quality"))

    # ── Explain every False ────────────────────────────────────────────────
    # Recommended = False now has four distinct causes (aggregate preferred,
    # unrepresentative baseline, poor fit, no model at all), and a bare False
    # can't tell an analyst which. Skip rows already carry their specific cause,
    # set at construction in build_skipped_model_row(), so don't overwrite it.
    for r in model_rows:
        if r.get("Recommendation Reason"):
            continue
        r["Recommendation Reason"] = _recommendation_reason(
            r, (r.get("Site Name"), r.get("Service Type")) in passing_agg_groups)

    # ── Propagate onto bill rows by (Site Name, Meter Number, Service Type) ─
    recommended_lookup = {
        (r.get("Site Name"), r.get("Meter Number"), r.get("Service Type")):
            (r["Recommended"], r.get("Recommendation Reason", ""))
        for r in model_rows
    }
    # Bill rows for a SKIPPED aggregate are labelled just "AGGREGATED", while the
    # model row that explains them says "AGGREGATED (2)" — the meter count is only
    # known once aggregation succeeds. The exact-key lookup therefore missed them
    # and they fell to the (False, "") default: not recommended, and no reason,
    # despite build_skipped_model_row() having set a perfectly good one on the
    # model row. Two URB039 rows landed in that hole. Same label-resolution
    # problem as the aggregate baseline write-back, in a different lookup.
    # aggregate_site() stamps Meter_Number = "AGGREGATED" on every row it builds,
    # so bill rows can carry that literal while the model row explaining them is
    # labelled something else entirely. Two different mismatches:
    #   CONCURRENT — model says "AGGREGATED (2)"; the meter count isn't known
    #                until aggregation succeeds, so a SKIPPED aggregate's bills
    #                say plain "AGGREGATED".
    #   SEQUENTIAL — not an aggregate at all, just two meters stitched into one
    #                timeline, so the model row is labelled with the concatenated
    #                meter numbers ("259000-068322, 259000-107067") while its
    #                bills still say "AGGREGATED".
    # Either way the exact-key lookup misses and the row falls to the default,
    # losing a reason its model row already has. URB039 hit the sequential case.
    by_site_svc = {}
    for (st, mt, sv), val in recommended_lookup.items():
        by_site_svc.setdefault((st, sv), []).append((mt, val))

    def _resolve(site, meter, svc):
        hit = recommended_lookup.get((site, meter, svc))
        if hit is not None:
            return hit
        if not str(meter).startswith("AGGREGATED"):
            return None
        cands = by_site_svc.get((site, svc), [])
        # Prefer a real aggregate model row when one exists (concurrent case).
        agg = [v for m, v in cands if str(m).startswith("AGGREGATED")]
        if len(agg) == 1:
            return agg[0]
        # Otherwise accept the site/fuel's model only if it is UNAMBIGUOUS — one
        # model row means one thing these bills can belong to (sequential case).
        # Never guess when several models share a site/fuel.
        if len(cands) == 1:
            return cands[0][1]
        return None

    for bill_list in (baseline_bill_rows, reporting_bill_rows):
        for r in bill_list:
            site, meter, svc = r.get("Site Name"), r.get("Meter Number"), r.get("Service Type")
            hit = _resolve(site, meter, svc)
            rec, reason = hit if hit is not None else (False, "Not recommended — reason unavailable")
            r["Site Meter Key"] = _key(site, meter, svc)
            r["Recommended"] = rec
            r["Recommendation Reason"] = reason


# ── Main analysis ─────────────────────────────────────────────────────────────

def run_analysis(df: pd.DataFrame,
                 already_preprocessed: bool = False,
                 df_original: pd.DataFrame = None,
                 has_locked: bool = None,
                 cost_only_flagged_sites: set = None) -> dict:
    if already_preprocessed:
        # Caller (Sigma weather path) has already run preprocess() and
        # merge_weather(); df_original, has_locked, and cost_only_flagged_sites
        # are passed in directly since preprocess() ran before merge_weather().
        df = infer_flags(df)
        cost_only_flagged_sites = cost_only_flagged_sites or set()
    else:
        df, df_original, has_locked, cost_only_flagged_sites = preprocess(df)
        df = infer_flags(df)

    all_model_rows, aggregated_rows        = [], []
    baseline_bill_rows, reporting_bill_rows = [], []
    outlier_rows, meter_weight_rows         = [], []
    selected_baseline_keys                  = set()
    # Aggregate selections are kept in their OWN set and written to their OWN
    # column. Previously they were added to selected_baseline_keys alongside
    # the per-meter models' picks, so on write-out a meter's row got a "1" if
    # EITHER its own model or the site's aggregate had chosen that period.
    # Re-uploading that file then locked the meter onto the union: URB002's
    # 5888384 re-fitted on 21 bills instead of the 18 its model actually used,
    # URB009's 256000-216852 on 17 instead of 13 (R2 0.75 -> 0.41). One column
    # cannot hold two models' selections.
    aggregated_baseline_keys                = set()

    # Sites with more than one PUBLISHER bill in any period group (see
    # consolidate_cost_only_bills) are skipped entirely from optimization
    # below — they still get bare bill rows in baseline_bills/reporting_bills
    # (built directly from raw data, no model) so the bills themselves remain
    # visible, but Selected Baseline stays blank for them in
    # input_with_baseline since they never enter selected_baseline_keys.
    cost_only_flagged_sites = cost_only_flagged_sites or set()

    # ── Exclude sites with no weather data from either source ─────────────────
    # A site is excluded if every one of its rows has NaN for both HDD and CDD.
    # Partial coverage (some rows have data, some don't) is allowed through —
    # the optimizer will handle sparse weather via the weather coverage gate.
    if "HDD" in df.columns and "CDD" in df.columns:
        no_weather_mask  = df["HDD"].isna() & df["CDD"].isna()
        no_weather_sites = (
            df[no_weather_mask]["Site_Name"]
            .dropna()
            .unique()
        )
        # Only exclude a site if ALL of its rows lack weather data.
        fully_excluded = sorted([
            s for s in no_weather_sites
            if df[df["Site_Name"] == s]["HDD"].isna().all()
            and df[df["Site_Name"] == s]["CDD"].isna().all()
        ])
        if fully_excluded:
            print(
                f"\n[WARNING] The following {len(fully_excluded)} site(s) have no HDD/CDD "
                f"data from any source and will be excluded from all calculations:\n"
                + "\n".join(f"  - {s}" for s in fully_excluded)
                + "\n"
            )
            df = df[~df["Site_Name"].isin(fully_excluded)].copy()
    # ──────────────────────────────────────────────────────────────────────────

    if cost_only_flagged_sites:
        print(
            f"\n[WARNING] The following {len(cost_only_flagged_sites)} site(s) could "
            f"not have their PUBLISHER/PASS_THROUGH bills automatically consolidated "
            f"(a billing period had more than one PUBLISHER bill, or a PASS_THROUGH "
            f"bill with no matching PUBLISHER bill). They will be SKIPPED from "
            f"optimization and savings calculations. See the 'cost_only_review' "
            f"output table for details — these require manual review/correction of "
            f"the source data before re-running:\n"
            + "\n".join(f"  - {s}" for s in sorted(cost_only_flagged_sites))
            + "\n"
        )

    # ── Locked-baseline summary ─────────────────────────────────────────────
    # has_locked (file-wide: "does ANY row anywhere have Selected_Baseline=='1'")
    # no longer drives the optimize_from_locked() vs optimize() routing decision
    # below — that's now made per meter/site (see the meter_is_locked check
    # further down), so a single locked site can no longer cause every other
    # site in the file to be wrongly skipped. has_locked is kept purely as an
    # informational summary here so a re-run's console output makes the mix
    # of locked-vs-fresh sites visible at a glance.
    if has_locked and "Selected_Baseline" in df.columns:
        locked_sites = sorted(
            df.loc[df["Selected_Baseline"] == "1", "Site_Name"].dropna().unique()
        )
        print(
            f"\n[INFO] {len(locked_sites)} site(s) have a locked baseline "
            f"(Selected Baseline = 1) and will be reconstructed from those "
            f"locked bills rather than re-optimized:\n"
            + "\n".join(f"  - {s}" for s in locked_sites)
            + "\nAll other sites in this file will be optimized fresh.\n"
        )
    # ─────────────────────────────────────────────────────────────────────────

    # Iterate over canonical service categories (gas vs electric), not raw
    # string values. Multiple raw spellings that collapse to the same
    # category via the "gas"/"elec" substring match (e.g. "Electric" and
    # "Electricity") must only be processed ONCE per run — looping over
    # df["Service_Type"].unique() directly reprocesses the entire
    # substring-matched category once per raw spelling, producing exact
    # duplicate rows in every output table for that category.
    seen_categories = set()
    for raw_service_type in df["Service_Type"].dropna().unique():
        is_gas = _is_gas(raw_service_type)
        if is_gas in seen_categories:
            continue
        seen_categories.add(is_gas)

        svc_df      = df[df["Service_Type"].str.lower().str.contains(
                          "gas" if is_gas else "elec", na=False)].copy()
        bl_count    = GAS_BASELINE_COUNT if is_gas else ELEC_BASELINE_COUNT
        r2_thresh   = GAS_R2_THRESHOLD   if is_gas else ELEC_R2_THRESHOLD
        display_svc = "Natural Gas" if is_gas else "Electricity"

        for site in sorted(svc_df["Site_Name"].dropna().unique()):
            site_data   = svc_df[svc_df["Site_Name"] == site].copy()

            # ── Cost-only skip: site has more than one PUBLISHER bill for a
            # billing period (see cost_only_review table). Skip entirely from
            # optimization — don't fit any models, don't select any baseline
            # bills — but still surface the raw bills themselves in
            # baseline_bills/reporting_bills so the data isn't simply
            # invisible to the user. selected_baseline_keys is intentionally
            # NOT updated here, so input_with_baseline correctly leaves
            # Selected Baseline blank for this site.
            if site in cost_only_flagged_sites:
                skip_bl_rows, skip_rep_rows = build_cost_only_skip_rows(
                    site_data, site, display_svc)
                baseline_bill_rows  += skip_bl_rows
                reporting_bill_rows += skip_rep_rows
                continue
            # ─────────────────────────────────────────────────────────────

            meter_nums  = [m for m in site_data["Meter_Number"].dropna().unique()]
            meter_count = len(meter_nums)
            concurrent  = meters_concurrent(site_data) if meter_count > 1 else False

            ind_results_for_site = []

            if meter_count == 0 or (meter_count == 1 and pd.isna(meter_nums[0])):
                meter_iter = [("N/A", site_data)]
            elif not concurrent and meter_count > 1:
                meter_iter = [(", ".join(sorted(str(m) for m in meter_nums)),
                               aggregate_site(site_data))]
            else:
                meter_iter = [(m, site_data[site_data["Meter_Number"] == m])
                              for m in sorted(meter_nums, key=str)]

            for meter_num, meter_data in meter_iter:
                sequential = not concurrent and meter_count > 1

                # Locking is decided per meter/site, not file-wide. A re-uploaded
                # file will commonly contain a MIX of sites that already have a
                # locked baseline (manually reviewed/corrected) and sites that
                # still need a fresh optimization pass. The old file-wide
                # has_locked flag routed EVERY site through optimize_from_locked()
                # the moment any single site had a "1" anywhere — sites with no
                # locked rows of their own then found nothing to reconstruct from
                # and were skipped entirely, instead of falling through to a
                # fresh optimize() run. See project discussion 2026-06: this is
                # the exact failure mode hit when re-uploading input_with_baseline
                # after only some sites had been manually reviewed.
                meter_is_locked = (
                    "Selected_Baseline" in meter_data.columns
                    and (meter_data["Selected_Baseline"] == "1").any()
                )
                if meter_is_locked:
                    res, bl_out, rep_out, skip_reason = optimize_from_locked(
                        f"{site}__{meter_num}", display_svc, meter_data, r2_thresh)
                else:
                    res, bl_out, rep_out, skip_reason = optimize(
                        f"{site}__{meter_num}", display_svc, meter_data, bl_count, r2_thresh)

                if res is None:
                    # No model could be fit (insufficient baseline data, no
                    # combination passed quality gates, etc.). Previously this
                    # site/meter vanished from every output table with zero
                    # trace. Now: still record it in all_models (with
                    # model-dependent columns blank, see build_skipped_model_row),
                    # so the user can distinguish "skipped, here's why" from
                    # "succeeded." The skip is NOT also written to outliers — that
                    # table lists bad BILLS, and a skip is a property of the
                    # site/meter, not of any one bill.
                    # Any pre-skip outliers gathered (bl_out/rep_out, e.g. NaN-
                    # weather drops) are still recorded too, same as before.
                    # The raw bills themselves still flow into baseline_bills/
                    # reporting_bills (no model, so Predicted Consumption etc.
                    # stay blank) so the bills aren't invisible just because
                    # no model could be fit from them.
                    skip_row = build_skipped_model_row(
                        site, meter_num, "Individual", display_svc, skip_reason)
                    all_model_rows.append(skip_row)
                    skip_bl_rows, skip_rep_rows = build_skip_bill_rows(
                        meter_data, site, display_svc,
                        f"Excluded: No model fit — {skip_reason}. See all_models/outliers for detail.")
                    baseline_bill_rows  += skip_bl_rows
                    reporting_bill_rows += skip_rep_rows
                    for o in bl_out + rep_out:
                        outlier_rows.append(build_outlier_row(o, site, meter_num, display_svc))
                    continue

                row = build_result_row(res, site, meter_num, "Individual",
                                       display_svc, bl_count, concurrent, sequential)
                all_model_rows.append(row)
                ind_results_for_site.append((meter_num, res, row))

                baseline_bill_rows  += build_baseline_rows(res, site, meter_num, display_svc)
                reporting_bill_rows += build_reporting_rows(
                    res, site, meter_num, display_svc,
                    model_passes=row["Model Passes Quality"],
                    savings_status=row["Savings Status"])

                for _, _sr in res["selected"].iterrows():
                    sel_date = str(pd.to_datetime(_sr["Period_Start_Date"]).date())
                    selected_baseline_keys.add(
                        (str(site), str(meter_num), sel_date))
                    # Sequential meters: the concatenated meter label (e.g.
                    # "P068071, P159012") won't match any individual input row
                    # in build_input_with_baseline because input rows still
                    # carry their original meter numbers. Resolve back to the
                    # original meter(s) that contributed to each selected period
                    # by matching site + period start date against site_data
                    # (which still has original per-meter rows). Since sequential
                    # meters are non-overlapping by definition, each period maps
                    # to exactly one original meter.
                    if sequential:
                        matching = site_data[
                            site_data["Period_Start_Date"].apply(
                                lambda d: str(pd.to_datetime(d).date())
                            ) == sel_date
                        ]
                        for orig_meter in matching["Meter_Number"].dropna().unique():
                            selected_baseline_keys.add(
                                (str(site), str(orig_meter), sel_date))

                for o in bl_out + rep_out:
                    outlier_rows.append(build_outlier_row(o, site, meter_num, display_svc))

            # Meter weighting (concurrent only)
            if concurrent and meter_count > 1 and ind_results_for_site:
                mw = calc_meter_weights(site_data, [m for m, _, _ in ind_results_for_site])
                for r in all_model_rows:
                    if (r["Site Name"] == site and r["Service Type"] == display_svc
                            and r["Model Type"] == "Individual"):
                        w = mw.get(str(r["Meter Number"]), 0.0)
                        r["Meter Weight (%)"] = round(w * 100, 2)
                        r["Coverage Flag"]    = low_coverage_flag(w, r["Model Passes Quality"])
            else:
                mw = {}

            # Aggregated model (concurrent only)
            if concurrent and meter_count > 1:
                # Only pool meters that individually clear the baseline-bill-
                # count threshold (12 electric / 8 gas) into the aggregate.
                # Concurrent meters share billing periods rather than adding
                # to them, so a meter that's short on its own clean baseline
                # bills can pull an otherwise-solid aggregate down to its own
                # shortfall if it's pooled in unconditionally. Quality
                # (R²/CV-RMSE/weather coverage) is deliberately NOT part of
                # this gate — see _meets_individual_baseline_count — a meter
                # that fails quality individually can still be aggregated,
                # since combining it with others may still produce a model
                # that passes.
                qualifying_meters = [
                    m for m in meter_nums
                    if _meets_individual_baseline_count(
                        site_data[site_data["Meter_Number"] == m], is_gas, bl_count)
                ]
                agg_meter_count = len(qualifying_meters)

                if agg_meter_count < 2:
                    # Not enough qualifying meters to build a meaningful
                    # aggregate (need at least 2). Record why in
                    # all_models/outliers, same as any other
                    # no-model-fit case — but skip adding bare bill rows
                    # here, since there's no real combined-bill series to
                    # show (the individual meters' own bills are already
                    # represented in baseline_bills/reporting_bills from the
                    # per-meter loop above).
                    skip_reason = (
                        f"Only {agg_meter_count}/{meter_count} meter(s) individually "
                        f"reach the {bl_count}-bill baseline count required for "
                        f"{display_svc}; at least 2 qualifying meters are needed "
                        f"to build an aggregate."
                    )
                    skip_row = build_skipped_model_row(
                        site, f"AGGREGATED ({meter_count})", "Aggregated",
                        display_svc, skip_reason)
                    all_model_rows.append(skip_row)
                    # Third and last path that can emit an aggregate row: the
                    # per-meter baseline count gate blocked aggregation before
                    # optimize() was ever reached. It still produces an
                    # "Aggregated" row, so it belongs in aggregated_models like
                    # the other two paths.
                    aggregated_rows.append(skip_row)
                    if mw:
                        meter_weight_rows.extend(
                            build_meter_weight_rows(site, display_svc, mw,
                                                    ind_results_for_site, site_data, "NO AGG MODEL"))
                else:
                    # Drop any period where not all pooled meters have a bill
                    # BEFORE summing. An incomplete period under-states site
                    # load and — because meter presence tends to track the
                    # calendar — biases the weather coefficients rather than
                    # just adding noise. See drop_incomplete_meter_periods.
                    agg_source = site_data[
                        site_data["Meter_Number"].isin(qualifying_meters)]
                    agg_source, coverage_note = drop_incomplete_meter_periods(
                        agg_source, qualifying_meters)
                    agg_data = aggregate_site(agg_source, agg_lock_col=AGG_SB_INTERNAL)

                    # Mirrors the per-meter meter_is_locked check above, read off
                    # the aggregate's OWN column. Until this existed, aggregates
                    # always called optimize() and re-picked their baseline from
                    # scratch on every run — so an aggregate's baseline could
                    # legitimately move between two runs of identical data, which
                    # is not defensible for a frozen IPMVP baseline. Deciding it
                    # per site (not file-wide) means a file mixing reviewed and
                    # un-reviewed aggregates behaves correctly: locked ones
                    # reconstruct, the rest optimize fresh.
                    agg_is_locked = (
                        "Selected_Baseline" in agg_data.columns
                        and (agg_data["Selected_Baseline"] == "1").any()
                    )
                    if agg_is_locked:
                        res, bl_out, rep_out, skip_reason = optimize_from_locked(
                            f"{site}__AGGREGATED", display_svc, agg_data, r2_thresh)
                    else:
                        res, bl_out, rep_out, skip_reason = optimize(
                            f"{site}__AGGREGATED", display_svc, agg_data, bl_count, r2_thresh)

                    if res is not None:
                        row       = build_result_row(res, site, f"AGGREGATED ({agg_meter_count})",
                                                     "Aggregated", display_svc, bl_count, concurrent, False)
                        agg_flag, weight_note = failing_weight_flag(mw, ind_results_for_site)
                        qual_note = build_notes(ind_results_for_site, res, meter_count)
                        row["Weight Flag"] = agg_flag
                        row["Notes"]       = " | ".join(filter(None, [qual_note, weight_note]))
                        if agg_meter_count < meter_count:
                            row["Notes"] = " | ".join(filter(None, [row["Notes"],
                                f"Aggregate built from {agg_meter_count}/{meter_count} meters — "
                                f"{meter_count - agg_meter_count} excluded for not individually "
                                f"reaching the {bl_count}-bill baseline count"
                            ]))
                        # Incomplete-period exclusions are reported even when the
                        # model still fits, so the analyst can see the aggregate
                        # was built on fewer periods than the raw bill count implies.
                        if coverage_note:
                            row["Notes"] = " | ".join(
                                filter(None, [row["Notes"], coverage_note]))

                        for r in all_model_rows:
                            if (r["Site Name"] == site and r["Service Type"] == display_svc
                                    and r["Model Type"] == "Individual"):
                                r["Notes"] = row["Notes"]

                        aggregated_rows.append(row)
                        # Also surface the aggregate in all_models, so a
                        # site's meters and its aggregate can be compared side by
                        # side in one table.
                        #
                        # This corrects an inversion, not just a display gap. The
                        # routing used to be exactly backwards: a FAILED aggregate
                        # landed in all_models (via the skip branch below)
                        # while a SUCCESSFUL one went only to aggregated_models. So
                        # all_models listed an aggregate for URB003/URB007
                        # (both failures) but not for URB002/URB009/URB013 (all
                        # successes) — the aggregate appeared precisely when there
                        # was nothing useful to show. Every aggregate now appears
                        # in all_models regardless of outcome.
                        #
                        # The same dict object is deliberately appended to BOTH
                        # lists rather than a copy: it is one row shown in two
                        # places, and _apply_site_meter_key_and_recommended mutates
                        # rows in place afterwards. Sharing keeps the two tables in
                        # sync by construction. That function tolerates a row
                        # appearing twice in all_model_rows + aggregated_rows —
                        # its three passes are a set-add, a direct assignment, and
                        # a dict comprehension keyed on
                        # (Site Name, Meter Number, Service Type), all idempotent.
                        #
                        # NOTE: aggregated_models is unchanged and still holds only
                        # successful aggregates, so the row now appears in two
                        # tables. Safe today because the KPI tiles source from
                        # reporting_bills, not from a union of the model tables —
                        # but anything that UNIONs all_models with
                        # aggregated_models would now double-count these rows.
                        all_model_rows.append(row)
                        meter_weight_rows.extend(
                            build_meter_weight_rows(site, display_svc, mw,
                                                    ind_results_for_site, site_data, agg_flag))

                        baseline_bill_rows  += build_baseline_rows(
                            res, site, f"AGGREGATED ({agg_meter_count})", display_svc,
                            is_aggregate=True)
                        reporting_bill_rows += build_reporting_rows(
                            res, site, f"AGGREGATED ({agg_meter_count})", display_svc,
                            model_passes=row["Model Passes Quality"],
                            savings_status=row["Savings Status"])

                        for _, _sr in res["selected"].iterrows():
                            sel_date = str(pd.to_datetime(_sr["Period_Start_Date"]).date())
                            # Resolve the synthetic "AGGREGATED" label back to the
                            # real meters pooled into this period — the same thing
                            # the sequential path above does for its concatenated
                            # label. Input rows carry real meter numbers, never
                            # "AGGREGATED", so storing a bare
                            # (site, "AGGREGATED", date) key forced
                            # build_input_with_baseline to fall back on a
                            # site+date-only match. That fallback ignored Service
                            # Type and stamped an ELECTRIC aggregate's selections
                            # onto the site's GAS rows sharing a period start —
                            # observed at URB013, where the gas meter's locked
                            # baseline grew from 11 bills to 12 on write-out.
                            # agg_source is already scoped to this site, this
                            # service type, and only the qualifying meters, so
                            # resolving through it cannot cross those boundaries.
                            matching = agg_source[
                                agg_source["Period_Start_Date"].apply(
                                    lambda d: str(pd.to_datetime(d).date())
                                ) == sel_date
                            ]
                            for orig_meter in matching["Meter_Number"].dropna().unique():
                                aggregated_baseline_keys.add(
                                    (str(site), str(orig_meter), sel_date))

                        for o in bl_out + rep_out:
                            outlier_rows.append(
                                build_outlier_row(o, site, f"AGGREGATED ({agg_meter_count})", display_svc))
                    else:
                        # Aggregated model couldn't be fit either — same skip-row
                        # treatment as the individual-meter case, so this is
                        # visible in all_models/outliers instead of just
                        # silently producing no aggregated_models row.
                        #
                        # If we dropped incomplete periods above, say so. Without
                        # this the skip reason reads "Insufficient baseline data:
                        # only 9 clean baseline bill(s) ... 12 required", which is
                        # true but hides the actual cause — the site HAS 12 raw
                        # periods, 3 of them just aren't whole.
                        if coverage_note:
                            skip_reason = f"{skip_reason} | {coverage_note}"
                        skip_row = build_skipped_model_row(
                            site, f"AGGREGATED ({agg_meter_count})", "Aggregated",
                            display_svc, skip_reason)
                        all_model_rows.append(skip_row)
                        # Symmetry with the success branch above: an aggregate row
                        # now lands in BOTH tables whatever the outcome. Previously
                        # a failed aggregate appeared only in all_models and a
                        # successful one only in aggregated_models, so neither
                        # table was a complete picture — aggregated_models silently
                        # omitted every aggregate that couldn't be fit, which is
                        # exactly the case an analyst most needs to see.
                        # Same shared-dict rationale as the success branch.
                        aggregated_rows.append(skip_row)
                        skip_bl_rows, skip_rep_rows = build_skip_bill_rows(
                            agg_data, site, display_svc,
                            f"Excluded: No aggregated model fit — {skip_reason}. See all_models/outliers for detail.")
                        baseline_bill_rows  += skip_bl_rows
                        reporting_bill_rows += skip_rep_rows
                        for o in bl_out + rep_out:
                            outlier_rows.append(
                                build_outlier_row(o, site, f"AGGREGATED ({agg_meter_count})", display_svc))
                        if mw:
                            meter_weight_rows.extend(
                                build_meter_weight_rows(site, display_svc, mw,
                                                        ind_results_for_site, site_data, "NO AGG MODEL"))

    # Stamp Site Meter Key / Recommended across all four tables now that every
    # site's individual + aggregate attempts (and their corresponding bill
    # rows) are fully built. See _apply_site_meter_key_and_recommended for
    # the precedence rule.
    _apply_site_meter_key_and_recommended(all_model_rows, aggregated_rows,
                                          baseline_bill_rows, reporting_bill_rows)

    run_timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    all_models_df = _safe_df(all_model_rows, "model")
    if len(all_models_df) > 0:
        all_models_df["Last Run Timestamp"] = run_timestamp

    return {
        "all_models":   all_models_df,
        "aggregated_models":   _safe_df(aggregated_rows,    "model"),
        "baseline_bills":      _safe_df(baseline_bill_rows,  "bills"),
        "reporting_bills":     _safe_df(reporting_bill_rows, "bills"),
        "outliers":            _safe_df(outlier_rows,        "outliers"),
        "meter_weights":       _safe_df(meter_weight_rows,   "weights"),
        "input_with_baseline": build_input_with_baseline(
            df_original, selected_baseline_keys, cost_only_flagged_sites,
            aggregated_baseline_keys),
        "cost_only_review":    _safe_df(
            build_cost_only_review_rows(
                cost_only_flagged_sites,
                _compute_consolidated_sites(df_original, cost_only_flagged_sites)),
            "cost_only_review"),
    }


# ── Sigma weather assembly ────────────────────────────────────────────────────

def fetch_sigma_weather() -> pd.DataFrame:
    """
    Read the SITE_DAILY_WEATHER_HISTORY element from the Sigma workbook and
    return it as a DataFrame.

    The element is expected to expose at minimum:
        Icao Id, Date Valid Std, Hdd Lt 65 F, Cdd Gt 65 F

    The join to billing data is made on Icao Id, which maps directly to the
    WeatherStation column present on the Input table. Site Name is not used.

    Returns the raw daily DataFrame, or an empty DataFrame with those four
    columns if the element is missing or empty (triggering full CSV fallback).
    """
    _empty = pd.DataFrame(columns=["Icao Id", "Date Valid Std",
                                    "Hdd Lt 65 F", "Cdd Gt 65 F"])
    try:
        _raw     = sigma.get_element('Weather')  # Must be a string literal (Sigma requirement)
        assert 'Weather' == SIGMA_WEATHER_ELEMENT, \
            f"SIGMA_WEATHER_ELEMENT ('{SIGMA_WEATHER_ELEMENT}') does not match " \
            f"the literal in get_element(). Update both together."
        daily_df = _raw.to_pandas(block=False).result()
    except Exception as e:
        print(f"[WARNING] Could not read Sigma weather element: {e}. "
              f"Falling back to CSV HDD/CDD for all rows.")
        return _empty

    if len(daily_df) == 0:
        print("[WARNING] Sigma weather element is empty. "
              "Falling back to CSV HDD/CDD for all rows.")
        return _empty

    # Sigma returns opaque column IDs rather than human-readable names.
    # Rename only the columns this function needs; leave the rest as-is.
    # IDs sourced from the Weather workbook element schema (element sG67St_HXW).
    WEATHER_COL_MAP = {
        "gJz9orTGQ0": "Icao Id",
        "oF9OD1RK9o": "Date Valid Std",
        "Qgr6EWaBm6": "Hdd Lt 65 F",
        "3VR-mfnB9v": "Cdd Gt 65 F",
    }
    daily_df = daily_df.rename(columns=WEATHER_COL_MAP)

    # Verify all required columns are present after rename.
    required = {"Icao Id", "Date Valid Std", "Hdd Lt 65 F", "Cdd Gt 65 F"}
    missing  = required - set(daily_df.columns)
    if missing:
        print(f"[WARNING] Weather element missing expected columns after rename: {missing}. "
              f"Actual columns received: {list(daily_df.columns)}. "
              f"Falling back to CSV HDD/CDD for all rows.")
        return _empty

    # Normalise types on arrival.
    daily_df["Date Valid Std"] = pd.to_datetime(
        daily_df["Date Valid Std"], errors="coerce", utc=True
    ).dt.tz_convert(None)
    daily_df["Hdd Lt 65 F"] = pd.to_numeric(daily_df["Hdd Lt 65 F"], errors="coerce")
    daily_df["Cdd Gt 65 F"] = pd.to_numeric(daily_df["Cdd Gt 65 F"], errors="coerce")

    return daily_df


def aggregate_weather_to_periods(daily_df: pd.DataFrame,
                                  billing_df: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate daily weather rows to billing period totals.

    Joins on WeatherStation (from billing_df) = Icao Id (from daily_df), then
    sums Hdd Lt 65 F and Cdd Gt 65 F across each billing period window
    (Date Valid Std >= Period_Start_Date AND < Period_End_Date) per site.

    WeatherStation is the ICAO ID lookup column present on the Input table.
    Site_Name is carried through as the output key so merge_weather can join
    back to the billing DataFrame correctly.

    Returns a DataFrame with columns:
        Site_Name, Period Start Date, Period End Date, HDD_sigma, CDD_sigma
    One row per unique (Site_Name, Period Start Date, Period End Date)
    combination. Period End Date is included in the output (and used by
    merge_weather as a join key) because different service types at the same
    site can share the same Period Start Date but have different Period End
    Dates. Without it, merge_weather would fan out a 1:many join and
    duplicate billing rows. Periods with no daily coverage produce NaN for
    both HDD/CDD columns.
    """
    period_keys = (
        billing_df[["Site_Name", "WeatherStation", "Period_Start_Date", "Period_End_Date"]]
        .drop_duplicates()
        .dropna(subset=["Site_Name", "WeatherStation", "Period_Start_Date", "Period_End_Date"])
    )

    if len(period_keys) == 0 or len(daily_df) == 0:
        return pd.DataFrame(columns=["Site_Name", "Period Start Date",
                                     "Period End Date", "HDD_sigma", "CDD_sigma"])

    agg_rows = []
    for _, pk in period_keys.iterrows():
        site    = pk["Site_Name"]
        station = pk["WeatherStation"]
        p_start = pd.to_datetime(pk["Period_Start_Date"])
        p_end   = pd.to_datetime(pk["Period_End_Date"])
        mask    = (
            (daily_df["Icao Id"] == station)
            & (daily_df["Date Valid Std"] >= p_start)
            & (daily_df["Date Valid Std"] <  p_end)
        )
        subset  = daily_df[mask]
        agg_rows.append({
            "Site_Name":         site,
            "Period Start Date": p_start,
            "Period End Date":   p_end,
            "HDD_sigma":         subset["Hdd Lt 65 F"].sum() if len(subset) > 0 else np.nan,
            "CDD_sigma":         subset["Cdd Gt 65 F"].sum() if len(subset) > 0 else np.nan,
        })

    return pd.DataFrame(agg_rows)


def merge_weather(billing_df: pd.DataFrame,
                  weather_df: pd.DataFrame) -> pd.DataFrame:
    """
    Merge Sigma-sourced HDD/CDD into the billing DataFrame.

    Joins on (Site_Name, Period_Start_Date, Period_End_Date). The weather_df
    produced by aggregate_weather_to_periods is already keyed on Site_Name
    (resolved via WeatherStation → Icao Id), so no site name translation is
    needed here. Period_End_Date is included in the join because different
    service types at the same site can share the same Period_Start_Date but
    have different Period_End_Dates (e.g. electric billed to 09/24, gas to
    09/25). Without it, the left join fans out 1:many and duplicates billing
    rows — each duplicate carrying a slightly different HDD/CDD from the
    different-length aggregation window.

    Resolution order per row:
      1. Sigma value (HDD_sigma / CDD_sigma) — used when non-null.
      2. CSV value  (HDD / CDD columns from input) — fallback when Sigma misses.
      3. NaN — if neither source has a value; the NaN warning in preprocess()
               will surface these downstream.

    Adds a 'Weather Source' column: "Sigma", "CSV", or "No Data".
    """
    df = billing_df.copy()

    # Normalise join keys to the same type before merging.
    weather_df = weather_df.copy()
    weather_df["Period Start Date"] = pd.to_datetime(
        weather_df["Period Start Date"], errors="coerce", utc=False
    )
    weather_df["Period End Date"] = pd.to_datetime(
        weather_df["Period End Date"], errors="coerce", utc=False
    )

    df["_join_start"] = pd.to_datetime(
        df["Period_Start_Date"], errors="coerce", utc=False
    )
    df["_join_end"] = pd.to_datetime(
        df["Period_End_Date"], errors="coerce", utc=False
    )

    merged = df.merge(
        weather_df.rename(columns={"Period Start Date": "_join_start",
                                   "Period End Date": "_join_end",
                                   "Site_Name": "_weather_site"}),
        left_on=["Site_Name", "_join_start", "_join_end"],
        right_on=["_weather_site", "_join_start", "_join_end"],
        how="left",
    ).drop(columns=["_weather_site"], errors="ignore")

    # Preserve CSV HDD/CDD values before overwriting so they can serve as
    # fallback. Rename originals to avoid column collision.
    for col in ["HDD", "CDD"]:
        if col in merged.columns:
            merged[f"{col}_csv"] = merged[col]
        else:
            merged[f"{col}_csv"] = np.nan

    sigma_col = {"HDD": "HDD_sigma", "CDD": "CDD_sigma"}
    for col, sig_col in sigma_col.items():
        if sig_col in merged.columns:
            merged[col] = np.where(
                merged[sig_col].notna(), merged[sig_col], merged[f"{col}_csv"]
            )
        else:
            merged[col] = merged[f"{col}_csv"]

    # Tag each row with its weather source for auditability.
    def _source(row):
        if row.get("HDD_sigma") is not None and not (
            isinstance(row.get("HDD_sigma"), float)
            and np.isnan(row.get("HDD_sigma"))
        ):
            return "Sigma"
        if not (isinstance(row.get("HDD_csv"), float)
                and np.isnan(row.get("HDD_csv", np.nan))):
            return "CSV"
        return "No Data"

    merged["Weather Source"] = merged.apply(_source, axis=1)

    sigma_count = (merged["Weather Source"] == "Sigma").sum()
    csv_count   = (merged["Weather Source"] == "CSV").sum()
    no_count    = (merged["Weather Source"] == "No Data").sum()
    print(f"[INFO] Weather resolution — Sigma: {sigma_count}, "
          f"CSV fallback: {csv_count}, No data: {no_count}")
    if no_count > 0:
        print(f"[WARNING] {no_count} row(s) have no HDD/CDD from either "
              f"source and will be treated as NaN.")

    merged = merged.drop(
        columns=[c for c in ["HDD_sigma", "CDD_sigma", "HDD_csv",
                             "CDD_csv", "_join_start", "_join_end"] if c in merged.columns]
    )
    return merged


# ── Sigma entry point ─────────────────────────────────────────────────────────

def _sigma_main():
    if SIGMA_INPUT_ELEMENT == "Uploaded File":
        _raw     = sigma.get_element('Uploaded File')  # Must be a string literal (Sigma requirement)
        input_df = _raw.to_pandas(block=False).result()
        results  = run_analysis(input_df)

    elif SIGMA_INPUT_ELEMENT == "Input_GEM":
        _raw     = sigma.get_element('Input_GEM')  # Must be a string literal (Sigma requirement)
        assert 'Input_GEM' == SIGMA_INPUT_ELEMENT, \
            f"SIGMA_INPUT_ELEMENT ('{SIGMA_INPUT_ELEMENT}') does not match the literal in get_element(). Update both together."
        input_df = _raw.to_pandas(block=False).result()

        proc_df, df_original, has_locked, cost_only_flagged_sites = preprocess(input_df)
        daily_weather_df = fetch_sigma_weather()
        weather_df       = aggregate_weather_to_periods(daily_weather_df, proc_df)
        proc_df          = merge_weather(proc_df, weather_df)
        # df_original was snapshotted inside preprocess(), i.e. BEFORE the line
        # above enriched proc_df's weather. Without this, input_with_baseline
        # publishes the Input table's raw HDD/CDD rather than the values the
        # models were fitted on. See backfill_original_weather.
        df_original      = backfill_original_weather(df_original, proc_df)
        results          = run_analysis(proc_df, already_preprocessed=True,
                                        df_original=df_original,
                                        has_locked=has_locked,
                                        cost_only_flagged_sites=cost_only_flagged_sites)

    elif SIGMA_INPUT_ELEMENT == "Input":
        _raw     = sigma.get_element('Input')  # Must be a string literal (Sigma requirement)
        assert 'Input' == SIGMA_INPUT_ELEMENT, \
            f"SIGMA_INPUT_ELEMENT ('{SIGMA_INPUT_ELEMENT}') does not match the literal in get_element(). Update both together."
        input_df = _raw.to_pandas(block=False).result()

        proc_df, df_original, has_locked, cost_only_flagged_sites = preprocess(input_df)
        daily_weather_df = fetch_sigma_weather()
        weather_df       = aggregate_weather_to_periods(daily_weather_df, proc_df)
        proc_df          = merge_weather(proc_df, weather_df)
        # df_original was snapshotted inside preprocess(), i.e. BEFORE the line
        # above enriched proc_df's weather. Without this, input_with_baseline
        # publishes the Input table's raw HDD/CDD rather than the values the
        # models were fitted on. See backfill_original_weather.
        df_original      = backfill_original_weather(df_original, proc_df)
        results          = run_analysis(proc_df, already_preprocessed=True,
                                        df_original=df_original,
                                        has_locked=has_locked,
                                        cost_only_flagged_sites=cost_only_flagged_sites)

    else:
        raise ValueError(
            f"Unrecognized SIGMA_INPUT_ELEMENT: '{SIGMA_INPUT_ELEMENT}'. "
            f"Expected one of: 'Input', 'Input_GEM', 'Uploaded File'."
        )

    sigma.output('all_models',   results['all_models'])
    sigma.output('aggregated_models',   results['aggregated_models'])
    sigma.output('baseline_bills',      results['baseline_bills'])
    sigma.output('reporting_bills',     results['reporting_bills'])
    sigma.output('outliers',            results['outliers'])
    sigma.output('meter_weights',       results['meter_weights'])
    sigma.output('input_with_baseline', results['input_with_baseline'])
    sigma.output('cost_only_review',    results['cost_only_review'])


# ── Local entry point ─────────────────────────────────────────────────────────

def _local_main():
    import tkinter as tk
    from tkinter import filedialog
    root = tk.Tk(); root.withdraw(); root.attributes("-topmost", True)
    path = filedialog.askopenfilename(
        title="Select billing CSV", filetypes=[("CSV files", "*.csv"), ("All files", "*.*")])
    root.destroy()
    if not path:
        print("No file selected."); return

    results  = run_analysis(pd.read_csv(path))
    out_path = path.replace(".csv", "_results.xlsx")
    with pd.ExcelWriter(out_path, engine="openpyxl") as writer:
        for name, df_out in results.items():
            df_out.to_excel(writer, sheet_name=name[:31], index=False)
    print(f"Results written to {out_path}")


if __name__ == "__main__":
    _local_main()
else:
    _sigma_main()
