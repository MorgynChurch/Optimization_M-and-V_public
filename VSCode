    def load_mapping(self, filepath=None):
        """Load column mapping from JSON file"""
        if not filepath:
            if TKINTER_AVAILABLE:
                root = tk.Tk()
                root.withdraw()
                root.attributes('-topmost', True)
                filepath = filedialog.askopenfilename(
                    title="Load Column Mapping Configuration",
