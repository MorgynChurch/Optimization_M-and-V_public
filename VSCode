    def aggregate_multi_meter_sites(self, df, service_type):
        """
        Aggregate multiple meters for the same site/period into whole-building consumption
        Tracks which meters were combined and flags commission date conflicts
        """
        if len(df) == 0:
            return df
        
        # Check for duplicate site+period combinations (indicating multiple meters)
        duplicates = df.groupby(['Site Name', 'Period Start Date', 'Period End Date']).size()
        multi_meter_periods = duplicates[duplicates > 1]
        
        if len(multi_meter_periods) == 0:
            print(f"  ✓ {service_type}: No multi-meter periods detected")
            return df
        
        print(f"\n  Multi-meter aggregation for {service_type}:")
        
        # Track meters and check for conflicts
        meter_tracking = []
        commission_conflicts = []
        
        # Group and aggregate
        aggregated_records = []
        
        for (site, start_date, end_date), group in df.groupby(['Site Name', 'Period Start Date', 'Period End Date']):
            if len(group) > 1:
                # Multiple meters for this period
                meter_numbers = group['Meter Number'].unique() if 'Meter Number' in group.columns else []
                meter_list = ', '.join([str(m) for m in meter_numbers])
                
                # Check for commission date conflicts
                if 'Commission Date' in group.columns:
                    unique_comm_dates = group['Commission Date'].dropna().unique()
                    if len(unique_comm_dates) > 1:
                        commission_conflicts.append({
                            'site': site,
                            'period': f"{start_date.strftime('%Y-%m-%d')} - {end_date.strftime('%Y-%m-%d')}",
                            'dates': unique_comm_dates
                        })
                
                # Aggregate
                agg_record = {
                    'Site Name': site,
                    'Period Start Date': start_date,
                    'Period End Date': end_date,
                    'Consumption': group['Consumption'].sum(),
                    'Total Charges': group['Total Charges'].sum(),
                    'HDD': group['HDD'].iloc[0],
                    'CDD': group['CDD'].iloc[0],
                    'Service Type': group['Service Type'].iloc[0],
                    'Meters_Aggregated': meter_list,
                    'Meter_Count': len(group)
                }
                
                # Add optional columns if they exist
                if 'Baseline Bill' in group.columns:
                    agg_record['Baseline Bill'] = group['Baseline Bill'].iloc[0]
                if 'Reporting Bill' in group.columns:
                    agg_record['Reporting Bill'] = group['Reporting Bill'].iloc[0]
                if 'Commission Date' in group.columns:
                    agg_record['Commission Date'] = group['Commission Date'].min()  # Use earliest
                if 'Consumption Unit' in group.columns:
                    agg_record['Consumption Unit'] = group['Consumption Unit'].iloc[0]
                
                aggregated_records.append(agg_record)
                
                meter_tracking.append({
                    'site': site,
                    'period': f"{start_date.strftime('%Y-%m-%d')}",
                    'meters': meter_list,
                    'count': len(group)
                })
            else:
                # Single meter - keep as-is but add tracking columns
                record = group.iloc[0].to_dict()
                record['Meters_Aggregated'] = str(group['Meter Number'].iloc[0]) if 'Meter Number' in group.columns else 'Single'
                record['Meter_Count'] = 1
                aggregated_records.append(record)
        
        aggregated_df = pd.DataFrame(aggregated_records)
        
        # Report results
        multi_meter_sites = set([m['site'] for m in meter_tracking])
        print(f"    ✓ Found {len(multi_meter_sites)} sites with multiple meters")
        print(f"    ✓ {len(df)} meter-level records → {len(aggregated_df)} aggregated records")
        
        if meter_tracking:
            # Show sample of aggregated meters
            sample_site = list(multi_meter_sites)[0]
            sample_meters = [m for m in meter_tracking if m['site'] == sample_site][:2]
            for m in sample_meters:
                print(f"      - {m['site']}, {m['period']}: {m['count']} meters ({m['meters']})")
        
        # Flag commission date conflicts
        if commission_conflicts:
            print(f"    ⚠ Commission date conflicts detected:")
            for conflict in commission_conflicts[:3]:  # Show first 3
                dates_str = ', '.join([str(d) for d in conflict['dates']])
                print(f"      - {conflict['site']}, {conflict['period']}: {dates_str} (using earliest)")
        
        return aggregated_df
    
    def _convert_consumption_units(self, df, service_type):
        """Convert consumption values to standard units (kWh for electricity, Therms for gas)"""
        if 'Consumption Unit' not in df.columns or len(df) == 0:
            print(f"  ℹ No unit conversion needed for {service_type} (assuming standard units)")
            return
        
        # Get unique units in the data
        unique_units = df['Consumption Unit'].dropna().unique()
        
        if len(unique_units) == 0:
            print(f"  ℹ No unit data found for {service_type} (assuming standard units)")
            return
        
        conversions_applied = {}
        
        for unit in unique_units:
            if unit in self.UNIT_CONVERSIONS:
                conversion_factor = self.UNIT_CONVERSIONS[unit]
                mask = df['Consumption Unit'] == unit
                count = mask.sum()
                
                if conversion_factor != 1.0:
                    df.loc[mask, 'Consumption'] = df.loc[mask, 'Consumption'] * conversion_factor
                    conversions_applied[unit] = (conversion_factor, count)
            else:
                print(f"  ⚠ Warning: Unknown unit '{unit}' for {service_type} - no conversion applied")
        
        if conversions_applied:
            target_unit = "kWh" if service_type == "Electricity" else "Therms"
            print(f"  ✓ {service_type} unit conversions to {target_unit}:")
            for unit, (factor, count) in conversions_applied.items():
                print(f"    - {count} records: {unit} × {factor} = {target_unit}")
    
    def _infer_baseline_reporting_flags(self, df, service_type):
        """
        Infer Baseline Bill and Reporting Bill flags if missing
        Uses Commission Date to determine baseline (before) vs reporting (after)
        """
        if len(df) == 0:
            return
        
        has_baseline = 'Baseline Bill' in df.columns
        has_reporting = 'Reporting Bill' in df.columns
        has_commission = 'Commission Date' in df.columns
        
        # If both flags exist, no inference needed
        if has_baseline and has_reporting:
            return
        
        # If Commission Date available, use it to infer missing flags
        if has_commission:
            print(f"\n  {service_type} flag inference:")
            
            if not has_baseline and not has_reporting:
                # Neither flag exists - create both from commission date
                df['Baseline Bill'] = (df['Period Start Date'] < df['Commission Date']).astype(int)
                df['Reporting Bill'] = (df['Period Start Date'] >= df['Commission Date']).astype(int)
                print(f"    ✓ Created Baseline and Reporting flags from Commission Date")
                print(f"      - Bills before commission = Baseline")
                print(f"      - Bills on/after commission = Reporting")
            
            elif has_baseline and not has_reporting:
                # Infer reporting from baseline
                df['Reporting Bill'] = (~df['Baseline Bill'].astype(bool)).astype(int)
                print(f"    ✓ Inferred Reporting bills as NOT baseline")
            
            elif has_reporting and not has_baseline:
                # Infer baseline from reporting
                df['Baseline Bill'] = (~df['Reporting Bill'].astype(bool)).astype(int)
                print(f"    ✓ Inferred Baseline bills as NOT reporting")
            
            # Validate with commission date if we inferred
            if has_commission:
                baseline_count = df['Baseline Bill'].sum()
                reporting_count = df['Reporting Bill'].sum()
                print(f"    ✓ Result: {baseline_count} baseline bills, {reporting_count} reporting bills")
        
        elif has_baseline and not has_reporting:
            # No commission date, but have baseline - infer reporting
            df['Reporting Bill'] = (~df['Baseline Bill'].astype(bool)).astype(int)
            print(f"\n  {service_type}: Inferred Reporting bills as NOT baseline (no commission date available)")
        
        elif has_reporting and not has_baseline:
            # No commission date, but have reporting - infer baseline
            df['Baseline Bill'] = (~df['Reporting Bill'].astype(bool)).astype(int)
            print(f"\n  {service_type}: Inferred Baseline bills as NOT reporting (no commission date available)")
        
        else:
            # No flags and no commission date - ERROR
            print(f"\n  ✗ ERROR: {service_type} has no Baseline/Reporting flags and no Commission Date!")
            print(f"    Cannot determine which bills are baseline vs reporting.")
            print(f"    Please add one of: Baseline Bill column, Reporting Bill column, or Commission Date column")
    
    def _validate_and_log_meters(self, df, service_type):
        """
        Validate meter data and log meter counts. No aggregation is performed here;
        per-site aggregation happens on-demand in _analyze_service_type when concurrent
        meters are detected.
        """
        if len(df) == 0:
