    def _create_cost_analysis_sheet(self, writer, service_type):
        """Create cost analysis sheet for specific service type (Electricity or Gas)"""
        sheet_name = f'{service_type} Cost Analysis'
        
        # Filter results for this service type (handle "Gas" matching "Natural Gas")
        if service_type.lower() == 'gas':
            service_results = [r for r in self.results if 'gas' in r['Service Type'].lower()]
        else:
            service_results = [r for r in self.results if service_type.lower() in r['Service Type'].lower()]
        
        if len(service_results) == 0:
            # No data for this service type - create placeholder
            df_empty = pd.DataFrame({
                'Message': [f'No {service_type} models created']
            })
            df_empty.to_excel(writer, sheet_name=sheet_name, index=False)
            return
        
        # Build cost analysis data
        cost_data = []
        excluded_meters = []
        
        for result in service_results:
            site_name = result['Site Name']
            meter_num = result.get('Meter Number', 'N/A')
            model_type = result.get('Model Type', 'Individual')
            
            # Skip meters that didn't pass model quality checks
            if not result.get('Model Passes Quality', False):
                # Build exclusion reason(s)
                reasons = []
                if not result.get('Passes R2 Threshold', True):
                    reasons.append(f"R²={result.get('R2', 0):.2f} below threshold")
                if not result.get('Passes CV-RMSE Threshold', True):
                    reasons.append(f"CV-RMSE={result.get('CV-RMSE', 0):.2f}% above threshold")
                if not result.get('Passes Weather Coverage Threshold', True):
                    reasons.append(f"Weather Coverage={result.get('Weather Coverage', 0):.1f}% below 75%")
                
                excluded_meters.append({
                    'Site': site_name,
                    'Meter': meter_num,
                    'Model Type': model_type,
                    'R²': round(result.get('R2', 0), 4),
                    'CV-RMSE (%)': round(result.get('CV-RMSE', 0), 2),
                    'Weather Coverage (%)': round(result.get('Weather Coverage', 0), 2),
                    'Pct Avoided (%)': round(result.get('Pct Avoided Usage', 0), 2),
                    'Exclusion Reason(s)': '; '.join(reasons) if reasons else 'Failed quality check'
                })
                continue
            
            # Get reporting bills (clean ones used in savings)
            reporting_bills = result['Reporting Bills']
            
            if len(reporting_bills) == 0:
                # No reporting bills - skip or show zeros
                continue
            
            # Calculate measured rate: Sum(Total Charges) / Sum(Consumption)
            total_charges = reporting_bills['Total Charges'].sum()
            total_consumption = reporting_bills['Consumption'].sum()
            measured_rate = total_charges / total_consumption if total_consumption > 0 else 0
            
            # Get model predictions for reporting period
            model = result['Model']
            if 'gas' in service_type.lower():
                X_rep = reporting_bills[['HDD']].values
            else:
                X_rep = reporting_bills[['HDD', 'CDD']].values
            
            predicted_consumption = model.predict(X_rep)
            modeled_usage = predicted_consumption.sum()
            actual_usage = total_consumption
            avoided_usage = modeled_usage - actual_usage
            avoided_pct = (avoided_usage / modeled_usage * 100) if modeled_usage > 0 else 0
            
            # Calculate costs
            modeled_cost = modeled_usage * measured_rate
            actual_cost = total_charges
            avoided_cost = modeled_cost - actual_cost

            # Average monthly avoided cost
            bill_count = len(reporting_bills)
            avg_monthly_avoided_cost = avoided_cost / bill_count if bill_count > 0 else 0

            # ── Savings exclusion check ────────────────────────────────────────
            # If ALL clean reporting bills show negative savings, exclude this
            # meter from savings totals and flag it clearly.
            per_bill_pct = (predicted_consumption - reporting_bills['Consumption'].values) / predicted_consumption
            savings_exclusion_flag = ""
            if len(per_bill_pct) > 0 and (per_bill_pct < 0).all():
                savings_exclusion_flag = (
                    f"EXCLUDED — All {bill_count} clean reporting bill(s) show negative savings "
                    f"(avg {per_bill_pct.mean()*100:.1f}% avoided)"
                )
                avoided_cost = 0.0
                avg_monthly_avoided_cost = 0.0

            cost_data.append({
                'Site': site_name,
                'Meter': result.get('Meter Display', meter_num),
                'Model Type': result.get('Model Type', 'Individual'),
                'Modeled Usage': round(modeled_usage, 2),
                'Actual Usage': round(actual_usage, 2),
                'Avoided Usage': round(avoided_usage, 2),
                'Avoided Usage (%)': round(avoided_pct, 2),
                'Modeled Cost ($)': round(modeled_cost, 2),
                'Actual Cost ($)': round(actual_cost, 2),
                'Avoided Cost ($)': round(avoided_cost, 2),
                'Savings Exclusion Flag': savings_exclusion_flag,
                'Measured Rate': round(measured_rate, 4),
                'Model Score': round(result['R2'], 2),
                'Bill Count': bill_count,
                'Average Monthly Avoided Cost': round(avg_monthly_avoided_cost, 2),
                'Notes': result.get('Notes', '')
            })
        
        # Create DataFrame
        df_cost = pd.DataFrame(cost_data)
        
        # Sort: by Site, then Individual before Aggregated, then by Meter
        if len(df_cost) > 0:
