    def _create_outlier_analysis_sheet(self, writer):
        """Create sheet showing all detected outliers"""
        sheet_name = 'Outlier Analysis'
        
        # Combine all outliers
        if len(self.all_outliers) == 0:
            # No outliers detected - create empty sheet with message
            df_outliers = pd.DataFrame({
                'MESSAGE': ['No outliers detected in this analysis']
            })
        else:
            df_outliers = pd.concat(self.all_outliers, ignore_index=True)
            
            # Parse the Site Name column - it contains meter_id like "UP003_Meter1339640" or "UP003_AGGREGATED"
            # Split into actual Site Name + Meter Number columns
            def parse_site_meter(value):
                """Parse meter_id like 'UP003_Meter1339640' into ('UP003', '1339640')"""
                value_str = str(value)
                if '_Meter' in value_str:
                    parts = value_str.split('_Meter', 1)
                    return parts[0], parts[1]
                elif '_AGGREGATED' in value_str:
                    parts = value_str.split('_AGGREGATED', 1)
                    return parts[0], 'AGGREGATED'
                else:
                    # No meter info - just a site name
                    return value_str, ''
            
            parsed = df_outliers['Site Name'].apply(parse_site_meter)
            df_outliers['Actual Site Name'] = parsed.apply(lambda x: x[0])
            df_outliers['Meter Number'] = parsed.apply(lambda x: x[1])
            df_outliers['Site Name'] = df_outliers['Actual Site Name']
            df_outliers = df_outliers.drop(columns=['Actual Site Name'])
            
            # Safety-net deduplication (primary dedup happens at collection time in optimize_baseline_selection)
            dedup_columns = ['Site Name', 'Meter Number', 'Service Type', 'Period Start Date', 'Period End Date', 'Consumption']
            dedup_columns = [c for c in dedup_columns if c in df_outliers.columns]
            df_outliers = df_outliers.drop_duplicates(subset=dedup_columns, keep='first')
            
            # Select and order columns
            columns_to_show = [
                'Site Name', 'Meter Number', 'Service Type', 'Period Start Date', 'Period End Date',
                'Consumption', 'Total Charges', 'Outlier_Type', 'Outlier_Reason'
            ]
            
            # Only include columns that exist
            columns_to_show = [col for col in columns_to_show if col in df_outliers.columns]
            df_outliers = df_outliers[columns_to_show]
            
            # Sort by site name and date
            if 'Site Name' in df_outliers.columns and 'Period Start Date' in df_outliers.columns:
                df_outliers = df_outliers.sort_values(['Site Name', 'Meter Number', 'Period Start Date'])
        
        # Write to Excel
        df_outliers.to_excel(writer, sheet_name=sheet_name, index=False, startrow=4)
        
        # Format the sheet
        workbook = writer.book
        outlier_sheet = workbook[sheet_name]
        
        # Add title
        outlier_sheet.merge_cells('A1:I1')
        title_cell = outlier_sheet['A1']
        title_cell.value = 'OUTLIER ANALYSIS'
        title_cell.font = Font(size=16, bold=True)
        title_cell.alignment = Alignment(horizontal='center', vertical='center')
        
        # Add summary
        outlier_sheet.merge_cells('A2:I2')
        summary_cell = outlier_sheet['A2']
        if len(self.all_outliers) > 0:
            total_outliers = len(df_outliers)
            baseline_outliers = len(df_outliers[df_outliers['Outlier_Type'] == 'Baseline']) if 'Outlier_Type' in df_outliers.columns else 0
            reporting_outliers = len(df_outliers[df_outliers['Outlier_Type'] == 'Reporting']) if 'Outlier_Type' in df_outliers.columns else 0
            summary_cell.value = f'Total Outliers: {total_outliers} (Baseline: {baseline_outliers}, Reporting: {reporting_outliers})'
        else:
            summary_cell.value = 'All bills passed outlier screening'
        summary_cell.font = Font(size=11)
        summary_cell.alignment = Alignment(horizontal='center')
        
        # Style the header row
        if len(self.all_outliers) > 0:
            header_fill = PatternFill(start_color='4472C4', end_color='4472C4', fill_type='solid')
            header_font = Font(bold=True, color='FFFFFF')
            
            for cell in outlier_sheet[5]:
                cell.fill = header_fill
                cell.font = header_font
                cell.alignment = Alignment(horizontal='center', vertical='center')
            
            # Color outlier rows (light orange for baseline, light yellow for reporting)
            baseline_fill = PatternFill(start_color='FFE699', end_color='FFE699', fill_type='solid')
            reporting_fill = PatternFill(start_color='FFC7CE', end_color='FFC7CE', fill_type='solid')
            
            for row in outlier_sheet.iter_rows(min_row=6, max_row=outlier_sheet.max_row):
                outlier_type_cell = None
                for cell in row:
                    if cell.column == df_outliers.columns.get_loc('Outlier_Type') + 1 if 'Outlier_Type' in df_outliers.columns else None:
                        outlier_type_cell = cell
                        break
                
                if outlier_type_cell and outlier_type_cell.value == 'Baseline':
                    for cell in row:
                        cell.fill = baseline_fill
                elif outlier_type_cell and outlier_type_cell.value == 'Reporting':
                    for cell in row:
                        cell.fill = reporting_fill
        
        # Auto-adjust column widths
        for column in outlier_sheet.columns:
            max_length = 0
            column_letter = None
            
            for cell in column:
                # Skip merged cells
                if isinstance(cell, MergedCell):
                    continue
                    
                if column_letter is None:
                    column_letter = cell.column_letter
                
                try:
                    if cell.value and len(str(cell.value)) > max_length:
                        max_length = len(str(cell.value))
                except:
                    pass
            
            if column_letter:
                adjusted_width = min(max_length + 2, 50)
                outlier_sheet.column_dimensions[column_letter].width = adjusted_width
    
