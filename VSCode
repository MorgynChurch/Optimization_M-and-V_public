    def _check_commission_date_conflict(self, commission_dates, service_type):
        """Check if meters have different commission dates and flag conflict"""
        unique_dates = commission_dates.dropna().unique()
        
        if len(unique_dates) > 1:
            earliest = min(unique_dates)
            print(f"      ⚠ Commission date conflict detected - using earliest: {earliest}")
            return earliest
        elif len(unique_dates) == 1:
            return unique_dates[0]
        else:
            return pd.NaT
    
    def _detect_baseline_reporting_flags(self, df, service_type):
        """
        Smart detection of Baseline and Reporting bill flags
        Priority:
        1. If both columns exist → use as-is
        2. If only one exists → infer the other (inverse)
        3. If neither exists but Commission Date does → use commission date
        4. If nothing exists → error
        """
        if len(df) == 0:
            return
        
        has_baseline = 'Baseline Bill' in df.columns
        has_reporting = 'Reporting Bill' in df.columns
        has_commission = 'Commission Date' in df.columns and df['Commission Date'].notna().any()
        
        print(f"\n  Baseline/Reporting flag detection for {service_type}:")
        
        if has_baseline and has_reporting:
            # Both exist - validate they make sense
            print(f"    ✓ Both Baseline and Reporting columns found")
            baseline_count = df['Baseline Bill'].sum()
            reporting_count = df['Reporting Bill'].sum()
            print(f"    ✓ {int(baseline_count)} baseline bills, {int(reporting_count)} reporting bills")
        
        elif has_baseline and not has_reporting:
            # Infer reporting as NOT baseline
            # First ensure Baseline Bill is numeric (convert if needed)
            if df['Baseline Bill'].dtype == 'object':
                df['Baseline Bill'] = pd.to_numeric(df['Baseline Bill'], errors='coerce').fillna(0).astype(int)
            
            df['Reporting Bill'] = (~df['Baseline Bill'].astype(bool)).astype(int)
            print(f"    ✓ Baseline column found, inferred Reporting as NOT baseline")
            baseline_count = df['Baseline Bill'].sum()
            reporting_count = df['Reporting Bill'].sum()
            print(f"    ✓ {int(baseline_count)} baseline bills, {int(reporting_count)} reporting bills")
        
        elif has_reporting and not has_baseline:
            # Infer baseline as NOT reporting
            # First ensure Reporting Bill is numeric (convert if needed)
            if df['Reporting Bill'].dtype == 'object':
                df['Reporting Bill'] = pd.to_numeric(df['Reporting Bill'], errors='coerce').fillna(0).astype(int)
            
            df['Baseline Bill'] = (~df['Reporting Bill'].astype(bool)).astype(int)
            print(f"    ✓ Reporting column found, inferred Baseline as NOT reporting")
            baseline_count = df['Baseline Bill'].sum()
            reporting_count = df['Reporting Bill'].sum()
            print(f"    ✓ {int(baseline_count)} baseline bills, {int(reporting_count)} reporting bills")
        
        elif has_commission:
            # Use commission date to determine baseline/reporting
            print(f"    ✓ Using Commission Date to determine baseline/reporting periods")
            
            # Bills BEFORE commission = baseline
            # Bills AFTER commission = reporting
            df['Baseline Bill'] = (df['Period Start Date'] < df['Commission Date']).astype(int)
            df['Reporting Bill'] = (df['Period Start Date'] >= df['Commission Date']).astype(int)
            
            baseline_count = df['Baseline Bill'].sum()
            reporting_count = df['Reporting Bill'].sum()
            print(f"    ✓ {int(baseline_count)} baseline bills (before commission)")
            print(f"    ✓ {int(reporting_count)} reporting bills (after commission)")
        
        else:
            print(f"    ✗ ERROR: No Baseline, Reporting, or Commission Date columns found!")
            print(f"    ✗ Cannot determine which bills are baseline vs reporting")
            raise ValueError(f"{service_type}: Missing baseline/reporting identification columns")
    
    def _get_meters_aggregated(self, row, aggregated_df):
        """Helper to find Meters_Aggregated for a row from original data"""
        try:
            # Match by Site Name and Period Start Date
            match = aggregated_df[
                (aggregated_df['Site Name'] == row['Site Name']) &
                (aggregated_df['Period Start Date'] == row['Period Start Date'])
            ]
            
            if len(match) > 0 and 'Meters_Aggregated' in match.columns:
                return match.iloc[0]['Meters_Aggregated']
            else:
                # No match - return original meter if available
                meter_cols = [col for col in row.index if 'meter' in col.lower() and ('no' in col.lower() or 'number' in col.lower())]
                if meter_cols and pd.notna(row[meter_cols[0]]):
                    return str(row[meter_cols[0]])
                return 'Single Meter'
        except:
            return 'N/A'
    
    def consolidate_billing_data(self, df, service_type):
        """
        Consolidate PUBLISHER and PASS_THROUGH bills.
        
        Logic:
        - Match by: Site Name + Period Start Date + Period End Date (exact period match)
        - Sum Total Charges from PASS_THROUGH rows into the matching PUBLISHER row
        - Flag and exclude problematic cases (orphan PASS_THROUGH, consumption mismatch,
          multiple PUBLISHER rows with different charges)
        
        Note: Matching uses exact billing period dates only (not consumption values),
        which avoids false positives when unrelated sites coincidentally share
        the same consumption on the same date.
        """
        # Initialize flag columns
        df['Flag_Orphan_PassThrough'] = False
        df['Flag_Consumption_Mismatch'] = False
        df['Flag_Multiple_Publishers'] = False
        df['Flag_Excluded_From_Analysis'] = False
        
        consolidated_rows = []
        processed_indices = set()
        
        flags_found = {
            'orphan_passthrough': 0,
            'consumption_mismatch': 0,
            'multiple_publishers': 0,
            'total_excluded': 0
        }
        
        # Process each unique site
        for site in df['Site Name'].unique():
            site_df = df[df['Site Name'] == site].copy()
            
            # Group rows by exact billing period (Start + End date)
            # This is the authoritative match key — no consumption involved
            date_groups = {}
            for idx, row in site_df.iterrows():
                key = (row['Period Start Date'], row['Period End Date'])
                if key not in date_groups:
                    date_groups[key] = []
                date_groups[key].append(idx)
            
            # Find groups that contain more than one row (PUBLISHER + PASS_THROUGH pairs)
            match_groups = {}
            for key, indices in date_groups.items():
                if len(indices) > 1:
                    unique_indices = tuple(sorted(set(indices)))
                    if unique_indices not in match_groups:
                        match_groups[unique_indices] = key
            
            # Process each match group
            for indices in match_groups.keys():
                if any(idx in processed_indices for idx in indices):
                    continue
                
                group_rows = site_df.loc[list(indices)]
                
                # Check consumption consistency
                consumptions = group_rows['Consumption'].unique()
                if len(consumptions) > 1:
                    # Consumption mismatch - flag and exclude all
                    for idx in indices:
                        df.loc[idx, 'Flag_Consumption_Mismatch'] = True
                        df.loc[idx, 'Flag_Excluded_From_Analysis'] = True
                        processed_indices.add(idx)
                        flags_found['consumption_mismatch'] += 1
                    continue
                
                # Separate PUBLISHER and PASS_THROUGH
                publishers = group_rows[group_rows['Provider Classification'] == 'PUBLISHER']
                passthroughs = group_rows[group_rows['Provider Classification'] == 'PASS_THROUGH']
                
                if len(publishers) == 0 and len(passthroughs) > 0:
                    # Orphan PASS_THROUGH - flag and exclude
                    for idx in indices:
                        df.loc[idx, 'Flag_Orphan_PassThrough'] = True
                        df.loc[idx, 'Flag_Excluded_From_Analysis'] = True
                        processed_indices.add(idx)
                        flags_found['orphan_passthrough'] += 1
                    
                elif len(publishers) > 1:
                    # Multiple publishers with potentially different costs - flag and exclude
                    # Check if they have different total charges
                    if publishers['Total Charges'].nunique() > 1:
                        for idx in indices:
                            df.loc[idx, 'Flag_Multiple_Publishers'] = True
                            df.loc[idx, 'Flag_Excluded_From_Analysis'] = True
                            processed_indices.add(idx)
                            flags_found['multiple_publishers'] += 1
                    else:
                        # Same charges - probably duplicates, keep one
                        keep_idx = publishers.index[0]
                        consolidated_row = publishers.iloc[0].copy()
                        
                        # Sum all PASS_THROUGH charges
                        if len(passthroughs) > 0:
                            consolidated_row['Total Charges'] += passthroughs['Total Charges'].sum()
                        
                        consolidated_rows.append(consolidated_row)
                        for idx in indices:
                            processed_indices.add(idx)
                
                elif len(publishers) == 1:
                    # Normal case: 1 PUBLISHER + N PASS_THROUGH
                    consolidated_row = publishers.iloc[0].copy()
                    
                    # Sum all PASS_THROUGH charges
                    if len(passthroughs) > 0:
                        consolidated_row['Total Charges'] += passthroughs['Total Charges'].sum()
                    
                    consolidated_rows.append(consolidated_row)
                    for idx in indices:
                        processed_indices.add(idx)
        
        # Add rows that weren't part of any match group
        for idx, row in df.iterrows():
            if idx not in processed_indices:
                consolidated_rows.append(row)
        
        # Create consolidated dataframe
        consolidated_df = pd.DataFrame(consolidated_rows)
        
        
        # Filter to non-excluded rows for analysis
        analysis_df = consolidated_df[consolidated_df['Flag_Excluded_From_Analysis'] == False].copy()
        
        # Report findings
        flags_found['total_excluded'] = (consolidated_df['Flag_Excluded_From_Analysis'] == True).sum()
        
        if flags_found['total_excluded'] > 0:
            print(f"  ⚠ {service_type} data quality flags:")
            if flags_found['orphan_passthrough'] > 0:
                print(f"    - {flags_found['orphan_passthrough']} orphan PASS_THROUGH bills (excluded)")
            if flags_found['consumption_mismatch'] > 0:
                print(f"    - {flags_found['consumption_mismatch']} bills with consumption mismatches (excluded)")
            if flags_found['multiple_publishers'] > 0:
                print(f"    - {flags_found['multiple_publishers']} bills with multiple publishers (excluded)")
            print(f"    - Total excluded: {flags_found['total_excluded']} bills")
        
        # Store flagged data for reporting
        if service_type == 'Electricity':
            self.electricity_flagged = consolidated_df[consolidated_df['Flag_Excluded_From_Analysis'] == True].copy()
        else:
            self.gas_flagged = consolidated_df[consolidated_df['Flag_Excluded_From_Analysis'] == True].copy()
        
        return analysis_df
        
    def calculate_cvrmse(self, actual, predicted):
        """Calculate Coefficient of Variation of Root Mean Squared Error"""
        rmse = np.sqrt(mean_squared_error(actual, predicted))
        mean_actual = np.mean(actual)
        cv_rmse = (rmse / mean_actual) * 100
        return cv_rmse
    
    def calculate_weather_coverage(self, selected_bills, all_baseline_bills):
        """
        Calculate weather coverage - percentage of weather range represented
        Formula: (selected_range / full_range) × 100%
        Target: ≥75% (advisory, not hard requirement)
        """
        # Get HDD and CDD ranges
        selected_hdd_range = selected_bills['HDD'].max() - selected_bills['HDD'].min()
        selected_cdd_range = selected_bills['CDD'].max() - selected_bills['CDD'].min()
        
        full_hdd_range = all_baseline_bills['HDD'].max() - all_baseline_bills['HDD'].min()
        full_cdd_range = all_baseline_bills['CDD'].max() - all_baseline_bills['CDD'].min()
        
        # Calculate coverage (avoid division by zero)
        hdd_coverage = (selected_hdd_range / full_hdd_range * 100) if full_hdd_range > 0 else 100
        cdd_coverage = (selected_cdd_range / full_cdd_range * 100) if full_cdd_range > 0 else 100
        
        # Overall coverage is average of both
        overall_coverage = (hdd_coverage + cdd_coverage) / 2
        
        return overall_coverage, hdd_coverage, cdd_coverage
    
    def interpret_weather_coverage(self, coverage):
        """Provide interpretation of weather coverage percentage"""
        if coverage >= 90:
            return "Excellent - Comprehensive weather coverage"
        elif coverage >= 75:
            return "Good - Adequate coverage (IPMVP threshold met)"
        elif coverage >= 60:
            return "Fair - Acceptable if model quality is high"
        else:
            return "Poor - May limit model reliability"
    
    def check_temporal_balance(self, selected_bills):
        """
        Check if baseline bills are temporally balanced across seasons
        Returns coefficient of variation of bills per quarter (lower is better)
        """
        selected_bills['Quarter'] = selected_bills['Period Start Date'].dt.quarter
        quarter_counts = selected_bills.groupby('Quarter').size()
        
        # Calculate CV of quarter distribution
        if len(quarter_counts) > 1:
            cv = quarter_counts.std() / quarter_counts.mean() * 100
        else:
            cv = 0
        
        return cv, quarter_counts.to_dict()
    
    def check_seasonal_requirements(self, selected_bills, min_per_quarter):
        """Check if bills meet minimum bills per quarter requirement"""
        selected_bills['Quarter'] = selected_bills['Period Start Date'].dt.quarter
        quarter_counts = selected_bills.groupby('Quarter').size()
        
        # Check if all 4 quarters are represented with minimum bills
        for q in [1, 2, 3, 4]:
            if quarter_counts.get(q, 0) < min_per_quarter:
                return False
        return True
    
    def build_regression_model(self, baseline_data, service_type):
        """
        Build linear regression model
        - Electricity: Consumption ~ HDD + CDD
        - Gas: Consumption ~ HDD (CDD not needed for heating)
        """
        if 'gas' in service_type.lower():
            # Gas models use HDD only
            X = baseline_data[['HDD']].values
        else:
            # Electricity uses both HDD and CDD
            X = baseline_data[['HDD', 'CDD']].values
        
        y = baseline_data['Consumption'].values
        
        model = LinearRegression()
        model.fit(X, y)
        
        # Calculate R²
        y_pred = model.predict(X)
        r2 = r2_score(y, y_pred)
        
        # Calculate CV-RMSE
        cv_rmse = self.calculate_cvrmse(y, y_pred)
        
        return model, r2, cv_rmse, y_pred
    
    def calculate_savings(self, model, reporting_data, service_type):
        """
        Calculate avoided usage for reporting period
        Returns total avoided usage and percentage
        """
        if 'gas' in service_type.lower():
            X_reporting = reporting_data[['HDD']].values
        else:
            X_reporting = reporting_data[['HDD', 'CDD']].values
            
        predicted_consumption = model.predict(X_reporting)
        actual_consumption = reporting_data['Consumption'].values
        
        avoided_usage = predicted_consumption - actual_consumption
        total_avoided = avoided_usage.sum()
        
        # Calculate percentage avoided
        total_predicted = predicted_consumption.sum()
        pct_avoided = (total_avoided / total_predicted * 100) if total_predicted > 0 else 0
        
        return total_avoided, pct_avoided, avoided_usage, predicted_consumption
    
    def _detect_baseline_outliers(self, baseline_bills, site_name, service_type):
        """
        Detect and exclude outliers from baseline bills using enhanced IPMVP method
        Catches: zero/negative consumption, statistical outliers (IQR)
        Returns: (clean_baseline_bills, outlier_bills)
        """
        if len(baseline_bills) < 4:
            # Need at least 4 bills to calculate meaningful quartiles
            return baseline_bills, pd.DataFrame()
        
        consumption = baseline_bills['Consumption']
        outliers_list = []
        outlier_reasons = []
        
        # STEP 1: Check for zero or negative consumption (ALWAYS exclude)
        zero_mask = consumption <= 0
        zero_outliers = baseline_bills[zero_mask].copy()
        
        if len(zero_outliers) > 0:
            outliers_list.append(zero_outliers)
            for idx in zero_outliers.index:
                outlier_reasons.append((idx, 'Zero/Negative Consumption'))
        
        # STEP 2: IQR method on positive values only
        positive_bills = baseline_bills[~zero_mask]
        
        if len(positive_bills) >= 4:
            positive_consumption = positive_bills['Consumption']
            
            # Calculate IQR
            Q1 = positive_consumption.quantile(0.25)
            Q3 = positive_consumption.quantile(0.75)
            IQR = Q3 - Q1
            
            # Define outlier bounds (1.5 × IQR is IPMVP standard)
            lower_bound = Q1 - 1.5 * IQR
            upper_bound = Q3 + 1.5 * IQR
            
            # Identify IQR outliers (only in positive bills)
            iqr_outlier_mask = (positive_consumption < lower_bound) | (positive_consumption > upper_bound)
            iqr_outliers = positive_bills[iqr_outlier_mask].copy()
            
            if len(iqr_outliers) > 0:
                outliers_list.append(iqr_outliers)
                for idx, row in iqr_outliers.iterrows():
                    if row['Consumption'] < lower_bound:
                        outlier_reasons.append((idx, f'Too Low (< {lower_bound:.0f})'))
                    else:
                        outlier_reasons.append((idx, f'Too High (> {upper_bound:.0f})'))
        
        # Combine all outliers
        if outliers_list:
            outliers = pd.concat(outliers_list).drop_duplicates()
            clean_bills = baseline_bills[~baseline_bills.index.isin(outliers.index)].copy()
            
            # Add outlier type column
            outliers['Outlier_Type'] = 'Baseline'
            outliers['Outlier_Reason'] = outliers.index.map(dict(outlier_reasons))
            
            # Print summary
            print(f"  ⚠ Baseline outlier detection ({site_name}):")
            print(f"    Total baseline bills: {len(baseline_bills)}")
            print(f"    Outliers detected: {len(outliers)} (excluded from model)")
            
            for idx, row in outliers.iterrows():
                consumption_val = row['Consumption']
                date_str = row['Period Start Date'].strftime('%Y-%m-%d')
                reason = row['Outlier_Reason']
                print(f"      - {date_str}: {consumption_val:,.0f} - {reason}")
            
            print(f"    → Using {len(clean_bills)} bills for model building")
        else:
            outliers = pd.DataFrame()
            clean_bills = baseline_bills.copy()
        
        return clean_bills, outliers
    
    def _detect_reporting_outliers(self, model, reporting_bills, site_name, service_type):
        """
        Detect and exclude outliers from reporting bills based on % avoided usage
        Industry standard: Exclude if % avoided < -10% or > 40%
        Returns: (clean_reporting_bills, outlier_bills)
        """
        if len(reporting_bills) < 2:
            # Need at least 2 bills to evaluate
            return reporting_bills, pd.DataFrame()
        
        # Predict consumption for reporting bills
        if 'gas' in service_type.lower():
            X_reporting = reporting_bills[['HDD']].values
        else:
            X_reporting = reporting_bills[['HDD', 'CDD']].values
        
        predicted = model.predict(X_reporting)
        actual = reporting_bills['Consumption'].values
        
        # Calculate % avoided for each bill
        pct_avoided = ((predicted - actual) / predicted * 100)
        
        # Define outlier bounds (industry standard)
        lower_bound = -10.0  # Less than -10% = using MORE than predicted
        upper_bound = 40.0   # More than 40% = extremely high savings
        
        # Identify outliers
        outlier_mask = (pct_avoided < lower_bound) | (pct_avoided > upper_bound)
        outliers = reporting_bills[outlier_mask].copy()
        clean_bills = reporting_bills[~outlier_mask].copy()
        
        if len(outliers) > 0:
            print(f"  ⚠ Reporting outlier detection ({site_name}):")
            print(f"    Total reporting bills: {len(reporting_bills)}")
            print(f"    Outliers detected: {len(outliers)} (excluded from savings)")
            
            for idx, (outlier_idx, row) in enumerate(outliers.iterrows()):
                actual_val = row['Consumption']
                predicted_val = predicted[reporting_bills.index.get_loc(outlier_idx)]
                pct_avoided_val = pct_avoided[reporting_bills.index.get_loc(outlier_idx)]
                date_str = row['Period Start Date'].strftime('%Y-%m-%d')
                
                if pct_avoided_val < lower_bound:
                    print(f"      - {date_str}: {pct_avoided_val:.1f}% avoided (< -10% threshold)")
                else:
                    print(f"      - {date_str}: {pct_avoided_val:.1f}% avoided (> 40% threshold)")
            
            print(f"    → Using {len(clean_bills)} bills for savings calculation")
            
            # Add outlier type and reason
            outliers['Outlier_Type'] = 'Reporting'
            
            # Create reason strings for each outlier
            outlier_pct = pct_avoided[outlier_mask]
            outlier_reasons = []
            for pct in outlier_pct:
                if pct < lower_bound:
                    outlier_reasons.append(f'% Avoided {pct:.1f}% (< -10%)')
                else:
                    outlier_reasons.append(f'% Avoided {pct:.1f}% (> 40%)')
            
            outliers['Outlier_Reason'] = outlier_reasons
            outliers['Pct_Avoided'] = outlier_pct
        
        return clean_bills, outliers
    
    def _build_result_from_locked(self, site_name, service_type, bills, r2_threshold):
        """
        Reconstruct a model result from pre-selected baseline bills.
        Used when the input data already has a 'Selected Baseline' column populated
        from a previous optimization run. Skips the optimizer entirely.
        Returns a result dict compatible with optimize_baseline_selection output.
        """
        is_gas = 'gas' in service_type.lower()

        # Identify pre-selected baseline bills
        if 'Selected Baseline' in bills.columns:
            selected = bills[
                bills['Selected Baseline'].fillna('').astype(str).str.strip() == '1'
            ].copy()
        else:
            return None  # no locked data — fall through

        if len(selected) == 0:
            return None

        # Reporting bills are anything after Commission Date that isn't selected
        reporting = bills[bills.get('Reporting Bill', pd.Series(0, index=bills.index)).fillna(0).astype(int) == 1].copy()
        if len(reporting) == 0 and 'Reporting_Bill' in bills.columns:
            reporting = bills[bills['Reporting_Bill'].fillna(0).astype(int) == 1].copy()

        # Fit model on locked baseline
        try:
            if is_gas:
                from sklearn.linear_model import LinearRegression
                X = selected[['HDD']].values
            else:
                X = selected[['HDD', 'CDD']].values
            y = selected['Consumption'].values
            model = LinearRegression().fit(X, y)
            pred = model.predict(X)
            from sklearn.metrics import r2_score, mean_squared_error
            r2 = float(r2_score(y, pred))
            cvrmse = float(self.calculate_cvrmse(y, pred))
        except Exception:
            return None

        # Weather coverage
        wc_data = self._calculate_weather_coverage(selected, selected)

        # Clean reporting bills
        clean_reporting, rep_outliers = self._detect_reporting_outliers(
            model, reporting, site_name, service_type
        ) if len(reporting) > 0 else (pd.DataFrame(), pd.DataFrame())

        # Savings
        if len(clean_reporting) > 0:
            X_rep = clean_reporting[['HDD']].values if is_gas else clean_reporting[['HDD', 'CDD']].values
            pred_rep = model.predict(X_rep)
            avoided = pred_rep.sum() - clean_reporting['Consumption'].sum()
            pct_avd = avoided / pred_rep.sum() * 100 if pred_rep.sum() > 0 else 0.0
        else:
            avoided, pct_avd = 0.0, 0.0

        hdd_coef = float(model.coef_[0])
        cdd_coef = float(model.coef_[1]) if not is_gas else 0.0

        return {
            'Model': model,
            'R2': round(r2, 4),
            'CV-RMSE': round(cvrmse, 2),
            'Weather Coverage': round(wc_data.get('overall', 0), 1),
            'HDD Coverage': round(wc_data.get('hdd', 0), 1),
            'CDD Coverage': round(wc_data.get('cdd', 0), 1),
            'Passes Weather Coverage Threshold': wc_data.get('overall', 0) >= self.WEATHER_COVERAGE_THRESHOLD,
            'Passes R2 Threshold': r2 >= r2_threshold,
            'Passes CV-RMSE Threshold': cvrmse <= self.CVRMSE_THRESHOLD,
            'Model Passes Quality': (
                r2 >= r2_threshold and
                cvrmse <= self.CVRMSE_THRESHOLD and
                wc_data.get('overall', 0) >= self.WEATHER_COVERAGE_THRESHOLD
            ),
            'Selected Baseline': selected,
            'Reporting Bills': clean_reporting,
            'Reporting Outliers': rep_outliers,
            'Baseline Count': len(selected),
            'Reporting Count': len(clean_reporting),
            'Total Avoided Usage': round(avoided, 2),
            'Pct Avoided Usage': round(pct_avd, 2),
            'Seasonal Strategy': 'Locked (pre-selected)',
            'Optimization Mode': 'Locked',
            'HDD Coefficient': hdd_coef,
            'CDD Coefficient': cdd_coef,
            'Intercept': float(model.intercept_),
            'Q1 Bills': int(selected['Period Start Date'].apply(
                lambda d: pd.to_datetime(d).quarter if pd.notna(d) else 0
            ).value_counts().get(1, 0)),
            'Q2 Bills': int(selected['Period Start Date'].apply(
                lambda d: pd.to_datetime(d).quarter if pd.notna(d) else 0
            ).value_counts().get(2, 0)),
            'Q3 Bills': int(selected['Period Start Date'].apply(
                lambda d: pd.to_datetime(d).quarter if pd.notna(d) else 0
            ).value_counts().get(3, 0)),
            'Q4 Bills': int(selected['Period Start Date'].apply(
                lambda d: pd.to_datetime(d).quarter if pd.notna(d) else 0
            ).value_counts().get(4, 0)),
        }

    def optimize_baseline_selection(self, site_name, service_type, all_bills, 
                                    baseline_count, r2_threshold, max_iterations=500):
        """
        Optimize baseline selection to maximize savings with smart pre-filtering
        
        Strategy:
        1. Try to find combinations with ≥2 bills per quarter (preferred)
        2. If none available, fall back to ≥1 bill per quarter (minimum)
        3. Filter for R² and CV-RMSE quality (hard requirements)
        4. Track weather coverage as advisory metric
        5. Select best combination by % avoided usage
        """
        baseline_bills = all_bills[all_bills['Baseline Bill'] == 1].copy()
        reporting_bills = all_bills[all_bills['Reporting Bill'] == 1].copy()
        
        # Check if site has any bills at all
        if len(all_bills) == 0:
            print(f"  ✗ No bills found for this site")
            return None
        
        # Check if site has any baseline bills marked
        if len(baseline_bills) == 0:
            print(f"  ✗ No baseline bills marked (total bills: {len(all_bills)})")
            return None
        
        # OUTLIER DETECTION: Remove outliers from baseline bills before model building
        baseline_bills, baseline_outliers = self._detect_baseline_outliers(
            baseline_bills, site_name, service_type
        )
        
        # Store outliers for global Excel export (Outlier Analysis sheet)
        # Deduplicate at append time to avoid any double-entries
        if len(baseline_outliers) > 0:
            baseline_outliers['Site Name'] = site_name
            baseline_outliers['Service Type'] = service_type
            dedup_cols = ['Period Start Date', 'Period End Date', 'Consumption']
            existing_dedup = [c for c in dedup_cols if c in baseline_outliers.columns]
            if existing_dedup:
                baseline_outliers = baseline_outliers.drop_duplicates(subset=existing_dedup)
            self.all_outliers.append(baseline_outliers)
        
        # Need enough baseline bills AFTER outlier removal
        if len(baseline_bills) < baseline_count:
            print(f"  ✗ Insufficient baseline bills after outlier removal: {len(baseline_bills)} available, {baseline_count} required")
            if len(baseline_outliers) > 0:
                print(f"    ({len(baseline_outliers)} outliers were excluded)")
            return None
        
        # Add quarter information
        baseline_bills['Quarter'] = baseline_bills['Period Start Date'].dt.quarter
        
        # Try preferred strategy first: ≥2 bills per quarter
        print(f"  Attempting to select {baseline_count} bills with ≥2 per quarter...")
        best_result = self._optimize_with_seasonal_constraint(
            baseline_bills, reporting_bills, baseline_count, r2_threshold,
            self.PREFERRED_MIN_BILLS_PER_QUARTER, max_iterations, site_name, service_type
        )
        
        if best_result:
            best_result['Seasonal Strategy'] = f"Optimal (≥{self.PREFERRED_MIN_BILLS_PER_QUARTER} bills per quarter)"
            print(f"  ✓ Found optimal seasonal balance")
        else:
            # Fall back to minimum strategy: ≥1 bill per quarter
            print(f"  ⚠ No valid combinations with ≥2 per quarter. Trying ≥1 per quarter...")
            best_result = self._optimize_with_seasonal_constraint(
                baseline_bills, reporting_bills, baseline_count, r2_threshold,
                self.MINIMUM_BILLS_PER_QUARTER, max_iterations, site_name, service_type
            )
            
            if best_result:
                best_result['Seasonal Strategy'] = f"Acceptable (≥{self.MINIMUM_BILLS_PER_QUARTER} bill per quarter)"
                print(f"  ✓ Found acceptable seasonal balance")
            else:
                print(f"  ✗ Could not create a model (no valid combinations found)")
        
        # Add reporting outliers from the FINAL best result (not from every iteration)
        if best_result and 'Reporting Outliers' in best_result:
            reporting_outliers = best_result['Reporting Outliers']
            if len(reporting_outliers) > 0:
                reporting_outliers['Site Name'] = site_name
                reporting_outliers['Service Type'] = service_type
                # Deduplicate before appending to avoid duplicates from optimization loop
                dedup_cols = ['Period Start Date', 'Period End Date', 'Consumption']
                existing_dedup = [c for c in dedup_cols if c in reporting_outliers.columns]
                if existing_dedup:
                    reporting_outliers = reporting_outliers.drop_duplicates(subset=existing_dedup)
                self.all_outliers.append(reporting_outliers)
            
            # Also add all baseline bills (clean set after outlier removal) to result
            # This allows detailed analysis to show ALL available bills, not just selected ones
            best_result['All Baseline Bills'] = baseline_bills
            
            # Attach outliers DIRECTLY to result (not just to global list)
            # This avoids site name matching issues for meter-level vs aggregated analyses
            best_result['Result Baseline Outliers'] = baseline_outliers
            best_result['Result Reporting Outliers'] = reporting_outliers
        
        return best_result
    
    def _optimize_with_seasonal_constraint(self, baseline_bills, reporting_bills, 
                                          baseline_count, r2_threshold, min_per_quarter,
                                          max_iterations, site_name, service_type):
        """Helper method to optimize with specific seasonal constraint"""
        
        # Generate combinations that meet seasonal requirements
        valid_combinations = []
        
        # Determine if we should try all combinations or sample
        total_possible = self._n_choose_k(len(baseline_bills), baseline_count)
        
        if total_possible <= max_iterations:
            # Try all combinations
            all_combos = combinations(range(len(baseline_bills)), baseline_count)
            test_count = total_possible
        else:
            # Random sampling
            all_combos = self._random_combinations(len(baseline_bills), baseline_count, max_iterations * 3)
            test_count = max_iterations * 3  # Generate more to filter
        
        # Pre-filter for seasonal requirements AND weather coverage
        # This avoids wasting time building models for combinations that can't pass
        seasonal_pass_count = 0
        weather_fail_count = 0
        
        for combo_indices in all_combos:
            selected = baseline_bills.iloc[list(combo_indices)]
            
            # Check 1: Seasonal requirements
            if not self.check_seasonal_requirements(selected, min_per_quarter):
                continue
            seasonal_pass_count += 1
            
            # Check 2: Weather coverage (HARD REQUIREMENT - skip if fails)
            weather_cov, _, _ = self.calculate_weather_coverage(selected, baseline_bills)
            if weather_cov < self.WEATHER_COVERAGE_THRESHOLD:
                weather_fail_count += 1
                continue
            
            # Both checks passed - add to valid combinations
            valid_combinations.append(combo_indices)
            
            if len(valid_combinations) >= max_iterations:
                break
        
        if len(valid_combinations) == 0:
            # Provide diagnostic info
            if seasonal_pass_count == 0:
                print(f"    ✗ No combinations meet seasonal requirements (≥{min_per_quarter} bills per quarter)")
            elif weather_fail_count > 0:
                print(f"    ✗ {seasonal_pass_count} combinations met seasonal requirements but ALL failed weather coverage (<{self.WEATHER_COVERAGE_THRESHOLD}%)")
            return None
        
        print(f"    Found {len(valid_combinations)} combinations meeting seasonal + weather coverage requirements")
        if weather_fail_count > 0:
            print(f"    (Filtered out {weather_fail_count} combinations with weather coverage <{self.WEATHER_COVERAGE_THRESHOLD}%)")
        
        # Test valid combinations
        # Selection priority:
        # 1. Among PASSING models, prefer ones with most reporting bills retained (avoid 0% from all outliers)
        # 2. Among models with same reporting bill count, prefer highest savings %
        # 3. Tiebreaker: highest R²
        best_passing_result = None
        best_passing_score = (-1, -np.inf, -np.inf)  # (reporting_bills_used, pct_avoided, R²)
        best_failing_result = None
        best_failing_score = (-1, -np.inf, -np.inf)
        valid_models = 0
        total_models_tested = 0
        
        for i, combo_indices in enumerate(valid_combinations):
            if (i + 1) % 100 == 0:
                print(f"    Progress: {i+1}/{len(valid_combinations)} combinations tested, {valid_models} passing quality")
            
            selected = baseline_bills.iloc[list(combo_indices)]
            
            result = self.evaluate_baseline_combination(
                selected, reporting_bills, baseline_bills, r2_threshold, site_name, service_type
            )
            
            if result:
                total_models_tested += 1
                pct_avoided = result['Pct Avoided Usage']
                r2 = result['R2']
                # Count clean reporting bills (after outlier removal)
                reporting_bills_used = len(result.get('Reporting Bills', []))
                
                # Score: prioritize retaining reporting bills, then savings, then R²
                score = (reporting_bills_used, pct_avoided, r2)
                
                if result['Model Passes Quality']:
                    valid_models += 1
                    if score > best_passing_score:
                        best_passing_score = score
                        best_passing_result = result
                else:
                    if score > best_failing_score:
                        best_failing_score = score
                        best_failing_result = result
        
        # Prioritize passing models, but fall back to best failing model if no passing models
        if best_passing_result:
            best_result = best_passing_result
            n_reporting = len(best_result.get('Reporting Bills', []))
            print(f"    ✓ Best model: {best_passing_score[1]:.2f}% avoided usage "
                  f"(R²={best_result['R2']:.4f}, CV-RMSE={best_result['CV-RMSE']:.2f}%, "
                  f"{n_reporting} reporting bills used)")
        elif best_failing_result:
            best_result = best_failing_result
            n_reporting = len(best_result.get('Reporting Bills', []))
            print(f"    ⚠ Best model (FAILED QUALITY): {best_failing_score[1]:.2f}% avoided usage "
                  f"(R²={best_result['R2']:.4f}, CV-RMSE={best_result['CV-RMSE']:.2f}%, "
                  f"{n_reporting} reporting bills used)")
            
            # Add specific failure reasons
            reasons = []
            if not best_result['Passes R2 Threshold']:
                reasons.append(f"R²={best_result['R2']:.4f} < {r2_threshold}")
            if not best_result['Passes CV-RMSE Threshold']:
                reasons.append(f"CV-RMSE={best_result['CV-RMSE']:.2f}% > {self.CVRMSE_THRESHOLD}%")
            if not best_result.get('Passes Weather Coverage Threshold', True):
                reasons.append(f"Weather Coverage={best_result['Weather Coverage']:.2f}% < {self.WEATHER_COVERAGE_THRESHOLD}%")
            print(f"      Reason(s): {', '.join(reasons)}")
        else:
            best_result = None
            print(f"    ✗ No models could be created (insufficient data or errors)")
        
        return best_result
    
    def _n_choose_k(self, n, k):
        """Calculate binomial coefficient"""
        if k > n:
            return 0
        if k == 0 or k == n:
            return 1
        
        k = min(k, n - k)
        result = 1
        for i in range(k):
            result = result * (n - i) // (i + 1)
        return result
    
    def _random_combinations(self, n, k, count):
        """
        Generate random combinations efficiently.
        Uses a fixed deterministic seed derived from n and k so results are
        identical every run for the same input data.
        """
        rng = np.random.default_rng(seed=(n * 1000 + k))
        seen = set()
        attempts = 0
        max_attempts = count * 4   # tighter bound for performance

        while len(seen) < count and attempts < max_attempts:
            combo = tuple(sorted(rng.choice(n, k, replace=False)))
            if combo not in seen:
                seen.add(combo)
                yield combo
            attempts += 1
    
    def evaluate_baseline_combination(self, selected_baseline, reporting_bills, 
                                     all_baseline_bills, r2_threshold, site_name, service_type):
        """Evaluate a specific combination of baseline bills"""
        
        # Build model (gas uses HDD only, electricity uses HDD+CDD)
        model, r2, cv_rmse, y_pred_baseline = self.build_regression_model(selected_baseline, service_type)
        
        # Check quality criteria (HARD REQUIREMENTS)
        passes_r2 = r2 >= r2_threshold
        passes_cvrmse = cv_rmse <= self.CVRMSE_THRESHOLD
        
        # Weather coverage (NOW A HARD REQUIREMENT)
        weather_cov, hdd_cov, cdd_cov = self.calculate_weather_coverage(
            selected_baseline, all_baseline_bills
        )
        weather_interpretation = self.interpret_weather_coverage(weather_cov)
        passes_weather_coverage = weather_cov >= self.WEATHER_COVERAGE_THRESHOLD
        
        # Temporal balance
        temporal_cv, quarter_dist = self.check_temporal_balance(selected_baseline)
        
        # Overall quality check (R², CV-RMSE, AND weather coverage are hard requirements)
        passes_quality = passes_r2 and passes_cvrmse and passes_weather_coverage
        
        # Calculate savings if we have reporting bills
        reporting_outliers = pd.DataFrame()
        clean_reporting = pd.DataFrame()  # Initialize clean_reporting
        
        if len(reporting_bills) > 0:
            # OUTLIER DETECTION: Remove outliers from reporting bills based on model residuals
            clean_reporting, reporting_outliers = self._detect_reporting_outliers(
                model, reporting_bills, site_name, service_type
            )
            
            # DON'T append to all_outliers here - return in result instead
            # This function is called in optimization loop, so it would create duplicates
            
            # Calculate savings using clean reporting bills (outliers excluded)
            if len(clean_reporting) > 0:
                total_avoided, pct_avoided, avoided_usage, predicted = self.calculate_savings(
                    model, clean_reporting, service_type
                )
            else:
                # All reporting bills were outliers
                total_avoided = 0
                pct_avoided = 0
                avoided_usage = np.array([])
                predicted = np.array([])
        else:
            total_avoided = 0
            pct_avoided = 0
            avoided_usage = np.array([])
            predicted = np.array([])
        
        # Model equation (gas has HDD only, electricity has HDD+CDD)
        intercept = model.intercept_
        if 'gas' in service_type.lower():
            hdd_coef = model.coef_[0]
            cdd_coef = 0.0  # Not used for gas
            equation = f"Consumption = {intercept:.2f} + {hdd_coef:.4f}*HDD"
        else:
            hdd_coef = model.coef_[0]
            cdd_coef = model.coef_[1]
            equation = f"Consumption = {intercept:.2f} + {hdd_coef:.4f}*HDD + {cdd_coef:.4f}*CDD"
        
        # CV-RMSE interpretation
        if cv_rmse < 10:
            cvrmse_rating = "Excellent"
        elif cv_rmse <= 15:
            cvrmse_rating = "Good (ASHRAE Pass)"
        elif cv_rmse <= 25:
            cvrmse_rating = "Fair (Fail)"
        else:
            cvrmse_rating = "Poor"
        
        # R² interpretation
        if r2 >= 0.9:
            r2_rating = "Excellent"
        elif r2 >= 0.75:
            r2_rating = "Good"
        elif r2 >= 0.6:
            r2_rating = "Fair"
        else:
            r2_rating = "Poor"
        
        result = {
            'Site Name': site_name,
            'Service Type': service_type,
            'Baseline Count': len(selected_baseline),
            'Reporting Count': len(reporting_bills),
            'Model Equation': equation,
            'Intercept': intercept,
            'HDD Coefficient': hdd_coef,
            'CDD Coefficient': cdd_coef,
            'R2': r2,
            'R2 Rating': r2_rating,
            'CV-RMSE': cv_rmse,
            'CV-RMSE Rating': cvrmse_rating,
            'Weather Coverage': weather_cov,
            'Weather Coverage Interpretation': weather_interpretation,
            'HDD Coverage': hdd_cov,
            'CDD Coverage': cdd_cov,
            'Temporal CV': temporal_cv,
            'Q1 Bills': quarter_dist.get(1, 0),
            'Q2 Bills': quarter_dist.get(2, 0),
            'Q3 Bills': quarter_dist.get(3, 0),
            'Q4 Bills': quarter_dist.get(4, 0),
            'Total Avoided Usage': total_avoided,
            'Pct Avoided Usage': pct_avoided,
            'Passes R2 Threshold': passes_r2,
            'Passes CV-RMSE Threshold': passes_cvrmse,
            'Passes Weather Coverage Threshold': passes_weather_coverage,
            'Model Passes Quality': passes_quality,
            'Baseline Dates': ', '.join(selected_baseline['Period End Date'].dt.strftime('%Y-%m-%d').tolist()),
            'Model': model,
            'Selected Baseline': selected_baseline,
            'Reporting Bills': clean_reporting,  # Store CLEAN bills (after outlier removal), not original
            'Reporting Outliers': reporting_outliers  # Include outliers so they can be added ONCE for best result
        }
        
        return result
    
