class ColumnMapper:
    """Handles interactive column mapping and configuration management"""
    
    REQUIRED_COLUMNS = {
        'Site Name': 'Unique identifier for each site/building',
        'Meter Number': 'Unique meter identifier (CRITICAL for meter-level analysis)',
        'Service Type': 'Electricity or Natural Gas', 
        'Period Start Date': 'Billing period start date',
        'Period End Date': 'Billing period end date',
        'HDD': 'Heating Degree Days',
        'CDD': 'Cooling Degree Days',
        'Consumption': 'Energy consumption amount',
        'Total Charges': 'Total cost for the billing period'
    }
    
    OPTIONAL_COLUMNS = {
        'Baseline Bill': 'Flag indicating baseline period (1/0 or Yes/No) - OR provide Commission Date',
        'Reporting Bill': 'Flag indicating reporting period (1/0 or Yes/No) - OR provide Commission Date',
        'Commission Date': 'Building commission date (required if no Baseline/Reporting flags)',
        'Provider Classification': 'PUBLISHER or PASS_THROUGH (optional, only if data has duplicates)',
        'Consumption Unit': 'Unit of measure for consumption (kWh, MWh, Therms, CCF, MCF, etc.)'
    }
    

    def __init__(self):
        self.mapping = {}
        self.config_file = None
    
    def display_available_columns(self, df, sheet_name):
        """Display available columns with sample data"""
        print(f"\n{'='*80}")
        print(f"AVAILABLE COLUMNS IN {sheet_name.upper()} SHEET")
        print("="*80)
        print(f"\nShowing first 3 rows to help identify columns:\n")
        
        # Get column letters
        column_letters = [get_column_letter(i+1) for i in range(len(df.columns))]
        
        # Display columns with letters and sample data
        print(f"{'Letter':<8} {'Column Name':<40} {'Sample Value':<30}")
        print("-" * 80)
        for idx, (letter, col) in enumerate(zip(column_letters, df.columns)):
            sample = str(df[col].iloc[0]) if len(df) > 0 else 'N/A'
            if len(sample) > 28:
                sample = sample[:25] + "..."
            print(f"{letter:<8} {col:<40} {sample:<30}")
        
        print("\n" + "="*80)
    
    def prompt_for_mapping(self, df, sheet_name):
        """Interactive prompts to map required columns"""
        print(f"\n{'='*80}")
        print(f"COLUMN MAPPING FOR {sheet_name.upper()}")
        print("="*80)
        print("\nEnter the column LETTER (e.g., 'M') or exact COLUMN NAME (e.g., 'HDD')")
        print("Type 'SKIP' for optional columns you don't have\n")
        
        mapping = {}
        
        # Map required columns
        for field, description in self.REQUIRED_COLUMNS.items():
            while True:
                user_input = input(f"{field} ({description}): ").strip()
                
                if not user_input:
                    print(f"  ⚠ This field is required. Please enter a value.")
                    continue
                
                # Try to interpret input
                column = self._resolve_column(user_input, df.columns)
                
                if column:
                    mapping[field] = column
                    print(f"  ✓ Mapped to: {column}")
                    break
                else:
                    print(f"  ✗ Column '{user_input}' not found. Please try again.")
        
        # Map optional columns
        print("\n--- Optional Columns ---")
        for field, description in self.OPTIONAL_COLUMNS.items():
            user_input = input(f"{field} ({description}) [press Enter to skip]: ").strip()
            
            if user_input and user_input.upper() != 'SKIP':
                column = self._resolve_column(user_input, df.columns)
                if column:
                    mapping[field] = column
                    print(f"  ✓ Mapped to: {column}")
                else:
                    print(f"  ⚠ Column '{user_input}' not found. Skipping.")
        
        return mapping
    
    def _resolve_column(self, user_input, columns):
        """Resolve user input to actual column name"""
        user_input = user_input.strip()
        
        # Check if it's a column letter (A, B, C, etc.)
        if len(user_input) <= 3 and user_input.upper().isalpha():
            try:
                col_idx = self._letter_to_index(user_input.upper())
                if col_idx < len(columns):
                    return columns[col_idx]
            except:
                pass
        
        # Check if it's an exact column name
        if user_input in columns:
            return user_input
        
        # Check case-insensitive match
        for col in columns:
            if col.lower() == user_input.lower():
                return col
        
        return None
    
    def _letter_to_index(self, letter):
        """Convert Excel column letter to 0-based index"""
        result = 0
        for char in letter:
            result = result * 26 + (ord(char) - ord('A') + 1)
        return result - 1
    
