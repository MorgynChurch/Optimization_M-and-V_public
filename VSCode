    def _analyze_service_type(self, service_type, df, baseline_count, r2_threshold):
        """Analyze a specific service type at both meter and aggregated level"""
        print("\n" + "="*80)
        print(f"{service_type.upper()} ANALYSIS - UNIFIED (Individual + Aggregated)")
        print("="*80)
        
        if len(df) == 0:
            print(f"  No {service_type} data to analyze")
            return
        
        # Check if Meter Number column exists AND has valid values
        has_meter_numbers = (
            'Meter Number' in df.columns and 
            df['Meter Number'].notna().any()
        )
        
        if not has_meter_numbers:
            # No meter numbers - just do site-level analysis
            print(f"  ⚠ No valid Meter Numbers found - analyzing by site only")
            sites = df['Site Name'].unique()
            for site in sorted(sites):
                print(f"\nAnalyzing {site} ({service_type})...")
                site_data = df[df['Site Name'] == site]
                
                if self.has_locked_baseline:
                    result = self._build_result_from_locked(
                        site, service_type, site_data, r2_threshold
                    )
                else:
                    result = self.optimize_baseline_selection(
                        site, service_type, site_data,
                        baseline_count, r2_threshold
                    )
                
                if result:
                    result['Meter Number'] = 'N/A'
                    result['Site Name'] = site
                    result['Model Type'] = 'Individual'
                    result['Meter Display'] = 'N/A'
                    result['Meter Count'] = 1
                    result['Sequential Meters'] = False
                    result['Meter Weight (%)'] = None
                    result['Coverage Flag']    = ''
                    result['Weight Flag']      = ''
                    result['Notes'] = ''
                    self.results.append(result)
            return
        
        # Group by Site + Meter Number to identify multi-meter sites
        site_meter_groups = df.groupby('Site Name')['Meter Number'].nunique()
        
        # Process each site
        for site in sorted(df['Site Name'].unique()):
            site_data = df[df['Site Name'] == site]
            meter_count = site_meter_groups[site]
            
            print(f"\n{'─'*60}")
            print(f"SITE: {site} ({service_type}) - {meter_count} meter(s) detected")
            print(f"{'─'*60}")
            
            # === STEP 1: ANALYZE EACH METER INDIVIDUALLY ===
            meter_groups = site_data.groupby('Meter Number')
            meter_list = sorted([(meter_num, mdata) for meter_num, mdata in meter_groups], 
                              key=lambda x: str(x[0]))
            
            individual_results_for_site = []
            
            for meter_num, meter_data in meter_list:
                if pd.isna(meter_num):
                    print(f"  ⚠ Skipping NaN meter number")
                    continue
                
                meter_id = f"{site}_Meter{meter_num}"
                print(f"\n  ── Individual Meter {meter_num} ──")
                
                if self.has_locked_baseline:
                    result = self._build_result_from_locked(
                        meter_id, service_type, meter_data, r2_threshold
                    )
                else:
                    result = self.optimize_baseline_selection(
                        meter_id, service_type, meter_data,
                        baseline_count, r2_threshold
                    )
                
                if result:
                    result['Meter Number'] = meter_num
                    result['Site Name'] = site
                    result['Model Type'] = 'Individual'
                    result['Meter Display'] = str(meter_num)
                    result['Meter Count'] = 1
                    result['Sequential Meters'] = False
                    result['Meter Weight (%)'] = None   # filled in below for concurrent sites
                    result['Coverage Flag']    = ''     # filled in below for concurrent sites
                    result['Weight Flag']      = ''     # filled in after aggregate assessment
                    result['Notes'] = ''
                    self.results.append(result)
                    individual_results_for_site.append(result)
                else:
                    print(f"  ⚠ Could not build individual model for meter {meter_num} (insufficient data)")
            
            # === STEP 2: METER WEIGHTING (concurrent multi-meter sites only) ===
            # Calculate weights now so they're available for both the individual
            # row stamping and the aggregate flag assessment below.
            if meter_count > 1 and len(individual_results_for_site) > 0:
                meter_nums_for_weight = [r['Meter Number'] for r in individual_results_for_site]
                meter_weights = self._calc_meter_weights(site_data, meter_nums_for_weight)
                # Stamp Meter Weight (%) and Coverage Flag onto each individual row
                for r in individual_results_for_site:
                    w = meter_weights.get(str(r['Meter Number']), 0.0)
                    r['Meter Weight (%)'] = round(w * 100, 2)
                    r['Coverage Flag']    = self._low_coverage_flag(w, r['Model Passes Quality'])
            else:
                meter_weights = {}

            # === STEP 3: IF MULTI-METER WITH OVERLAPPING PERIODS, ALSO ANALYZE AGGREGATED ===
            if meter_count > 1:
                # Check if meters have OVERLAPPING periods (concurrent) or are sequential (e.g. meter replacement)
                meters_overlap = self._check_meters_overlap(site_data)
                
                if not meters_overlap:
                    # Sequential meters (meter replacement) - treat as single timeline
                    # Don't create a separate "aggregated" row, just analyze the combined data as if it were one meter
                    print(f"\n  ℹ {site}: {meter_count} meters detected but they appear to be SEQUENTIAL (e.g. meter replacement)")
                    print(f"    → Treating as single meter timeline (no aggregation row)")
                    
                    # Remove individual meter results we just added (they'll be replaced by combined)
                    self.results = [r for r in self.results if r not in individual_results_for_site]
                    
                    # Aggregate the data and analyze as a single meter
                    combined_data = self._aggregate_meters_for_site(site_data, service_type)
                    
                    if len(combined_data) > 0:
                        # Get list of meter numbers for the Notes
                        meter_nums = sorted([str(m) for m in site_data['Meter Number'].dropna().unique()])
                        
                        if self.has_locked_baseline:
                            result = self._build_result_from_locked(
                                site, service_type, combined_data, r2_threshold
                            )
                        else:
                            result = self.optimize_baseline_selection(
                                site, service_type, combined_data,
                                baseline_count, r2_threshold
                            )
                        
                        if result:
                            # Treat as single meter but note it was sequential
                            result['Meter Number'] = ', '.join(meter_nums)
                            result['Site Name'] = site
                            result['Model Type'] = 'Individual'  # Treat as single
                            result['Meter Display'] = ', '.join(meter_nums)
                            result['Meter Count'] = 1  # Effectively single meter
                            result['Sequential Meters'] = True
                            result['Meter Weight (%)'] = None
                            result['Coverage Flag']    = ''
                            result['Weight Flag']      = ''
                            result['Notes'] = f'Sequential meter replacement: {meter_count} meters combined into single timeline'
                            self.results.append(result)
                    continue
                
                # True concurrent meters - real aggregation
                print(f"\n  ── Aggregated ({meter_count} concurrent meters combined) ──")
                
                # Aggregate by date - sum consumption and charges across meters
                aggregated_data = self._aggregate_meters_for_site(site_data, service_type)
                
                if len(aggregated_data) == 0:
                    print(f"  ⚠ Could not aggregate {site} meters")
                    continue
                
                aggregated_id = f"{site}_AGGREGATED"
                
                if self.has_locked_baseline:
                    result = self._build_result_from_locked(
                        aggregated_id, service_type, aggregated_data, r2_threshold
                    )
                else:
                    result = self.optimize_baseline_selection(
                        aggregated_id, service_type, aggregated_data,
                        baseline_count, r2_threshold
                    )
                
                if result:
                    result['Meter Number'] = f'AGGREGATED ({meter_count})'
                    result['Site Name'] = site
                    result['Model Type'] = 'Aggregated'
                    result['Meter Display'] = f'AGGREGATED ({meter_count})'
                    result['Meter Count'] = meter_count
                    result['Sequential Meters'] = False

                    # Weight flag assessment for the aggregate row
                    agg_weight_flag, weight_note = self._failing_weight_flag(
                        meter_weights, individual_results_for_site
                    )
                    result['Weight Flag'] = agg_weight_flag
                    result['Notes'] = weight_note  # further extended by _generate_recommendations

                    # Stamp the same weight flag back onto individual rows for this site
                    for r in individual_results_for_site:
                        r['Weight Flag'] = agg_weight_flag

                    # Build meter weight rows for the Meter Weights sheet
                    for r in individual_results_for_site:
                        m_key  = str(r['Meter Number'])
