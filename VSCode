    def _create_meter_weights_sheet(self, writer):
        """
        Create the Meter Weights sheet — one row per meter for concurrent
        multi-meter sites, showing baseline consumption share, weight flags,
        and individual model quality metrics.
        """
        sheet_name = 'Meter Weights'

        if not self.meter_weight_results:
            # No concurrent multi-meter sites — write a placeholder via DataFrame
            pd.DataFrame({'Note': ['No concurrent multi-meter sites found in this dataset.']}).to_excel(
                writer, sheet_name=sheet_name, index=False
            )
            return

        # Build DataFrame and write via pandas (openpyxl engine)
        df = pd.DataFrame(self.meter_weight_results)

        # Reorder columns for clarity
        col_order = [
            'Site Name', 'Meter Number', 'Service Type',
            'Baseline Consumption', 'Meter Weight (%)', 'Weight Source',
            'Individual Model Passes', 'Individual R2', 'Individual CV-RMSE',
            'Individual Pct Avoided', 'Coverage Flag', 'Aggregate Weight Flag',
        ]
        df = df[[c for c in col_order if c in df.columns]]

        df.to_excel(writer, sheet_name=sheet_name, index=False)

        # Apply colour formatting via openpyxl after writing
        ws = writer.sheets[sheet_name]
        from openpyxl.styles import PatternFill, Font, Alignment
        from openpyxl.utils import get_column_letter

        # Header row formatting
        hdr_fill = PatternFill(start_color='2E75B6', end_color='2E75B6', fill_type='solid')
        hdr_font = Font(bold=True, color='FFFFFF', name='Arial')
        for cell in ws[1]:
            cell.fill = hdr_fill
            cell.font = hdr_font
            cell.alignment = Alignment(wrap_text=True, vertical='center')
        ws.row_dimensions[1].height = 35

        # Column widths
        widths = {
            'Site Name': 18, 'Meter Number': 16, 'Service Type': 14,
            'Baseline Consumption': 20, 'Meter Weight (%)': 16, 'Weight Source': 30,
            'Individual Model Passes': 22, 'Individual R2': 14,
            'Individual CV-RMSE': 18, 'Individual Pct Avoided': 18,
            'Coverage Flag': 36, 'Aggregate Weight Flag': 22,
        }
        for j, col_name in enumerate(df.columns, 1):
            ws.column_dimensions[get_column_letter(j)].width = widths.get(col_name, 16)

        # Colour-code data rows
        flag_colours = {
            'OK':            'C6EFCE',
            'REVIEW':        'FFEB9C',
            'HIGH RISK':     'FFC7CE',
            'NO AGG MODEL':  'F2F2F2',
        }
        agg_col_idx = list(df.columns).index('Aggregate Weight Flag') + 1 if 'Aggregate Weight Flag' in df.columns else None
        cov_col_idx = list(df.columns).index('Coverage Flag') + 1          if 'Coverage Flag'          in df.columns else None
        pass_col_idx = list(df.columns).index('Individual Model Passes') + 1 if 'Individual Model Passes' in df.columns else None

        for row_idx in range(2, len(df) + 2):
            if agg_col_idx:
                cell = ws.cell(row=row_idx, column=agg_col_idx)
                colour = flag_colours.get(str(cell.value), None)
                if colour:
                    cell.fill = PatternFill(start_color=colour, end_color=colour, fill_type='solid')
            if cov_col_idx:
                cell = ws.cell(row=row_idx, column=cov_col_idx)
                if cell.value and 'LOW COVERAGE' in str(cell.value):
                    cell.fill = PatternFill(start_color='FCE4D6', end_color='FCE4D6', fill_type='solid')
            if pass_col_idx:
                cell = ws.cell(row=row_idx, column=pass_col_idx)
                if cell.value is True:
                    cell.fill = PatternFill(start_color='C6EFCE', end_color='C6EFCE', fill_type='solid')
                elif cell.value is False:
                    cell.fill = PatternFill(start_color='FFC7CE', end_color='FFC7CE', fill_type='solid')

        # Legend below data
        legend_row = len(df) + 3
        ws.cell(row=legend_row, column=1, value='Aggregate Weight Flag Legend').font = Font(bold=True, size=11)
        legend_items = [
            ('OK',           'C6EFCE', f'Failing meters ≤{self.WEIGHT_REVIEW_THRESHOLD*100:.0f}% of site baseline load'),
            ('REVIEW',       'FFEB9C', f'Failing meters {self.WEIGHT_REVIEW_THRESHOLD*100:.0f}–{self.WEIGHT_HIGH_RISK_THRESHOLD*100:.0f}% of site baseline load — review recommended'),
            ('HIGH RISK',    'FFC7CE', f'Failing meters >{self.WEIGHT_HIGH_RISK_THRESHOLD*100:.0f}% of site baseline load — review carefully'),
            ('NO AGG MODEL', 'F2F2F2', 'No aggregated model produced for this site'),
        ]
        for k, (label, colour, desc) in enumerate(legend_items, 1):
            c1 = ws.cell(row=legend_row + k, column=1, value=label)
            c1.fill = PatternFill(start_color=colour, end_color=colour, fill_type='solid')
            ws.cell(row=legend_row + k, column=2, value=desc)

        cov_leg_row = legend_row + len(legend_items) + 2
        ws.cell(row=cov_leg_row, column=1, value='Coverage Flag Legend').font = Font(bold=True, size=11)
        c1 = ws.cell(row=cov_leg_row + 1, column=1, value=f'LOW COVERAGE (X%)')
        c1.fill = PatternFill(start_color='FCE4D6', end_color='FCE4D6', fill_type='solid')
        ws.cell(row=cov_leg_row + 1, column=2,
                value=f'Passing meter represents <{self.LOW_COVERAGE_THRESHOLD*100:.0f}% of site baseline load')

        ws.freeze_panes = 'A2'


