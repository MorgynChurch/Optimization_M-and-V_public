    def _calc_meter_weights(self, site_data, meter_nums):
        """
        Calculate each meter's share of total BASELINE consumption at the site.
        Returns {str(meter_num): fraction (0.0-1.0)}.
        Meters with no baseline bills receive 0.0 weight (shown as such in output).
        """
        bl_df = site_data[site_data['Baseline Bill'] == 1]
        meter_bl = {}
        for meter in meter_nums:
            m_bl = bl_df[bl_df['Meter Number'] == meter]
            meter_bl[str(meter)] = float(m_bl['Consumption'].sum()) if len(m_bl) > 0 else 0.0
        total = sum(meter_bl.values())
        if total == 0:
            n = max(len(meter_nums), 1)
            return {str(m): 1.0 / n for m in meter_nums}
        return {str(m): v / total for m, v in meter_bl.items()}

    def _failing_weight_flag(self, meter_weights, individual_results):
        """
        Assess the combined baseline-consumption weight of FAILING individual meters.
        Returns (flag: str, note: str). Purely informational — no hard exclusions.
          OK        → failing weight <= WEIGHT_REVIEW_THRESHOLD
          REVIEW    → failing weight >  WEIGHT_REVIEW_THRESHOLD (33%)
          HIGH RISK → failing weight >  WEIGHT_HIGH_RISK_THRESHOLD (50%)
        """
        failing = [
            (str(r['Meter Number']), meter_weights.get(str(r['Meter Number']), 0.0))
            for r in individual_results
            if not r['Model Passes Quality']
        ]
        if not failing:
            return 'OK', ''
        failing_weight = sum(w for _, w in failing)
        failing_names  = ', '.join(f"{m} ({w*100:.1f}%)" for m, w in failing)
        if failing_weight > self.WEIGHT_HIGH_RISK_THRESHOLD:
            return 'HIGH RISK', (
                f"HIGH RISK — failing meter(s) [{failing_names}] account for "
                f"{failing_weight*100:.1f}% of site baseline load "
                f"(>{self.WEIGHT_HIGH_RISK_THRESHOLD*100:.0f}% threshold). "
                f"The aggregate covers consumption that cannot be individually "
                f"verified — review carefully before reporting."
            )
        if failing_weight > self.WEIGHT_REVIEW_THRESHOLD:
            return 'REVIEW', (
                f"REVIEW — failing meter(s) [{failing_names}] account for "
                f"{failing_weight*100:.1f}% of site baseline load "
                f"(>{self.WEIGHT_REVIEW_THRESHOLD*100:.0f}% threshold). "
                f"A meaningful portion of site load is from unverified meters — "
                f"analyst review recommended."
            )
        return 'OK', ''

    def _low_coverage_flag(self, weight, passes_quality):
        """
        Flag passing individual meters that represent < LOW_COVERAGE_THRESHOLD
        of site baseline load. Only fires on passing meters — failing meters
        are addressed via aggregate Notes.
        """
        if not passes_quality:
            return ''
        if weight < self.LOW_COVERAGE_THRESHOLD:
            return f'LOW COVERAGE ({weight*100:.1f}% of site baseline load)'
        return ''

    def _check_meters_overlap(self, site_data):
        """
        Check if multiple meters have substantially overlapping time periods (truly concurrent).
        Returns True if concurrent (real aggregation needed), False if sequential.
        
        A single shared period (e.g. transition month during meter swap) does NOT count as overlap.
        Requires at least 3 overlapping periods to be considered truly concurrent.
        """
        meter_groups = site_data.groupby('Meter Number')
        
        # Get date ranges for each meter
        meter_ranges = {}
        for meter_num, mdata in meter_groups:
            if pd.isna(meter_num):
                continue
            min_date = mdata['Period Start Date'].min()
            max_date = mdata['Period End Date'].max()
            meter_ranges[meter_num] = (min_date, max_date)
        
        # Need at least 2 meters to check
        if len(meter_ranges) < 2:
            return False
        
        # Threshold: require at least 3 shared billing-period start dates to classify
        # meters as truly concurrent.
        #
        # Rationale: during a physical meter swap, utilities often read both the old
        # and new meter for 1–2 transition months, producing a small number of
        # overlapping periods that do NOT represent genuinely concurrent load.
        # Requiring ≥3 shared periods is conservative enough to filter those
        # transition months while still reliably detecting buildings that have
        # run multiple meters in parallel throughout their baseline period.
        # Adjust this value if your utility data shows longer swap-over windows.
        OVERLAP_THRESHOLD = 3
        
        # Check if any meters have substantially overlapping periods
        meter_list = list(meter_ranges.items())
        for i in range(len(meter_list)):
            for j in range(i + 1, len(meter_list)):
                m1_start, m1_end = meter_list[i][1]
                m2_start, m2_end = meter_list[j][1]
                
                # Two ranges overlap if start of one is before end of the other
                if m1_start <= m2_end and m2_start <= m1_end:
                    # Check actual shared periods (not just date range overlap)
                    m1_data = site_data[site_data['Meter Number'] == meter_list[i][0]]
                    m2_data = site_data[site_data['Meter Number'] == meter_list[j][0]]
                    
                    # Count shared period start dates
                    m1_starts = set(m1_data['Period Start Date'])
                    m2_starts = set(m2_data['Period Start Date'])
                    shared_periods = m1_starts & m2_starts
                    
                    if len(shared_periods) >= OVERLAP_THRESHOLD:
                        return True
        
        return False
    
    def _aggregate_meters_for_site(self, site_data, service_type):
        """Aggregate multiple meters for a single site by summing consumption per period"""
        # Group by date period and sum consumption + charges
        agg_dict = {
            'Consumption': 'sum',
            'Total Charges': 'sum',
            'HDD': 'first',  # Same for all meters at same site/period
            'CDD': 'first',
            'Service Type': 'first',
            'Site Name': 'first',
        }
        
        # Add optional columns
        if 'Baseline Bill' in site_data.columns:
            agg_dict['Baseline Bill'] = 'first'
        if 'Reporting Bill' in site_data.columns:
            agg_dict['Reporting Bill'] = 'first'
        if 'Commission Date' in site_data.columns:
            agg_dict['Commission Date'] = 'first'
        if 'Consumption Unit' in site_data.columns:
            agg_dict['Consumption Unit'] = 'first'
        
        try:
            aggregated = site_data.groupby(
                ['Period Start Date', 'Period End Date'], as_index=False
            ).agg(agg_dict)
            
            print(f"    Aggregated: {len(site_data)} meter-records → {len(aggregated)} site-periods")
            return aggregated
        except Exception as e:
            print(f"    ✗ Aggregation error: {e}")
            return pd.DataFrame()
    
    def _generate_recommendations(self):
        """Generate Notes for results - informational, not prescriptive"""
        print("\n" + "="*80)
        print("GENERATING NOTES")
        print("="*80)
        
        # Group results by site + service type
        site_groups = {}
        for result in self.results:
            key = f"{result['Site Name']}_{result['Service Type']}"
            if key not in site_groups:
                site_groups[key] = {'individual': [], 'aggregated': []}
            
            model_type = result.get('Model Type', 'Individual')
            if model_type == 'Aggregated':
                site_groups[key]['aggregated'].append(result)
            else:
                site_groups[key]['individual'].append(result)
        
        # Generate notes for each site
        for key, models in site_groups.items():
            individual_models = models['individual']
            aggregated_models = models['aggregated']
            
            # Single individual meter (or sequential meter combined as single)
            if not aggregated_models and len(individual_models) <= 1:
                # Notes already set if applicable (e.g. sequential meter note)
                continue
            
            # True multi-meter site with aggregated row
            if aggregated_models and len(individual_models) >= 1:
                # Calculate stats for notes
                individual_pass_count = sum(1 for m in individual_models if m['Model Passes Quality'])
                individual_fail_count = len(individual_models) - individual_pass_count
                total_individual = len(individual_models)
                aggregated_passes = aggregated_models[0]['Model Passes Quality']
                
                individual_avg_r2 = np.mean([m['R2'] for m in individual_models])
                aggregated_r2 = aggregated_models[0]['R2']
                
                individual_total_savings = sum(m['Pct Avoided Usage'] for m in individual_models if m['Model Passes Quality']) / max(individual_pass_count, 1)
                aggregated_savings = aggregated_models[0]['Pct Avoided Usage']
                
                # Build informational note
                note_parts = []
                
                # Quality info
                if individual_pass_count == total_individual and aggregated_passes:
                    note_parts.append(f"All {total_individual} individual meters and aggregated pass quality")
                elif individual_pass_count > 0 and aggregated_passes:
                    note_parts.append(f"{individual_pass_count}/{total_individual} individual meters and aggregated pass quality")
                elif aggregated_passes and individual_pass_count == 0:
                    note_parts.append(f"Only aggregated passes quality (all {total_individual} individual meters fail)")
                elif individual_pass_count == total_individual and not aggregated_passes:
                    note_parts.append(f"All {total_individual} individual meters pass; aggregated fails")
                else:
                    note_parts.append(f"{individual_pass_count}/{total_individual} individual meters pass; aggregated {'passes' if aggregated_passes else 'fails'}")
                
                # R² comparison
                note_parts.append(f"Avg individual R²={individual_avg_r2:.2f}, Aggregated R²={aggregated_r2:.2f}")
                
                # Savings comparison if both pass
                if aggregated_passes and individual_pass_count > 0:
                    note_parts.append(f"Avg individual savings={individual_total_savings:.1f}%, Aggregated={aggregated_savings:.1f}%")
                
                note = ' | '.join(note_parts)
                
                # Apply note to all related results
                for r in individual_models + aggregated_models:
                    r['Notes'] = note
                
                site_name = individual_models[0]['Site Name']
                service_type = individual_models[0]['Service Type']
                print(f"  {site_name} ({service_type}): {note}")
    
