                )
                root.destroy()
            else:
                filepath = input("Enter configuration filename to load: ").strip()
        
        if filepath and os.path.exists(filepath):
            with open(filepath, 'r') as f:
                self.mapping = json.load(f)
            print(f"\n✓ Column mapping loaded from: {filepath}")
            self.config_file = filepath
            return True
        elif filepath:
            print(f"\n✗ Configuration file not found: {filepath}")
        return False
    
    def validate_mapping(self, df):
        """Validate that all required columns exist in dataframe"""
        missing = []
        for field in self.REQUIRED_COLUMNS.keys():
            if field not in self.mapping:
                missing.append(field)
            elif self.mapping[field] not in df.columns:
                missing.append(f"{field} (mapped to '{self.mapping[field]}' which doesn't exist)")
        
        if missing:
            print(f"\n✗ Missing required columns: {', '.join(missing)}")
            return False
        
        # Special validation: Must have EITHER (Baseline + Reporting flags) OR Commission Date
        has_baseline = 'Baseline Bill' in self.mapping
        has_reporting = 'Reporting Bill' in self.mapping
        has_commission = 'Commission Date' in self.mapping
        
        if not has_commission and not (has_baseline or has_reporting):
            print(f"\n✗ Missing baseline/reporting information!")
            print(f"   You must provide EITHER:")
            print(f"     - Baseline Bill AND/OR Reporting Bill columns")
            print(f"     - Commission Date column (to infer flags)")
            return False
        
        return True
    
    def apply_mapping(self, df):
        """Rename dataframe columns according to mapping"""
        rename_dict = {v: k for k, v in self.mapping.items()}
        return df.rename(columns=rename_dict)


