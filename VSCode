        # Individual metrics
        dashboard_data.append(['METRIC PERFORMANCE', '', ''])
        dashboard_data.append(['', '', ''])
        dashboard_data.append(['R² Score Pass Rate', f'{passing_r2}/{total_models}', f'{passing_r2/total_models*100:.1f}%'])
        dashboard_data.append(['CV-RMSE Pass Rate', f'{passing_cvrmse}/{total_models}', f'{passing_cvrmse/total_models*100:.1f}%'])
        dashboard_data.append(['Weather Coverage (≥75%) Required', f'{high_weather}/{total_models}', f'{high_weather/total_models*100:.1f}%'])
