        if service_type == 'Electricity':
            df = self.electricity_df_original.copy()
            sheet_name = 'Original Electricity Data'
        else:
            df = self.gas_df_original.copy()
            sheet_name = 'Original Gas Data'
        
        # Write data
        df.to_excel(writer, sheet_name=sheet_name, index=False, startrow=2)
        
        # Format the sheet
        workbook = writer.book
        data_sheet = workbook[sheet_name]
        
        # Title
        data_sheet['A1'] = f'ORIGINAL {service_type.upper()} BILLING DATA'
        data_sheet['A1'].font = Font(bold=True, size=14, color="FFFFFF")
        data_sheet['A1'].fill = PatternFill(start_color="366092", end_color="366092", fill_type="solid")
        data_sheet['A1'].alignment = Alignment(horizontal='center', vertical='center')
        data_sheet.merge_cells(f'A1:{get_column_letter(df.shape[1])}1')
        
        # Header row formatting
        header_fill = PatternFill(start_color="366092", end_color="366092", fill_type="solid")
        header_font = Font(bold=True, color="FFFFFF")
        
        for cell in data_sheet[3]:
            if cell.value:
                cell.fill = header_fill
                cell.font = header_font
                cell.alignment = Alignment(horizontal='center', vertical='center')
        
        # Data formatting
        for row in data_sheet.iter_rows(min_row=4):
            for cell in row:
                if cell.value is not None:
                    cell.alignment = Alignment(horizontal='center', vertical='center')
                    if isinstance(cell.value, (int, float)) and not isinstance(cell.value, bool):
                        cell.number_format = '0.00'
    
    def _format_summary_sheet(self, sheet):
        """Apply formatting to summary sheet"""
        
        # Header formatting
        header_fill = PatternFill(start_color="366092", end_color="366092", fill_type="solid")
        header_font = Font(bold=True, color="FFFFFF")
        
        for cell in sheet[1]:
            cell.fill = header_fill
            cell.font = header_font
            cell.alignment = Alignment(horizontal='center', vertical='center')
        
        # Apply alignment and number formatting to all data cells
        for row in sheet.iter_rows(min_row=2):
            for cell in row:
                # Center align all cells
                cell.alignment = Alignment(horizontal='center', vertical='center')
                
                # Format numbers to 2 decimal places
                if isinstance(cell.value, (int, float)) and not isinstance(cell.value, bool):
                    if cell.column_letter in ['J', 'M']:  # R2 and CV-RMSE columns
                        cell.number_format = '0.00'
                    elif 'Coefficient' in str(sheet.cell(row=1, column=cell.column).value):
                        cell.number_format = '0.0000'  # 4 decimals for coefficients
                    else:
                        cell.number_format = '0.00'
        
        # Auto-adjust column widths
        for column in sheet.columns:
            max_length = 0
            column_letter = column[0].column_letter
            
            for cell in column:
                try:
                    if len(str(cell.value)) > max_length:
                        max_length = len(str(cell.value))
                except:
                    pass
            
            adjusted_width = min(max_length + 2, 50)
            sheet.column_dimensions[column_letter].width = adjusted_width
        
        # Find pass/fail columns and apply conditional formatting
        for col_idx, cell in enumerate(sheet[1], start=1):
            col_letter = get_column_letter(col_idx)
            
            if 'Passes' in str(cell.value) or 'Model Passes Quality' in str(cell.value):
                for row in range(2, sheet.max_row + 1):
                    cell_value = sheet[f'{col_letter}{row}'].value
                    if cell_value == False:
                        sheet[f'{col_letter}{row}'].fill = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
                    elif cell_value == True:
                        sheet[f'{col_letter}{row}'].fill = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid")
        
        # Highlight entire rows for models that don't pass overall quality
        quality_col = None
        for col_idx, cell in enumerate(sheet[1], start=1):
            if 'Model Passes Quality' in str(cell.value):
                quality_col = col_idx
                break
        
        if quality_col:
            for row in range(2, sheet.max_row + 1):
                if sheet.cell(row=row, column=quality_col).value == False:
                    # Add light orange background to entire row for failed models
                    for col in range(1, sheet.max_column + 1):
                        current_fill = sheet.cell(row=row, column=col).fill
                        # Only apply if cell doesn't already have red/green fill
                        if not current_fill or current_fill.start_color.rgb not in ['FFFFC7CE', 'FFC7CE', 'FFC6EFCE', 'C6EFCE']:
                            sheet.cell(row=row, column=col).fill = PatternFill(start_color="FFE4B5", end_color="FFE4B5", fill_type="solid")
        
        # Freeze top row
        sheet.freeze_panes = 'A2'


def _resolve_sheets(file_path, available_sheets, elec_sheet_arg=None, gas_sheet_arg=None):
    """
    Determine which Excel sheets to use for electricity and gas data.
    Accepts explicit overrides from CLI args, falls back to auto-detection,
    then interactive prompts.
    Returns (electricity_sheet, gas_sheet) or raises SystemExit on error.
    """
    # Explicit CLI overrides take priority
    if elec_sheet_arg and gas_sheet_arg:
        for s in [elec_sheet_arg, gas_sheet_arg]:
            if s not in available_sheets:
                print(f"  ✗ Sheet '{s}' not found in file. Exiting.")
                sys.exit(1)
        return elec_sheet_arg, gas_sheet_arg

    if len(available_sheets) == 1:
        print(f"\n✓ Single sheet detected: '{available_sheets[0]}'")
        print("  Assuming all data (electricity and gas) is in this sheet")
        return available_sheets[0], available_sheets[0]

    # Multiple sheets - try auto-detection first
    print("\nMultiple sheets detected. Please specify which sheets contain your data:")
    elec_candidates = [s for s in available_sheets if 'elec' in s.lower()]
    gas_candidates  = [s for s in available_sheets if 'gas' in s.lower()]

    if elec_sheet_arg:
        electricity_sheet = elec_sheet_arg
        print(f"  Electricity sheet (from CLI): '{electricity_sheet}'")
    elif len(elec_candidates) == 1:
        electricity_sheet = elec_candidates[0]
        print(f"  Auto-detected electricity sheet: '{electricity_sheet}'")
    else:
        print(f"\n  Available sheets: {', '.join(available_sheets)}")
        electricity_sheet = input("  Enter electricity sheet name: ").strip()
        if electricity_sheet not in available_sheets:
            print(f"  ✗ Sheet '{electricity_sheet}' not found. Exiting.")
            sys.exit(1)

    if gas_sheet_arg:
        gas_sheet = gas_sheet_arg
        print(f"  Gas sheet (from CLI): '{gas_sheet}'")
    elif len(gas_candidates) == 1:
        gas_sheet = gas_candidates[0]
        print(f"  Auto-detected gas sheet: '{gas_sheet}'")
    else:
        gas_sheet = input("  Enter gas sheet name (or press Enter if same as electricity): ").strip()
        if not gas_sheet:
            gas_sheet = electricity_sheet
        elif gas_sheet not in available_sheets:
            print(f"  ✗ Sheet '{gas_sheet}' not found. Exiting.")
            sys.exit(1)

    return electricity_sheet, gas_sheet


def _resolve_column_mapping(file_path, electricity_sheet, config_path=None, non_interactive=False):
    """
    Load or build a ColumnMapper.
    - config_path: path to a JSON config file (CLI --config flag).
    - non_interactive: if True, skip all prompts and fail loudly if config is missing/invalid.
    Returns a validated ColumnMapper or raises SystemExit.
    """
    column_mapper = ColumnMapper()

    if config_path:
        if not column_mapper.load_mapping(config_path):
            print(f"✗ Could not load config: {config_path}")
            sys.exit(1)
        temp_df = pd.read_excel(file_path, sheet_name=electricity_sheet, nrows=5)
        if not column_mapper.validate_mapping(temp_df):
            print("✗ Config is invalid for this file. Exiting.")
            sys.exit(1)
        print("✓ Configuration loaded and validated successfully!")
        return column_mapper

    if non_interactive:
        print("✗ --non-interactive requires a --config file. Exiting.")
        sys.exit(1)

    # Interactive workflow
    print("\n" + "="*80)
    print("This tool needs to know which columns contain required data.")
    print("You can either:")
    print("  1. Load an existing column mapping configuration file")
    print("  2. Create a new mapping interactively")

    load_config = input("\nDo you have an existing configuration file to load? (yes/no): ").strip().lower()
    if load_config in ['yes', 'y']:
        if column_mapper.load_mapping():
            temp_df = pd.read_excel(file_path, sheet_name=electricity_sheet, nrows=5)
            if column_mapper.validate_mapping(temp_df):
                print("✓ Configuration loaded and validated successfully!")
                return column_mapper
            else:
                print("✗ Loaded configuration is invalid for this file.")
                print("  Falling back to interactive mapping...")

    # Build mapping interactively
    print("\n" + "="*80)
    print("INTERACTIVE COLUMN MAPPING")
    print("="*80)
    print("\nLoading file to show available columns...")

    elec_preview = pd.read_excel(file_path, sheet_name=electricity_sheet, nrows=3)
    column_mapper.display_available_columns(elec_preview, electricity_sheet)
    mapping = column_mapper.prompt_for_mapping(elec_preview, 'Data')
    column_mapper.mapping = mapping

    if not column_mapper.validate_mapping(elec_preview):
        print("\n✗ Invalid column mapping. Exiting.")
        sys.exit(1)

    print("\n✓ Column mapping complete!")
    save_config = input("\nWould you like to save this mapping for future use? (yes/no): ").strip().lower()
    if save_config in ['yes', 'y']:
        column_mapper.save_mapping()

    return column_mapper


def _parse_args():
    """
    Parse command-line arguments.

    Usage (shell):
        python energy_mv_analyzer.py
            [INPUT_FILE]
            [--config CONFIG]
            [--output OUTPUT]
            [--elec-sheet NAME]
            [--gas-sheet NAME]
            [--non-interactive]

    Arguments:
        INPUT_FILE        Path to input Excel file (optional; GUI picker used if omitted)
        --config          Path to column-mapping JSON config file
        --output          Output file path/name for results Excel
        --elec-sheet      Sheet name containing electricity data
        --gas-sheet       Sheet name containing gas data
        --non-interactive Disable all interactive prompts (requires --config; for batch/CI use)

    Examples:
        # Interactive (GUI file picker + column-mapping prompts):
        python energy_mv_analyzer.py

        # Fully automated batch run:
        python energy_mv_analyzer.py data.xlsx
            --config col_map.json
            --output results.xlsx
            --elec-sheet Electricity
            --gas-sheet Gas
            --non-interactive
    """
    import argparse
    parser = argparse.ArgumentParser(
        description='Energy M&V Baseline Optimization Tool - UNIFIED ANALYSIS v1.0'
    )
    parser.add_argument('input_file', nargs='?', default=None,
                        help='Path to input Excel file (optional; GUI picker used if omitted)')
    parser.add_argument('--config', default=None,
                        help='Path to column-mapping JSON config file')
    parser.add_argument('--output', default=None,
                        help='Output file path/name for results Excel')
    parser.add_argument('--elec-sheet', default=None, dest='elec_sheet',
                        help='Sheet name containing electricity data')
    parser.add_argument('--gas-sheet', default=None, dest='gas_sheet',
                        help='Sheet name containing gas data (defaults to electricity sheet if omitted)')
    parser.add_argument('--non-interactive', action='store_true', dest='non_interactive',
                        help='Disable all interactive prompts (requires --config; for batch/CI use)')
    return parser.parse_args()


def main():
    """Main execution function"""
    print("="*80)
    print("ENERGY M&V BASELINE OPTIMIZATION TOOL - UNIFIED ANALYSIS v1.0")
    print("IPMVP Option C - Whole Building Analysis")
    print("="*80)

    args = _parse_args()
    analyzer = EnergyMVAnalyzer()

    # ── 1. Resolve input file ──────────────────────────────────────────────────
    file_path = args.input_file
    if not file_path:
        if args.non_interactive:
            print("✗ --non-interactive requires a positional INPUT_FILE argument. Exiting.")
            sys.exit(1)
        print("\nPlease select your energy billing data Excel file...")
        file_path = analyzer.select_file()
    
    if not file_path or not os.path.exists(file_path):
        print(f"Error: File not found: {file_path}")
        sys.exit(1)

    # ── 2. Detect sheets ───────────────────────────────────────────────────────
    print("\n" + "="*80)
    print("COLUMN MAPPING CONFIGURATION")
    print("="*80)
    print("\nDetecting available sheets in Excel file...")
    excel_file = pd.ExcelFile(file_path)
    available_sheets = excel_file.sheet_names
    print(f"Found {len(available_sheets)} sheet(s): {', '.join(available_sheets)}")

    electricity_sheet, gas_sheet = _resolve_sheets(
        file_path, available_sheets,
        elec_sheet_arg=args.elec_sheet,
        gas_sheet_arg=args.gas_sheet
    )

    # ── 3. Column mapping ──────────────────────────────────────────────────────
    column_mapper = _resolve_column_mapping(
        file_path, electricity_sheet,
        config_path=args.config,
        non_interactive=args.non_interactive
    )

    # ── 4. Load + analyse ──────────────────────────────────────────────────────
    analyzer.load_data(file_path, column_mapping=column_mapper,
                       electricity_sheet=electricity_sheet, gas_sheet=gas_sheet)
    analyzer.analyze_all_sites()

    # ── 5. Resolve output path ─────────────────────────────────────────────────
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    base_name = os.path.basename(file_path).replace('.xlsx', '')
    default_filename = f"{base_name}_MV_Results_{timestamp}.xlsx"

    if args.output:
        output_path = args.output
        if not output_path.endswith('.xlsx'):
            output_path += '.xlsx'
    elif args.non_interactive:
        output_path = os.path.join(os.path.dirname(file_path) or '.', default_filename)
        print(f"\nNon-interactive mode: saving results to {output_path}")
    else:
        print("\nChoose where to save results...")
        output_path = analyzer.select_save_location(default_filename)
        if not output_path:
            print("No save location selected. Exiting.")
            sys.exit(0)

    # ── 6. Export ──────────────────────────────────────────────────────────────
    analyzer.export_results(output_path)

    # ── 7. Summary ─────────────────────────────────────────────────────────────
    print("\n" + "="*80)
    print("ANALYSIS COMPLETE")
    print("="*80)
    print(f"\nResults file: {output_path}")
    print(f"\nSummary:")
    print(f"  - Total sites analyzed: {len(set(r['Site Name'] for r in analyzer.results))}")
    print(f"  - Total models created: {len(analyzer.results)}")
    print(f"  - Models passing quality criteria: {sum(1 for r in analyzer.results if r['Model Passes Quality'])}")
    if analyzer.results:
        print(f"  - Average R²: {np.mean([r['R2'] for r in analyzer.results]):.4f}")
        print(f"  - Average CV-RMSE: {np.mean([r['CV-RMSE'] for r in analyzer.results]):.2f}%")
        sites_with_reporting = [r for r in analyzer.results if r['Reporting Count'] > 0]
        if sites_with_reporting:
            print(f"  - Average % Avoided Usage: {np.mean([r['Pct Avoided Usage'] for r in sites_with_reporting]):.2f}%")

    print("\n✓ All done!")


if __name__ == "__main__":
    main()
