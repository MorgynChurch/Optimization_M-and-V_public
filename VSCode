    def _create_cost_analysis_combined_sheet(self, writer):
        """Create combined cost analysis - aggregates all PASSING meters per site
        For sites with both individual and aggregated models, prefers aggregated to avoid double-counting"""
        sheet_name = 'Combined Cost Analysis'
        
        # Group results by site name (combining all meters that passed quality)
        # For sites with both individual + aggregated models, USE AGGREGATED ONLY (avoids double-counting)
        site_data = {}
        
        # First pass: identify which sites have aggregated models
        sites_with_aggregated = set()
        for result in self.results:
            if result.get('Model Type') == 'Aggregated' and result.get('Model Passes Quality', False):
                site_service_key = f"{result['Site Name']}_{result['Service Type']}"
                sites_with_aggregated.add(site_service_key)
        
        for result in self.results:
            # Skip meters that didn't pass quality
            if not result.get('Model Passes Quality', False):
                continue
            
            site_name = result['Site Name']
            service_type = result['Service Type']
            site_service_key = f"{site_name}_{service_type}"
            
            # If site has an aggregated model, ONLY use the aggregated row (skip individuals to avoid double-counting)
            if site_service_key in sites_with_aggregated and result.get('Model Type') != 'Aggregated':
                continue
            
            if site_service_key not in site_data:
                site_data[site_service_key] = {
                    'site_name': site_name,
                    'service_type': service_type,
                    'modeled_usage': 0,
                    'actual_usage': 0,
                    'modeled_cost': 0,
                    'actual_cost': 0,
                    'bill_count': 0,
                    'meter_count': 0
                }
            
            # Get reporting bills
            reporting_bills = result['Reporting Bills']
            
            if len(reporting_bills) == 0:
                continue
            
            # Calculate measured rate
            total_charges = reporting_bills['Total Charges'].sum()
            total_consumption = reporting_bills['Consumption'].sum()
            measured_rate = total_charges / total_consumption if total_consumption > 0 else 0
            
            # Get predictions
            model = result['Model']
            if 'gas' in service_type.lower():
                X_rep = reporting_bills[['HDD']].values
            else:
                X_rep = reporting_bills[['HDD', 'CDD']].values
            
            predicted_consumption = model.predict(X_rep)
            
            # Aggregate meter data into site totals
            site_data[site_service_key]['modeled_usage'] += predicted_consumption.sum()
            site_data[site_service_key]['actual_usage'] += total_consumption
            site_data[site_service_key]['modeled_cost'] += predicted_consumption.sum() * measured_rate
            site_data[site_service_key]['actual_cost'] += total_charges
            site_data[site_service_key]['bill_count'] += len(reporting_bills)
            
            # Use the actual meter count from the result (not incremented by row count)
            site_data[site_service_key]['meter_count'] = max(
                site_data[site_service_key]['meter_count'], 
                result.get('Meter Count', 1)
            )
        
        # Build combined data (aggregate meters by site+service)
        combined_data = []
        for site_service_key, data in site_data.items():
            site_name = data['site_name']
            service_type = data['service_type']
            modeled_usage = data['modeled_usage']
            actual_usage = data['actual_usage']
            modeled_cost = data['modeled_cost']
            actual_cost = data['actual_cost']
            bill_count = data['bill_count']
            meter_count = data['meter_count']
            
            avoided_usage = modeled_usage - actual_usage
            avoided_pct = (avoided_usage / modeled_usage * 100) if modeled_usage > 0 else 0
            avoided_cost = modeled_cost - actual_cost
            avg_monthly_avoided_cost = avoided_cost / bill_count if bill_count > 0 else 0
            
            combined_data.append({
                'Site': site_name,
                'Service Type': service_type,
                'Meter Count': meter_count,
                'Modeled Usage': round(modeled_usage, 2),
                'Actual Usage': round(actual_usage, 2),
                'Avoided Usage': round(avoided_usage, 2),
                'Avoided Usage (%)': round(avoided_pct, 2),
                'Modeled Cost ($)': round(modeled_cost, 2),
                'Actual Cost ($)': round(actual_cost, 2),
                'Avoided Cost ($)': round(avoided_cost, 2),
                'Bill Count': bill_count,
                'Average Monthly Avoided Cost': round(avg_monthly_avoided_cost, 2)
            })
        
        # Create DataFrame
        df_combined = pd.DataFrame(combined_data)
        
        if len(df_combined) == 0:
            df_empty = pd.DataFrame({
                'Message': ['No reporting period data available']
            })
            df_empty.to_excel(writer, sheet_name=sheet_name, index=False)
            return
        
        # Add totals row
        totals = {
            'Site': 'TOTAL',
            'Service Type': '',
            'Meter Count': df_combined['Meter Count'].sum(),
            'Modeled Usage': df_combined['Modeled Usage'].sum(),
            'Actual Usage': df_combined['Actual Usage'].sum(),
            'Avoided Usage': df_combined['Avoided Usage'].sum(),
            'Avoided Usage (%)': (df_combined['Avoided Usage'].sum() / df_combined['Modeled Usage'].sum() * 100) if df_combined['Modeled Usage'].sum() > 0 else 0,
            'Modeled Cost ($)': df_combined['Modeled Cost ($)'].sum(),
            'Actual Cost ($)': df_combined['Actual Cost ($)'].sum(),
            'Avoided Cost ($)': df_combined['Avoided Cost ($)'].sum(),
            'Bill Count': df_combined['Bill Count'].sum(),
            'Average Monthly Avoided Cost': df_combined['Avoided Cost ($)'].sum() / df_combined['Bill Count'].sum() if df_combined['Bill Count'].sum() > 0 else 0
        }
        df_combined = pd.concat([df_combined, pd.DataFrame([totals])], ignore_index=True)
        
        # Write to Excel
        df_combined.to_excel(writer, sheet_name=sheet_name, index=False, startrow=2)
        
        # Format sheet
        workbook = writer.book
        combined_sheet = workbook[sheet_name]
        
        # Title
        combined_sheet.merge_cells('A1:L1')
        title_cell = combined_sheet['A1']
        title_cell.value = 'SITE-LEVEL AGGREGATION (All Meters Combined by Site+Service)'
        title_cell.font = Font(size=14, bold=True, color='FFFFFF')
        title_cell.fill = PatternFill(start_color='366092', end_color='366092', fill_type='solid')
        title_cell.alignment = Alignment(horizontal='center', vertical='center')
        
        # Header formatting
        header_fill = PatternFill(start_color='366092', end_color='366092', fill_type='solid')
        header_font = Font(bold=True, color='FFFFFF')
        
        for cell in combined_sheet[3]:
            if cell.value:
                cell.fill = header_fill
                cell.font = header_font
                cell.alignment = Alignment(horizontal='center', vertical='center')
        
        # Format data rows
        for row_idx in range(4, combined_sheet.max_row + 1):
            is_total_row = (row_idx == combined_sheet.max_row)
            
            for col_idx in range(1, 13):  # 12 columns now
                cell = combined_sheet.cell(row=row_idx, column=col_idx)
                cell.alignment = Alignment(horizontal='center', vertical='center')
                
                # Bold total row
                if is_total_row:
                    cell.font = Font(bold=True)
                    cell.fill = PatternFill(start_color='D9E1F2', end_color='D9E1F2', fill_type='solid')
                
                # Number formatting
                # Columns: Site, Service Type, Meter Count, Modeled Usage, Actual Usage, Avoided Usage, Avoided %, Modeled Cost, Actual Cost, Avoided Cost, Bill Count, Avg Monthly
                if col_idx in [4, 5, 6]:  # Usage columns
                    cell.number_format = '0.00'
