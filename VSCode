            if 'meter' in col.lower() and ('number' in col.lower() or 'no' in col.lower())
        )
        
        if not has_meter_col:
            print(f"\n  {service_type}: No meter number column found - will analyze by site only")
            return df
        
        # Find the meter number column
        meter_col = next(
            (col for col in df.columns 
             if 'meter' in col.lower() and ('number' in col.lower() or 'no' in col.lower())),
            None
        )
        
        # Log meter count; actual aggregation deferred to analysis phase
        if meter_col in df.columns:
            meter_count = df[meter_col].nunique()
            print(f"\n  {service_type}: {meter_count} unique meter(s) found - each will be analyzed individually")
            print(f"    Multi-meter sites will also receive an aggregated model where applicable")
        
