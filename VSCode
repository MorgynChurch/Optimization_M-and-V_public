        dashboard_data.append(['', '', ''])
        dashboard_data.append(['Average R² Score', f'{avg_r2:.4f}', ''])
        dashboard_data.append(['Average CV-RMSE', f'{avg_cvrmse:.2f}%', ''])
        dashboard_data.append(['Average Weather Coverage', f'{avg_weather:.1f}%', ''])
        dashboard_data.append(['Average % Avoided Usage', f'{avg_savings:.2f}%', '(sites with reporting periods)'])
        dashboard_data.append(['', '', ''])
        
        # Quality breakdown
        dashboard_data.append(['QUALITY BREAKDOWN', '', ''])
        dashboard_data.append(['', '', ''])
        
        excellent_r2 = sum(1 for r in self.results if r['R2'] >= 0.9)
        good_r2 = sum(1 for r in self.results if 0.75 <= r['R2'] < 0.9)
        fair_r2 = sum(1 for r in self.results if 0.6 <= r['R2'] < 0.75)
        poor_r2 = sum(1 for r in self.results if r['R2'] < 0.6)
        
        dashboard_data.append(['R² Distribution:', '', ''])
        dashboard_data.append(['  Excellent (≥0.90)', excellent_r2, f'{excellent_r2/total_models*100:.1f}%'])
        dashboard_data.append(['  Good (0.75-0.89)', good_r2, f'{good_r2/total_models*100:.1f}%'])
        dashboard_data.append(['  Fair (0.60-0.74)', fair_r2, f'{fair_r2/total_models*100:.1f}%'])
        dashboard_data.append(['  Poor (<0.60)', poor_r2, f'{poor_r2/total_models*100:.1f}%'])
        dashboard_data.append(['', '', ''])
        
        excellent_cv = sum(1 for r in self.results if r['CV-RMSE'] < 10)
        good_cv = sum(1 for r in self.results if 10 <= r['CV-RMSE'] <= 15)
        fair_cv = sum(1 for r in self.results if 15 < r['CV-RMSE'] <= 25)
        poor_cv = sum(1 for r in self.results if r['CV-RMSE'] > 25)
        
        dashboard_data.append(['CV-RMSE Distribution:', '', ''])
        dashboard_data.append(['  Excellent (<10%)', excellent_cv, f'{excellent_cv/total_models*100:.1f}%'])
        dashboard_data.append(['  Good (10-15%)', good_cv, f'{good_cv/total_models*100:.1f}%'])
